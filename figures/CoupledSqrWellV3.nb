Cell[CellGroupData[{

Cell["Perhaps we're ready for some numbers...", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"W", "=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{"(", 
       RowBox[{"\[Epsilon]", "+", "v1"}], ")"}], "g"},
     {"g", 
      RowBox[{"(", 
       RowBox[{"\[Epsilon]", "+", "v2", "-", "\[Epsilon]2"}], ")"}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{3.693701776972114*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v1", "+", "\[Epsilon]"}], ",", "g"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"g", ",", 
     RowBox[{"v2", "+", "\[Epsilon]", "-", "\[Epsilon]2"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.701350268760854*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ascat", "[", 
   RowBox[{
   "v1_", ",", "v2_", ",", "g_", ",", "\[Epsilon]_", ",", "\[Epsilon]2_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v1"}], ")"}], "g"},
        {"g", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v2", "-", "\[Epsilon]2"}], ")"}]}
       }], ")"}]}], ";", 
    RowBox[{"Avals", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Phi]mat", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a1", " ", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "1", "]"}], "]"}]], " ", "r"}]}], "]"}]}]},
        {
         RowBox[{"a2", " ", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "2", "]"}], "]"}]], " ", "r"}]}], "]"}]}]}
       }], ")"}]}], ";", 
    RowBox[{"AvecsNormed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "Kmat"}], "/", 
      SqrtBox["\[Epsilon]"]}], "/.", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
            RowBox[{"(", GridBox[{
               {
                RowBox[{
                 RowBox[{"SphericalBesselJ", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox["\[Epsilon]"], " ", "r"}]}], "]"}], "-", 
                 RowBox[{"Kmat", " ", 
                  RowBox[{"SphericalBesselY", "[", 
                   RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], "r"}]}], "]"}]}]}]},
               {
                RowBox[{"b2", " ", 
                 RowBox[{"SphericalBesselK", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox[
                    RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                  "]"}]}]}
              }], ")"}]}], ",", 
           RowBox[{
            RowBox[{"AvecsNormed", ".", 
             RowBox[{"D", "[", 
              RowBox[{"\[Phi]mat", ",", "r"}], "]"}]}], "\[Equal]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"(", GridBox[{
                 {
                  RowBox[{
                   RowBox[{"SphericalBesselJ", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], " ", "r"}]}], "]"}], "-", 
                   RowBox[{"Kmat", " ", 
                    RowBox[{"SphericalBesselY", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], "r"}]}], "]"}]}]}]},
                 {
                  RowBox[{"b2", " ", 
                   RowBox[{"SphericalBesselK", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                    "]"}]}]}
                }], ")"}], ",", "r"}], "]"}]}]}], "}"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"L", "\[Rule]", "0"}], ",", 
           RowBox[{"r", "\[Rule]", "1"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "b2", ",", "Kmat"}], "}"}]}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.693701825768087*^9, 3.693701864773237*^9}, {
  3.693701899016735*^9, 3.693702053431706*^9}, {3.693743531470443*^9, 
