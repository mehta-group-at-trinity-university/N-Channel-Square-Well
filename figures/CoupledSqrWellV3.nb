Cell[TextData[{
 "Aha,  the upper channel has an s-wave bound state with binding 4.62419 \
(with respect to the upper threshold).  Therefore, there ",
 StyleBox["should",
  FontSlant->"Italic"],
 " be a zero-energy resonance if the upper threshold is shifted by that \
binding, consistent with the picture above.  Let\[CloseCurlyQuote]s take a \
look at the square of the partial wave amplitude ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["a", "l"], 
    SuperscriptBox["|", "2"]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.693702888542469*^9, 3.693703001862245*^9}, {
  3.693744821965789*^9, 3.6937448497613163`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"aLsqr", "[", 
   RowBox[{
   "v1_", ",", "v2_", ",", "g_", ",", "\[Epsilon]_", ",", "\[Epsilon]2_", ",",
     "L_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v1"}], ")"}], "g"},
        {"g", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v2", "-", "\[Epsilon]2"}], ")"}]}
       }], ")"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Avals", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Phi]mat", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a1", " ", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "1", "]"}], "]"}]], " ", "r"}]}], "]"}]}]},
        {
         RowBox[{"a2", " ", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "2", "]"}], "]"}]], " ", "r"}]}], "]"}]}]}
       }], ")"}]}], ";", 
    RowBox[{"AvecsNormed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", 
       FractionBox["Kmat", 
        RowBox[{"1", "-", 
         RowBox[{"\[ImaginaryI]", " ", "Kmat"}]}]], "]"}], "2"], "/.", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
            RowBox[{"(", GridBox[{
               {
                RowBox[{
                 RowBox[{"SphericalBesselJ", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox["\[Epsilon]"], " ", "r"}]}], "]"}], "+", 
                 RowBox[{"Kmat", " ", 
                  RowBox[{"SphericalBesselY", "[", 
                   RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], "r"}]}], "]"}]}]}]},
               {
                RowBox[{"b2", " ", 
                 RowBox[{"SphericalBesselK", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox[
                    RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                  "]"}]}]}
              }], ")"}]}], ",", 
           RowBox[{
            RowBox[{"AvecsNormed", ".", 
             RowBox[{"D", "[", 
              RowBox[{"\[Phi]mat", ",", "r"}], "]"}]}], "\[Equal]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"(", GridBox[{
                 {
                  RowBox[{
                   RowBox[{"SphericalBesselJ", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], " ", "r"}]}], "]"}], "+", 
                   RowBox[{"Kmat", " ", 
                    RowBox[{"SphericalBesselY", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox["\[Epsilon]"], "r"}]}], "]"}]}]}]},
                 {
                  RowBox[{"b2", " ", 
                   RowBox[{"SphericalBesselK", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                    "]"}]}]}
                }], ")"}], ",", "r"}], "]"}]}]}], "}"}], "/.", 
         RowBox[{"{", 
          RowBox[{"r", "\[Rule]", "1"}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "b2", ",", "Kmat"}], "}"}]}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.6937426703193073`*^9, 3.693742688718523*^9}, {
