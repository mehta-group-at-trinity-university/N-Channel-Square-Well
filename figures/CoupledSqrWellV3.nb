Notebook[{
Cell["", "Text",
 CellChangeTimes->{{3.692452374626791*^9, 3.692452375839117*^9}}],

Cell[CellGroupData[{

Cell["Coupled square well scattering and bound states", "Title",
 CellChangeTimes->{{3.691192381712702*^9, 3.691192391380272*^9}, {
  3.6915360359596577`*^9, 3.691536037733398*^9}}],

Cell["A \[OpenCurlyDoubleQuote]simple\[CloseCurlyDoubleQuote] multichannel \
model", "Subtitle",
 CellChangeTimes->{{3.691192392150342*^9, 3.691192404821622*^9}}],

Cell[CellGroupData[{

Cell["1-channel square well", "Section",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137821837714*^9}}],

Cell[TextData[{
 "As a preliminary to the multichannel case, we will need to solve the single \
channel case to understand where the bound states are with respect to the \
threshold.  This will help us interpret the two-channel resonances, at least \
in the weak coupling regime.  Inside the well of range ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", the wavefunction satisfies:"
}], "Text",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137929269053*^9}, {
  3.692282786010167*^9, 3.692282798297591*^9}, {3.693247648593514*^9, 
  3.693247653543399*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["r", "2"]], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        SuperscriptBox["r", "2"]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "+", 
         SubscriptBox["V", "0"]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], " ", "\[Psi]"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692137942615315*^9, 3.692138038069057*^9}, {
  3.693699217056481*^9, 3.69369923706916*^9}}],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], "E"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], 
      SubscriptBox["V", "0"]}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 ".  Also RESCALE ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]]],
 ".  Then"
}], "Text",
 CellChangeTimes->{{3.692282700363286*^9, 3.692282744588562*^9}, {
  3.693248576840211*^9, 3.693248624217347*^9}, {3.693698939880719*^9, 
  3.693698951485581*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["r", "2"]], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        SuperscriptBox["r", "2"]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"+", "\[Epsilon]"}]}]}], "+", 
      SubscriptBox["v", "0"], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], "r", " ", "\[Psi]"}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69228274835502*^9, 3.69228275862792*^9}, {
   3.693698955472597*^9, 3.693698958976012*^9}, 3.693699242712319*^9}],

Cell[TextData[{
 "The fundamental unit of length is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", the unit of energy is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]]],
 ". "
}], "Text",
 CellChangeTimes->{{3.693248653482848*^9, 3.693248683220747*^9}}],

Cell["Then inside,", "Text",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.6932480277736673`*^9}, {
  3.693248109225417*^9, 3.6932481100556517`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "in"], "(", "r", ")"}], "=", " ", 
   RowBox[{
    SubscriptBox["j", "L"], "(", 
    RowBox[{
     SqrtBox[
      RowBox[{"\[Epsilon]", "+", 
       SubscriptBox["v", "0"]}]], "r"}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.693248072278771*^9}, {
   3.693248113592057*^9, 3.69324812283921*^9}, 3.693250489887249*^9, {
   3.693699002454835*^9, 3.693699013455566*^9}, {3.693699113623049*^9, 
   3.693699142771453*^9}, {3.6936992506459913`*^9, 3.693699255180066*^9}}],

Cell[TextData[{
 "Outside (for bound states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "<", "0"}], TraditionalForm]]],
 "),"
}], "Text",
 CellChangeTimes->{{3.693248097589587*^9, 3.693248099460994*^9}, {
  3.693699075815839*^9, 3.693699079928297*^9}, {3.693699165129827*^9, 
  3.693699168158722*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "out"], "(", "r", ")"}], "=", " ", 
   RowBox[{
    SubscriptBox["k", "L"], "(", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", "\[Epsilon]"}]], " ", "r"}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693248097589587*^9, 3.6932481486696253`*^9}, {
   3.693249052980895*^9, 3.6932490537434893`*^9}, 3.693250492125453*^9, {
   3.693699026195723*^9, 3.693699041170506*^9}, {3.693699117789329*^9, 
   3.693699145219472*^9}, {3.693699258003784*^9, 3.693699260148109*^9}}],

Cell[TextData[{
 "while for scattering states with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", ">", "0"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.693699094651375*^9, 3.693699100302923*^9}, {
  3.693699173225232*^9, 3.693699176422379*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "out"], "(", "r", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["j", "L"], "(", 
     RowBox[{
      SqrtBox["\[Epsilon]"], "r"}], ")"}], "+", 
    RowBox[{
     SubscriptBox["K", "L"], 
     RowBox[{
      SubscriptBox["y", "L"], "(", 
      RowBox[{
       SqrtBox["\[Epsilon]"], "r"}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693699103247859*^9, 3.693699193896799*^9}, {
  3.6936992658751583`*^9, 3.6936992716908407`*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s focus on the bound states.  Matching the \
log-derivatives gives:\
\>", "Text",
 CellChangeTimes->{{3.693248262840794*^9, 3.6932482687550173`*^9}, {
