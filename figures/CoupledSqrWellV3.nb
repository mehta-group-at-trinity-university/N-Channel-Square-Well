Cell["\<\
Okay, there are some numerical quirks that need to be worked out here, and \
the code is clunky to be sure, but more or less this is right.  \
\>", "Text",
 CellChangeTimes->{{3.693700079943727*^9, 3.693700094850073*^9}, {
  3.6937031665364428`*^9, 3.6937031744866533`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["2-channel model", "Section",
 CellChangeTimes->{{3.693700109024497*^9, 3.69370011503261*^9}}],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s work through the two-channel physics before trying N \
channels.  In the ",
 StyleBox["interior",
  FontSlant->"Italic"],
 " region,"
}], "Text",
 CellChangeTimes->{{3.693700119210544*^9, 3.6937001306955757`*^9}, {
  3.693700166652358*^9, 3.693700172636544*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          FractionBox["1", 
           SuperscriptBox["r", "2"]], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", "r"}]], 
           SuperscriptBox["r", "2"]}], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", "r"}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "1"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}], 
        SubscriptBox["V", "12"]},
       {
        SubscriptBox["V", "12"], 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          FractionBox["1", 
           SuperscriptBox["r", "2"]], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", "r"}]], 
           SuperscriptBox["r", "2"]}], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", "r"}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "2"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "1"]}]},
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "2"]}]}
      }], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{"(", GridBox[{
       {
