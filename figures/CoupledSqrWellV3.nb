Cell[BoxData[
 RowBox[{
  RowBox[{"Vmax", "=", "1000"}], ";", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"VV", ",", 
        RowBox[{"\[Epsilon]", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"TEQ1", "/.", 
            RowBox[{"v0", "\[Rule]", "VV"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Epsilon]", ",", 
             RowBox[{
              RowBox[{"-", "VV"}], "+", 
              SuperscriptBox[
               RowBox[{"N", "[", 
                RowBox[{"BesselJZero", "[", 
                 RowBox[{
                  RowBox[{"3", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], 
              "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}]}], "}"}]}], 
          "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"VV", ",", "3", ",", "Vmax"}], "}"}]}], "]"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "Vmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Vmax"}], ",", "0"}], "}"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
