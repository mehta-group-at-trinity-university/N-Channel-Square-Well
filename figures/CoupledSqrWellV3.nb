    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "3"}], "+", 
       RowBox[{"2", " ", "v0", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"-", "\[Epsilon]"}]]}], ")"}]}], "-", 
       RowBox[{"6", " ", 
        SqrtBox[
         RowBox[{"-", "\[Epsilon]"}]]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"-", "\[Epsilon]"}]]}], ")"}], " ", "\[Epsilon]"}]}], 
      ")"}], " ", 
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.693699581432233*^9, 3.693699593166844*^9}, 
   3.701350153199677*^9}]
}, Open  ]],

Cell[TextData[{
 "For purposes of rootfinding, we\[CloseCurlyQuote]ll need to make a guess as \
to where the roots are.  Since we know the solutions in the interior region \
are simply besselfunctions, we can find approximate positions of the roots by \
treating the finite well like an infinite well and using the known zeroes of \
the Bessel function.  The additional \[OpenCurlyDoubleQuote]fudge factor\
\[CloseCurlyDoubleQuote] of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"], TraditionalForm]]],
 " seems to work well in correcting the high-lying states."
}], "Text",
 CellChangeTimes->{{3.693525760843252*^9, 3.693525863769813*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Vmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Vmax"}], "+", 
        SuperscriptBox[
         RowBox[{"N", "[", 
          RowBox[{"BesselJZero", "[", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}], ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"rootguess0", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"TEQ0", "/.", 
      RowBox[{"v0", "\[Rule]", "Vmax"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", 
       RowBox[{"-", "Vmax"}], ",", "0"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], ";", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p2", ",", "p3"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Vmax"}], ",", "0"}], "}"}], ",", "All"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"GridLines", "\[Rule]", "Automatic"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.693489621101309*^9, 3.6934896883477173`*^9}, {
