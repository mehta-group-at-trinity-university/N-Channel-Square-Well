Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Vmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Vmax"}], "+", 
        SuperscriptBox[
         RowBox[{"N", "[", 
          RowBox[{"BesselJZero", "[", 
           RowBox[{
            RowBox[{"3", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2.4", " ", "n"}], ")"}], "2"]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
