Cell[TextData[{
 "Define the matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["A",
    FontWeight->"Bold"], TraditionalForm]]],
 " such that it diagonalizes ",
 Cell[BoxData[
  FormBox[
   StyleBox["W",
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.691506438060916*^9, 3.6915064672088842`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["A",
      FontWeight->"Bold"], "\[Transpose]"}], " ", 
    StyleBox["W",
     FontWeight->"Bold"], " ", 
    StyleBox["A",
     FontWeight->"Bold"]}], "=", 
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691506438060916*^9, 3.6915064899813423`*^9}, {
  3.691540139994213*^9, 3.691540148601808*^9}}],

Cell[TextData[{
 "Where ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"], TraditionalForm]]],
 " is a diagonal matrix with the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W",
    FontWeight->"Bold"], TraditionalForm]]],
 ".  We have in region I:"
}], "Text",
 CellChangeTimes->{{3.691540331320681*^9, 3.691540373915174*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            SuperscriptBox["r", "2"]}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              RowBox[{" ", 
               SuperscriptBox["r", "2"]}]]}]}]}], "0"},
         {"0", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            SuperscriptBox["r", "2"]}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              RowBox[{" ", 
               SuperscriptBox["r", "2"]}]]}]}]}]}
        }], ")"}], "+", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "1"]}], ")"}], "g"},
         {"g", 
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "2"], "-", 
            SubscriptBox["\[Epsilon]", "2"]}], ")"}]}
        }], ")"}]}], "]"}], 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Psi]", "1", "I"]},
       {
        RowBox[{" ", 
         SubsuperscriptBox["\[Psi]", "2", "I"]}]}
      }], ")"}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.691506434252818*^9, 3.691540179737887*^9, {3.691542291173915*^9, 
   3.691542306891548*^9}, {3.691940612475456*^9, 3.69194064231033*^9}, {
   3.6920154758458757`*^9, 3.6920154772315683`*^9}, 3.693701318619419*^9}],

Cell[TextData[{
 "This is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["H",
      FontWeight->"Bold"], "0"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " being the diagonal matrix):"
}], "Text",
 CellChangeTimes->{{3.6915401928549547`*^9, 3.691540195673439*^9}, {
  3.7012955870529947`*^9, 3.701295599603454*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox[
       SubscriptBox["H", "0"],
       FontWeight->"Bold"], "+", 
      StyleBox["W",
       FontWeight->"Bold"]}], ")"}], 
    StyleBox["\[Psi]",
     FontWeight->"Bold"]}], "=", "0"}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.691540200739102*^9, 3.6915403119027042`*^9}, 
   3.7012955712928658`*^9}],

Cell[TextData[{
 "But ",
