Cell[CellGroupData[{

Cell["Generalize to N channels...", "Section",
 CellChangeTimes->{{3.69119241526888*^9, 3.691192436520215*^9}, {
  3.691541195693425*^9, 3.691541208493631*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s imagine a two-body Hamiltonian in relative coordinates \
that is of the form:\
\>", "Text",
 CellChangeTimes->{{3.69119241526888*^9, 3.691192467680552*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{"T", "+", "V"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 3.6911924796418753`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"V", "=", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["V", "1"], 
       SubscriptBox["V", "12"], 
       SubscriptBox["V", "13"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "21"], 
       SubscriptBox["V", "2"], 
       SubscriptBox["V", "23"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "31"], 
       SubscriptBox["V", "32"], 
       SubscriptBox["V", "3"], "\[CenterEllipsis]"},
      {"\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[VerticalEllipsis]", 
       "\[DescendingEllipsis]"}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 3.6911924829762497`*^9}, {
  3.691192582195599*^9, 3.691192621779035*^9}, {3.6911926721912203`*^9, 
  3.691192724406451*^9}, {3.693743909804731*^9, 3.693743916169649*^9}}],

Cell[TextData[{
 "Where ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"], TraditionalForm]]],
 " is a diagonal matrix with the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W",
    FontWeight->"Bold"], TraditionalForm]]],
 ".  We have in region I:"
}], "Text",
 CellChangeTimes->{{3.691540331320681*^9, 3.691540373915174*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            SuperscriptBox["r", "2"]}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              RowBox[{" ", 
               SuperscriptBox["r", "2"]}]]}]}]}], "0", "0", 
          "\[CenterEllipsis]"},
         {"0", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            SuperscriptBox["r", "2"]}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              RowBox[{" ", 
               SuperscriptBox["r", "2"]}]]}]}]}], "0", "\[CenterEllipsis]"},
         {"0", "0", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            SuperscriptBox["r", "2"]}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", "r"}]], 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              RowBox[{" ", 
               SuperscriptBox["r", "2"]}]]}]}]}], "\[CenterEllipsis]"},
         {"\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[VerticalEllipsis]",
           "\[DescendingEllipsis]"}
        }], ")"}], "+", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "1"]}], ")"}], 
          SubscriptBox["g", "12"], "\[CenterEllipsis]", 
          SubscriptBox["g", 
           RowBox[{"1", "N"}]]},
         {
          SubscriptBox["g", "12"], 
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "2"], "-", 
            SubscriptBox["\[Epsilon]", "2"]}], ")"}], "\[CenterEllipsis]", 
          SubscriptBox["g", 
           RowBox[{"2", "N"}]]},
         {"\[VerticalEllipsis]", "\[VerticalEllipsis]", 
          "\[DescendingEllipsis]", "\[VerticalEllipsis]"},
         {
          SubscriptBox["g", 
           RowBox[{"1", "N"}]], 
          SubscriptBox["g", 
           RowBox[{"2", "N"}]], "\[CenterEllipsis]", 
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "N"], "-", 
            SubscriptBox["\[Epsilon]", "N"]}], ")"}]}
        }], ")"}]}], "]"}], 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Psi]", "1", "I"]},
       {
        RowBox[{" ", 
         SubsuperscriptBox["\[Psi]", "2", "I"]}]},
       {"\[VerticalEllipsis]"},
       {
        SubsuperscriptBox["\[Psi]", "N", "I"]}
      }], ")"}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.691506434252818*^9, 3.691540179737887*^9, {3.691542291173915*^9, 
   3.691542306891548*^9}, {3.691940612475456*^9, 3.69194064231033*^9}, {
   3.6920154758458757`*^9, 3.6920154772315683`*^9}, 3.693701318619419*^9, {
   3.693743924374247*^9, 3.693744168671403*^9}}],

Cell["Now, we let", "Text",
 CellChangeTimes->{{3.693744253058013*^9, 3.693744255337215*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"W", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"(", 
        RowBox[{"\[Epsilon]", "+", 
         SubscriptBox["v", "1"]}], ")"}], 
       SubscriptBox["g", "12"], "\[CenterEllipsis]", 
       SubscriptBox["g", 
        RowBox[{"1", "N"}]]},
      {
       SubscriptBox["g", "12"], 
       RowBox[{"(", 
        RowBox[{"\[Epsilon]", "+", 
         SubscriptBox["v", "2"], "-", 
         SubscriptBox["\[Epsilon]", "2"]}], ")"}], "\[CenterEllipsis]", 
       SubscriptBox["g", 
        RowBox[{"2", "N"}]]},
      {"\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[DescendingEllipsis]", 
       "\[VerticalEllipsis]"},
      {
       SubscriptBox["g", 
        RowBox[{"1", "N"}]], 
       SubscriptBox["g", 
        RowBox[{"2", "N"}]], "\[CenterEllipsis]", 
       RowBox[{"(", 
        RowBox[{"\[Epsilon]", "+", 
         SubscriptBox["v", "N"], "-", 
         SubscriptBox["\[Epsilon]", "N"]}], ")"}]}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69374425817026*^9, 3.693744261417006*^9}}],

Cell["\<\
As a simple case, let\[CloseCurlyQuote]s assume that this matrix is \
tridiagonal, with equal coupling between neighboring channels.  Also assume \
that all of the potential depths are equal\
\>", "Text",
 CellChangeTimes->{{3.693744269353321*^9, 3.693744325989771*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["scratch work...", "Section",
 CellChangeTimes->{{3.6919398092710953`*^9, 3.691939814134585*^9}, {
  3.6937423685398283`*^9, 3.693742368971653*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "k", "]"}]], "Input",
 CellChangeTimes->{{3.691939895409574*^9, 3.6919398982319*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]phys", "=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], "S"}], "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}]},
     {
      RowBox[{"n", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "q"}], " ", "r"}]]}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{{3.691939824542192*^9, 3.691939891774976*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], " ", "S"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"100", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "1963"}], " ", "r"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.692020734651424*^9, 3.701350273240387*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{"\[Psi]phys", ",", "r"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.6919399315358477`*^9, 3.691939948564246*^9}, {
  3.692020739268639*^9, 3.692020743900567*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]], " ", "k", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "k", " ", "r"}]], " ", 
        "S"}]}], ")"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "196300"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "1963"}], " ", "r"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.6920207446579523`*^9, 3.701350273307729*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalBesselK", "[", 
   RowBox[{"L_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", 
     RowBox[{"2", "z"}]]], 
   RowBox[{"BesselK", "[", 
    RowBox[{
     RowBox[{"L", "+", 
      RowBox[{"1", "/", "2"}]}], ",", "z"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.693247113194558*^9, 3.693247128344191*^9}, {
  3.69324717214857*^9, 3.693247190099729*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"FunctionExpand", "[", 
    RowBox[{"x", " ", 
     RowBox[{"SphericalBesselK", "[", 
      RowBox[{"0", ",", "x"}], "]"}]}], "]"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ">", "0"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.693247227139511*^9, 3.693247268673959*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]], " ", "\[Pi]"}], "2"]], "Output",
 CellChangeTimes->{{3.693247236044632*^9, 3.6932472690705147`*^9}, 
   3.701350273396023*^9}]
}, Open  ]],

