Cell[BoxData[
 RowBox[{
  RowBox[{"SetupPotentialCO", "[", 
   RowBox[{
   "numChan_", ",", "numOpen_", ",", "r0_", ",", "\[Gamma]_", ",", "D0_", ",",
     "\[CapitalDelta]D_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", "U", ",", "\[CapitalLambda]vals", ",", "V"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"V", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "numChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"-", "D0"}], "+", 
         RowBox[{"\[CapitalDelta]D", "*", "i"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "numChan"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "i"}], "]"}], "]"}], "=", "\[Gamma]"}], ";", " ", 
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", "\[Gamma]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "numChan"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]vals", " ", "=", " ", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Eigenvalues", "[", "V", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"U", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"Eigenvectors", "[", "V", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "numChan"}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"V", ",", "\[CapitalLambda]vals", ",", "U"}], "}"}]}]}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Setup\[CapitalPhi]", "[", 
   RowBox[{
   "numChan_", ",", "r0_", ",", "\[CapitalLambda]vals_", ",", "U_", ",", 
    "Energy_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalPhi]", ",", "d\[CapitalPhi]", ",", "i", ",", "j"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"U", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"N", "[", 
          RowBox[{"\[Phi]", "[", 
           RowBox[{"r0", ",", 
            RowBox[{"Energy", "-", 
             RowBox[{"\[CapitalLambda]vals", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "numChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[CapitalPhi]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"U", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"N", "[", 
          RowBox[{"d\[Phi]", "[", 
           RowBox[{"r0", ",", 
            RowBox[{"Energy", "-", 
             RowBox[{"\[CapitalLambda]vals", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "numChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[CapitalPhi]", ",", "d\[CapitalPhi]"}], "}"}]}]}], 
   "]"}]}]], "Input"],

