         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselK", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], 
        "]"}]}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "\[Rule]", "2"}], ",", 
       RowBox[{"r", "\[Rule]", "1"}], ",", 
       RowBox[{"\[Beta]", "\[Rule]", 
