Notebook[{
Cell["", "Text",
 CellChangeTimes->{{3.692452374626791*^9, 3.692452375839117*^9}}],

Cell[CellGroupData[{

Cell["Coupled square well scattering and bound states", "Title",
 CellChangeTimes->{{3.691192381712702*^9, 3.691192391380272*^9}, {
  3.6915360359596577`*^9, 3.691536037733398*^9}}],

Cell["A \[OpenCurlyDoubleQuote]simple\[CloseCurlyDoubleQuote] multichannel \
model", "Subtitle",
 CellChangeTimes->{{3.691192392150342*^9, 3.691192404821622*^9}}],

Cell[CellGroupData[{

Cell["1-channel square well", "Section",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137821837714*^9}}],

Cell[TextData[{
 "As a preliminary to the multichannel case, we will need to solve the single \
channel case to understand where the bound states are with respect to the \
threshold.  This will help us interpret the two-channel resonances, at least \
in the weak coupling regime.  Inside the well of range ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", the wavefunction satisfies:"
}], "Text",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137929269053*^9}, {
  3.692282786010167*^9, 3.692282798297591*^9}, {3.693247648593514*^9, 
  3.693247653543399*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "+", 
         SubscriptBox["V", "0"]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], "r", " ", "\[Psi]"}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692137942615315*^9, 3.692138038069057*^9}}],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], "E"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Gamma]", "2"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], 
      SubscriptBox["V", "0"]}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 ".  Also RESCALE ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  Then"
}], "Text",
 CellChangeTimes->{{3.692282700363286*^9, 3.692282744588562*^9}, {
  3.693248576840211*^9, 3.693248624217347*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{"+", 
        SuperscriptBox["k", "2"]}]}], "+", 
      SuperscriptBox["\[Gamma]", "2"], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], "r", " ", "\[Psi]"}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69228274835502*^9, 3.69228275862792*^9}}],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "2"], "=", 
    RowBox[{
     SuperscriptBox["k", "2"], "+", 
     SuperscriptBox["\[Gamma]", "2"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", and divide through by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm"]
}], "Text",
 CellChangeTimes->{{3.6932478860162077`*^9, 3.6932479787780113`*^9}, {
  3.693248723972603*^9, 3.69324872423641*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Beta]", " ", "r"}], ")"}], "2"]}]], 
       RowBox[{"+", "1"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Beta]", " ", "r"}], ")"}], "2"]}]]}], ")"}], "r", " ", 
    "\[Psi]"}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.693247868285534*^9, {3.6932479524396048`*^9, 3.693248019369544*^9}}],

Cell[TextData[{
 "The fundamental unit of length is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", the unit of energy is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". "
}], "Text",
 CellChangeTimes->{{3.693248653482848*^9, 3.693248683220747*^9}}],

Cell["Then inside,", "Text",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.6932480277736673`*^9}, {
  3.693248109225417*^9, 3.6932481100556517`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["r\[Psi]", "in"], "(", 
    RowBox[{"\[Beta]", " ", "r"}], ")"}], "=", " ", 
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["j", "l"], "(", 
     RowBox[{"\[Beta]", " ", "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.693248072278771*^9}, {
   3.693248113592057*^9, 3.69324812283921*^9}, 3.693250489887249*^9}],

Cell["Outside,", "Text",
 CellChangeTimes->{{3.693248097589587*^9, 3.693248099460994*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["r\[Psi]", "out"], "(", 
    RowBox[{"k", " ", "r"}], ")"}], "=", " ", 
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["k", "l"], "(", 
     RowBox[{"\[Kappa]", " ", "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693248097589587*^9, 3.6932481486696253`*^9}, {
   3.693249052980895*^9, 3.6932490537434893`*^9}, 3.693250492125453*^9}],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Kappa]", "2"], "=", 
    RowBox[{
     RowBox[{"-", "2"}], "\[Mu]", " ", 
     RowBox[{"E", "/", 
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], "."}]}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "  or."
}], "Text",
 CellChangeTimes->{{3.6932482222548237`*^9, 3.6932482263765917`*^9}, {
  3.69324908776475*^9, 3.693249102522346*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "in"], "=", 
   RowBox[{
    SubscriptBox["j", "l"], "(", 
    RowBox[{"\[Beta]", " ", "r"}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6932482222548237`*^9, 3.693248250108081*^9}, {
  3.693250493565502*^9, 3.693250494469678*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "out"], "=", 
   RowBox[{
    SubscriptBox["k", "l"], "(", 
    RowBox[{"\[Kappa]", " ", "r"}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693248252965385*^9, 3.693248261227797*^9}, {
  3.693249106034397*^9, 3.6932491101621857`*^9}, {3.693250495861464*^9, 
  3.693250501276966*^9}}],

Cell["matcing the log-derivatives gives:", "Text",
 CellChangeTimes->{{3.693248262840794*^9, 3.6932482687550173`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "V0", "]"}]], "Input",
 CellChangeTimes->{{3.6932506211816063`*^9, 3.693250622797802*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalBesselK", "[", 
   RowBox[{"L_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", 
     RowBox[{"2", "z"}]]], 
   RowBox[{"BesselK", "[", 
    RowBox[{
     RowBox[{"L", "+", 
      RowBox[{"1", "/", "2"}]}], ",", "z"}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.693248343472334*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"L", ",", 
          RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
     "-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"SphericalBesselK", "[", 
         RowBox[{"L", ",", 
          RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}]}],
     "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "\[Rule]", "0"}], ",", 
      RowBox[{"r", "\[Rule]", "1"}], ",", 
      RowBox[{"\[Beta]", "\[Rule]", 
       SqrtBox[
        RowBox[{" ", 
         RowBox[{"EE", "+", "V0"}]}]]}], ",", 
      RowBox[{"k", "\[Rule]", 
       SqrtBox["EE"]}], ",", 
      RowBox[{"\[Kappa]", "\[Rule]", 
       SqrtBox[
        RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693248309096943*^9, 3.693248421137924*^9}, {
   3.693248491845243*^9, 3.6932485401534233`*^9}, {3.693248759742799*^9, 
   3.6932488029412737`*^9}, {3.693248843931534*^9, 3.6932488497787848`*^9}, {
   3.6932489835882883`*^9, 3.6932490173124523`*^9}, {3.693249070494452*^9, 
   3.693249072508464*^9}, {3.6932491242032824`*^9, 3.69324912463411*^9}, {
   3.6932491655362043`*^9, 3.693249173168014*^9}, 3.693249236451098*^9, {
   3.693249436966845*^9, 3.693249439221077*^9}, {3.693250545054103*^9, 
   3.6932505531712313`*^9}}],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"-", "EE"}]], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"EE", "+", "V0"}]], " ", 
   RowBox[{"Cot", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.693248412131929*^9, 3.693248426612399*^9}, {
   3.693248751713696*^9, 3.693248820921893*^9}, 3.693248853522028*^9, 
   3.693248987662314*^9, 3.693249018314794*^9, 3.693249075695457*^9, 
   3.693249125190069*^9, 3.6932491745969763`*^9, 3.693249207284171*^9, 
   3.6932492399112663`*^9, 3.6932494398813133`*^9, 3.6932506260624533`*^9}]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s make this easier to handle by multiplying through by \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"sin", "(", 
    SqrtBox[
     RowBox[{"E", "+", 
      SubscriptBox["V", "0"]}]], ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " (it\[CloseCurlyQuote]s all equal to zero anyhow, so this doesn\
\[CloseCurlyQuote]t change the position of the roots.)"
}], "Text",
 CellChangeTimes->{{3.693250554885047*^9, 3.6932505906618643`*^9}}],

Cell["For s-waves:", "Text",
 CellChangeTimes->{{3.693525710238262*^9, 3.693525717359888*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"EE", "+", "V0"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
       "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselK", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], 
        "]"}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "\[Rule]", "0"}], ",", 
      RowBox[{"r", "\[Rule]", "1"}], ",", 
      RowBox[{"\[Beta]", "\[Rule]", 
       SqrtBox[
        RowBox[{" ", 
         RowBox[{"EE", "+", "V0"}]}]]}], ",", 
      RowBox[{"k", "\[Rule]", 
       SqrtBox["EE"]}], ",", 
      RowBox[{"\[Kappa]", "\[Rule]", 
       SqrtBox[
        RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693250594646847*^9, 3.6932506485730143`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"EE", "+", "V0"}]], " ", 
   RowBox[{"Cos", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"-", "EE"}]], " ", 
   RowBox[{"Sin", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.693250613454967*^9, 3.693250649741685*^9}, 
   3.693486800412026*^9}]
}, Open  ]],

Cell["for p-waves:", "Text",
 CellChangeTimes->{{3.693525719357353*^9, 3.693525723671596*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ1", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
