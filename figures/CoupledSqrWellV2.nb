Cell["and for d-waves:", "Text",
 CellChangeTimes->{{3.693525730194262*^9, 3.693525733079321*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ2", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
       "-", 
       RowBox[{"D", "[", 
