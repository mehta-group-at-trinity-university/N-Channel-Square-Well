   3.693249469235478*^9}, {3.693250786031393*^9, 3.693250795867922*^9}}],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"EE", " ", 
       SqrtBox[
        RowBox[{"EE", "+", "V0"}]], " ", 
       RowBox[{"Cos", "[", 
