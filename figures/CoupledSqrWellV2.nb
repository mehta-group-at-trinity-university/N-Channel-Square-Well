Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ2", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", 
           SqrtBox[
            RowBox[{"-", "EE"}]]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"3", "+", 
             SqrtBox[
              RowBox[{"-", "EE"}]]}], ")"}], " ", "EE"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           SqrtBox[
            RowBox[{"EE", "+", "V0"}]], " ", 
           RowBox[{"Cos", "[", 
            SqrtBox[
             RowBox[{"EE", "+", "V0"}]], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "3"}], "+", "EE", "+", "V0"}], ")"}], " ", 
           RowBox[{"Sin", "[", 
            SqrtBox[
             RowBox[{"EE", "+", "V0"}]], "]"}]}]}], ")"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"L", ",", 
             RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}],
         "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"SphericalBesselK", "[", 
            RowBox[{"L", ",", 
             RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], 
         "]"}]}], ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "\[Rule]", "2"}], ",", 
       RowBox[{"r", "\[Rule]", "1"}], ",", 
       RowBox[{"\[Beta]", "\[Rule]", 
        SqrtBox[
         RowBox[{" ", 
          RowBox[{"EE", "+", "V0"}]}]]}], ",", 
       RowBox[{"k", "\[Rule]", 
        SqrtBox[
         RowBox[{" ", "EE"}]]}], ",", 
       RowBox[{"\[Kappa]", "\[Rule]", 
        SqrtBox[
         RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693250882976261*^9, 3.693250893272307*^9}, 
   3.6935260403879833`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"EE", "+", "V0"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "EE"}], ")"}], 
      RowBox[{"5", "/", "2"}]], "-", 
     RowBox[{"3", " ", 
      SqrtBox[
       RowBox[{"-", "EE"}]], " ", "V0"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        SqrtBox[
         RowBox[{"-", "EE"}]]}], ")"}], " ", "EE", " ", "V0"}]}], ")"}], " ", 
   
   RowBox[{"Cos", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}], "-", 
