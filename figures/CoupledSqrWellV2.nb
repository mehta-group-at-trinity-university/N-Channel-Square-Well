Cell[BoxData[{
 RowBox[{
  RowBox[{"Vmax", "=", "2000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Vmax"}], "+", 
        SuperscriptBox[
         RowBox[{"N", "[", 
          RowBox[{"BesselJZero", "[", 
           RowBox[{
            RowBox[{"5", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}], ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"rootguess2", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"TEQ2", "/.", 
      RowBox[{"V0", "\[Rule]", "Vmax"}]}], ",", 
