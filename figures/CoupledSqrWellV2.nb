  3.693250867611342*^9, 3.693250874192922*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "EE"}], ")"}], 
       RowBox[{"5", "/", "2"}]], "-", 
      RowBox[{"3", " ", 
       SqrtBox[
        RowBox[{"-", "EE"}]], " ", "V0"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "+", 
         SqrtBox[
          RowBox[{"-", "EE"}]]}], ")"}], " ", "EE", " ", "V0"}]}], ")"}], " ", 
    RowBox[{"Cos", "[", 
     SqrtBox[
      RowBox[{"EE", "+", "V0"}]], "]"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["EE", "3"], "-", 
      RowBox[{"3", " ", 
       SqrtBox[
        RowBox[{"-", "EE"}]], " ", "V0"}], "+", 
      RowBox[{"EE", " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", "EE"}], ")"}], " ", "V0"}]}], ")"}], " ", 
    RowBox[{"Sin", "[", 
     SqrtBox[
      RowBox[{"EE", "+", "V0"}]], "]"}]}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", 
      SqrtBox[
       RowBox[{"-", "EE"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        SqrtBox[
         RowBox[{"-", "EE"}]]}], ")"}], " ", "EE"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"3", " ", 
      SqrtBox[
       RowBox[{"EE", "+", "V0"}]], " ", 
      RowBox[{"Cos", "[", 
       SqrtBox[
        RowBox[{"EE", "+", "V0"}]], "]"}]}], "+", 
