Cell[CellGroupData[{

Cell["Generalize to N channels...", "Section",
 CellChangeTimes->{{3.69119241526888*^9, 3.691192436520215*^9}, {
  3.691541195693425*^9, 3.691541208493631*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s imagine a two-body Hamiltonian in relative coordinates \
that is of the form:\
\>", "Text",
 CellChangeTimes->{{3.69119241526888*^9, 3.691192467680552*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{"T", "+", "V"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 3.6911924796418753`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"V", "=", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["V", "11"], 
       SubscriptBox["V", "12"], 
       SubscriptBox["V", "13"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "21"], 
       SubscriptBox["V", "22"], 
       SubscriptBox["V", "23"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "31"], 
       SubscriptBox["V", "32"], 
       SubscriptBox["V", "33"], "\[CenterEllipsis]"},
      {"\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[VerticalEllipsis]", 
       "\[DescendingEllipsis]"}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 3.6911924829762497`*^9}, {
  3.691192582195599*^9, 3.691192621779035*^9}, {3.6911926721912203`*^9, 
  3.691192724406451*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["scratch...", "Section",
 CellChangeTimes->{{3.6919398092710953`*^9, 3.691939814134585*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "k", "]"}]], "Input",
 CellChangeTimes->{{3.691939895409574*^9, 3.6919398982319*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]phys", "=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], "S"}], "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}]},
     {
      RowBox[{"n", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "q"}], " ", "r"}]]}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{{3.691939824542192*^9, 3.691939891774976*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], " ", "S"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "q"}], " ", "r"}]], " ", "n"}], "}"}]}], "}"}]], "Output",\

 CellChangeTimes->{3.692020734651424*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{"\[Psi]phys", ",", "r"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.6919399315358477`*^9, 3.691939948564246*^9}, {
  3.692020739268639*^9, 3.692020743900567*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]], " ", "k", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "k", " ", "r"}]], " ", 
        "S"}]}], ")"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "q"}], " ", "r"}]]}], " ", "n", " ", "q"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.6920207446579523`*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalBesselK", "[", 
   RowBox[{"L_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", 
     RowBox[{"2", "z"}]]], 
   RowBox[{"BesselK", "[", 
    RowBox[{
     RowBox[{"L", "+", 
      RowBox[{"1", "/", "2"}]}], ",", "z"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.693247113194558*^9, 3.693247128344191*^9}, {
  3.69324717214857*^9, 3.693247190099729*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"FunctionExpand", "[", 
    RowBox[{"x", " ", 
     RowBox[{"SphericalBesselK", "[", 
      RowBox[{"0", ",", "x"}], "]"}]}], "]"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ">", "0"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.693247227139511*^9, 3.693247268673959*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]], " ", "\[Pi]"}], "2"]], "Output",
 CellChangeTimes->{{3.693247236044632*^9, 3.6932472690705147`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
