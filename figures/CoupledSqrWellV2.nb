   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"VV", ",", 
        RowBox[{"EE", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"TEQ1", "/.", 
            RowBox[{"V0", "\[Rule]", "VV"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"EE", ",", 
             RowBox[{
              RowBox[{"-", "VV"}], "+", 
              SuperscriptBox[
               RowBox[{"N", "[", 
                RowBox[{"BesselJZero", "[", 
                 RowBox[{
                  RowBox[{"3", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], 
              "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}]}], "}"}]}], 
          "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "10"}], "}"}], ",", 
