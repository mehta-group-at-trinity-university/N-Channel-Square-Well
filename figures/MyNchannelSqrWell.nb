       RowBox[{"r", ",", "1", ",", "\[Infinity]"}], "}"}]}], "]"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"\[Kappa]", ">", "0"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.703196851493656*^9, 3.703196852189196*^9}, {
  3.7031968968247347`*^9, 3.703196902390209*^9}, {3.70319701642929*^9, 
  3.70319710324445*^9}, {3.703197441142153*^9, 3.703197490832685*^9}, {
  3.703197521537472*^9, 3.703197522911415*^9}, {3.703197558101799*^9, 
  3.7031976739494333`*^9}}],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", "\[Pi]", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"\[Kappa]", " ", 
     SuperscriptBox[
      RowBox[{"BesselK", "[", 
