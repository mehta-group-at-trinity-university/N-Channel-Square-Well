Cell["\<\
This next bit of code smooths out the phaseshift by adding/subtracting \[Pi] \
at the discontinuities:\
\>", "Text",
 CellChangeTimes->{{3.7030919956591997`*^9, 3.7030920209676933`*^9}, 
   3.70309738111369*^9, 3.703097412968913*^9, 3.703287451401404*^9, {
   3.703467526779379*^9, 3.703467533499607*^9}, 3.7034684239670973`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Delta]dataOver\[Pi]", "=", 
   RowBox[{
    RowBox[{"Transpose", "[", "dataArray", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l\[Delta]", "=", 
   RowBox[{"Length", "[", "\[Delta]dataOver\[Pi]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Which", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Delta]dataOver\[Pi]", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"\[Delta]dataOver\[Pi]", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}]}], ">", 
       RowBox[{"1", "/", "2"}]}], ",", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]dataOver\[Pi]", "[", 
          RowBox[{"[", 
           RowBox[{"j", ",", "2"}], "]"}], "]"}], "-=", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "i", ",", "l\[Delta]"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Delta]dataOver\[Pi]", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"\[Delta]dataOver\[Pi]", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}]}], "<", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}]}], ",", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]dataOver\[Pi]", "[", 
          RowBox[{"[", 
           RowBox[{"j", ",", "2"}], "]"}], "]"}], "+=", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "i", ",", "l\[Delta]"}], "}"}]}], "]"}]}], "]"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "2", ",", "l\[Delta]"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.7030266036107817`*^9, 3.70302672001257*^9}, {
  3.7030267884599667`*^9, 3.703026816522922*^9}, {3.703026920076457*^9, 
  3.7030269205951643`*^9}, {3.7030911878485126`*^9, 3.70309139442733*^9}, {
  3.703091504763402*^9, 3.703091521875325*^9}, {3.703092035236998*^9, 
  3.703092048432846*^9}, {3.7032873073153143`*^9, 3.703287325977161*^9}, {
  3.70328780214863*^9, 3.703287932038113*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"\[Delta]dataOver\[Pi]", ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "Large"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<E/(\!\(\*SuperscriptBox[\(\[HBar]\), \
\(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[\(\[Delta]\), \(0\)]\)/\[Pi]\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{
  3.703092051280436*^9, {3.70328704964299*^9, 3.703287140822646*^9}, {
   3.703287295778989*^9, 3.703287299873708*^9}, {3.703287638868102*^9, 
