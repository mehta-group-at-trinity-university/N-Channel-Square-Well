      }], ")"}]}], "=", 
   RowBox[{"(", GridBox[{
      {"0"},
      {"0"},
      {"0"},
      {"0"},
      {"0"},
      {"1"}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703192475890101*^9, 3.703192653989407*^9}, {
