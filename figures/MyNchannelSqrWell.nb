     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ABMat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "i"}], "-", "1"}], ",", 
            RowBox[{"i", "+", "1"}]}], " ", "]"}], "]"}], "=", 
         RowBox[{"gb", "[", 
          RowBox[{"L", ",", 
           SqrtBox[
            RowBox[{
             RowBox[{"\[Epsilon]thresh", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", "\[Epsilon]"}]], ",", 
           "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ABMat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", "i"}], ",", 
            RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
         RowBox[{"dgb", "[", 
          RowBox[{"L", ",", 
           SqrtBox[
            RowBox[{
             RowBox[{"\[Epsilon]thresh", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", "\[Epsilon]"}]], ",", 
           "r"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"2", "NumOpen"}], ",", "NumChan"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ABMat", "[", 
       RowBox[{"[", 
        RowBox[{"Size", ",", "1"}], "]"}], "]"}], "=", "1"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"L", ",", 
          SqrtBox[
           RowBox[{
            RowBox[{"\[CapitalLambda]", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", "\[Epsilon]"}]], ",", " ", 
          "r"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]", "=", 
      RowBox[{"Table", "[", 
