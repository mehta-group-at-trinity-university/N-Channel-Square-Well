Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["f", "o"], 
        RowBox[{"-", 
         SubscriptBox["g", "o"]}], "0", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "11", "I"]}], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "12", "I"]}]},
       {
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["f", "o"]}], 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["g", "o"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "11", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "12", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}]},
       {"0", "0", 
        SubscriptBox["g", "2"], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "21", "I"]}], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "22", "I"]}]},
       {"0", "0", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["g", "2"]}], 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "21", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "22", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}]},
       {"1", "0", "0", "0", "0"}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {"c"},
       {"s"},
       {
        SubscriptBox["a", "1"]},
       {
        SubscriptBox["b", "1"]},
       {
        SubscriptBox["b", "2"]}
      }], ")"}]}], "=", 
   RowBox[{"(", GridBox[{
      {"0"},
      {"0"},
      {"0"},
      {"0"},
      {"0"},
      {"1"}
     }], ")"}]}], TraditionalForm]], "Text",
 CellChangeTimes->{3.702920096810151*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetupPotentialW", "[", 
   RowBox[{"NumChan_", ",", "v0_", ",", "\[Epsilon]1_", ",", "\[Gamma]_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", "\[Epsilon]thresh"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"\[Epsilon]thresh", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Epsilon]1", " ", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]thresh", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "1"}], ",", "0", ",", "\[Epsilon]1"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"W", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "j"}], ",", "v0", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", 
               RowBox[{"j", "-", "1"}]}], "]"}], "+", " ", 
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "]"}]}], ")"}], "\[Gamma]"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Avals", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AvecsNormed", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "NumChan"}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "Avals", ",", "AvecsNormed", ",", "\[Epsilon]thresh", ",", "W"}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.702921890065279*^9, 3.702922036740788*^9}, {
   3.702922076670105*^9, 3.702922095219328*^9}, {3.702991744329726*^9, 
   3.70299183670363*^9}, 3.702997281917778*^9, {3.7030024438476677`*^9, 
