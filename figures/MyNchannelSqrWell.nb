Cell[BoxData[
 RowBox[{
  RowBox[{"SetupABMat", "[", 
   RowBox[{
   "NumChan_", ",", "NumOpen_", ",", "\[Epsilon]thresh_", ",", 
    "\[CapitalLambda]_", ",", "U_", ",", "L_", ",", "r_", ",", 
    "\[Epsilon]_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "j", ",", "Size", ",", "ABMat", ",", "Bvec", ",", "\[Phi]", 
      ",", "d\[Phi]", ",", "\[Psi]I", ",", "d\[Psi]I"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Size", "=", 
      RowBox[{
       RowBox[{"2", "NumChan"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Bvec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Size"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Bvec", "[", 
       RowBox[{"[", "Size", "]"}], "]"}], "=", "1.0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ABMat", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Size"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "Size"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ABMat", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "=", 
      RowBox[{"f", "[", 
       RowBox[{"L", ",", 
        SqrtBox["\[Epsilon]"], ",", "r"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ABMat", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}], "=", 
      RowBox[{"-", 
       RowBox[{"g", "[", 
        RowBox[{"L", ",", 
         SqrtBox["\[Epsilon]"], ",", "r"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ABMat", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}], "=", 
      RowBox[{"df", "[", 
       RowBox[{"L", ",", 
        SqrtBox["\[Epsilon]"], ",", "r"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
