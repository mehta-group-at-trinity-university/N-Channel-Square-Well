      RowBox[{"LinearSolve", "[", 
       RowBox[{"ABMat", ",", "Bvec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "sols"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
