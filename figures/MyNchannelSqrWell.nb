         RowBox[{"j", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[Psi]I", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
