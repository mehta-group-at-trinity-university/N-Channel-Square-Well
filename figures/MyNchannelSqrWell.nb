      RowBox[{"ABMat", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}], "=", 
      RowBox[{"-", 
       RowBox[{"dg", "[", 
        RowBox[{"L", ",", 
