Cell["At the well edge we require", "Text",
 CellChangeTimes->{{3.7031931009139643`*^9, 3.703193106580398*^9}, {
  3.703195776861305*^9, 3.703195782251593*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["a", "i"], 
    RowBox[{
     SubscriptBox["g", "i"], "(", "R", ")"}]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     RowBox[{
      SubscriptBox["\[Psi]", "i\[Alpha]"], "(", "R", ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703193110301034*^9, 3.703193142725477*^9}, {
  3.7031956940885067`*^9, 3.703195711753693*^9}, {3.703195745534267*^9, 
  3.70319577230835*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["a", "i"], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{
       SubscriptBox["g", "i"], "(", "R", ")"}]}], 
     RowBox[{"\[PartialD]", "r"}]]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{
        SubscriptBox["\[Psi]", "i\[Alpha]"], "(", "R", ")"}]}], 
      RowBox[{"\[PartialD]", "r"}]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703195799897128*^9, 3.703195828219099*^9}}],

Cell[TextData[{
 "This comprises",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"N", "-", "1"}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " unknowns (the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "s and the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "s) and also ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{"N", "-", "1"}], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " equations.  The energy eigenvalue must be determined by the normalization \
condition.  This may not be as simple as I had hoped..."
}], "Text",
 CellChangeTimes->{{3.703196617223268*^9, 3.7031967077316732`*^9}, {
  3.7031968342444963`*^9, 3.7031968433078833`*^9}}],

Cell["The solution is then:", "Text",
 CellChangeTimes->{{3.703264343681344*^9, 3.703264347397151*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "i"], "(", 
    RowBox[{"\[Epsilon]", ",", "r"}], ")"}], "=", 
   RowBox[{"{", GridBox[{
      {
       RowBox[{
        RowBox[{
         UnderscriptBox["\[Sum]", "\[Alpha]"], 
         RowBox[{
          SubscriptBox["b", "\[Alpha]"], 
          RowBox[{
           SubscriptBox["\[Psi]", "i\[Alpha]"], "(", "r", ")"}], "   ", "if", 
          " ", "r"}]}], "<", "R"}]},
      {
       RowBox[{
        RowBox[{
         SubscriptBox["a", "i"], 
         RowBox[{
          SubscriptBox["g", "i"], "(", "r", ")"}], "        ", "if", " ", 
         "r"}], ">", "R"}]}
     }]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703264349946059*^9, 3.7032644617051983`*^9}}],

Cell["Normalized in each channel according to:", "Text",
 CellChangeTimes->{{3.703264479059721*^9, 3.703264486236063*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"L", ",", "k", ",", "r"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.703197055134869*^9, 3.703197063332921*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"OuterNorm", "[", 
   RowBox[{"L_", ",", "\[Kappa]_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"gb", "[", 
        RowBox[{"L", ",", "\[Kappa]", ",", "r"}], "]"}], "2"], ",", 
