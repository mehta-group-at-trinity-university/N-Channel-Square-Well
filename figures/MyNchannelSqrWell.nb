         RowBox[{"U", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], 
         RowBox[{"d\[Phi]", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ABMat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "i"}], "-", "1"}], ",", 
            RowBox[{"j", "+", 
             RowBox[{"(", 
              RowBox[{"NumChan", "+", "1"}], ")"}]}]}], "]"}], "]"}], "=", 
         RowBox[{"-", 
          RowBox[{"\[Psi]I", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ABMat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", "i"}], ",", 
