  FormBox[
   TemplateBox[{"b"},
    "Ket"], TraditionalForm]]],
 " by diagonalizing the bound state sector only.  To do that we need to \
calculate the characteristic determinant for the energy eigenvalues.  We \
require that the wave function and derivative be continuous at the well edge. \
 First, define the matrix ",
 StyleBox["\[CapitalPhi]",
  FontWeight->"Bold"],
 " with elements:"
}], "Text",
 CellChangeTimes->{{3.7031920625030737`*^9, 3.703192199824359*^9}, {
  3.7033494758405027`*^9, 3.703349493806114*^9}, {3.7033500892781*^9, 
  3.7033500987509413`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPhi]", "i\[Alpha]"], "=", 
   RowBox[{
    SubscriptBox["U", "i\[Alpha]"], 
    SubscriptBox["f", "\[Alpha]"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7031920625030737`*^9, 3.703192199824359*^9}, {
  3.7033494758405027`*^9, 3.703349529496676*^9}}],

Cell["\<\
This defines the interior solutions which are defined as a linear combination \
of these:\
\>", "Text",
 CellChangeTimes->{{3.7033495343546343`*^9, 3.703349564018578*^9}, {
  3.703349617191965*^9, 3.703349625599554*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Psi]", "i", "I"], "(", "r", ")"}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "i\[Alpha]"], "(", "r", ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7033495343546343`*^9, 3.7033496121797743`*^9}, {
  3.703349671029764*^9, 3.703349671343302*^9}}],

Cell["The exterior solutions are all decaying functions:", "Text",
 CellChangeTimes->{{3.703349627411848*^9, 3.703349636704713*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Psi]", "i", "II"], "(", "r", ")"}], "=", 
   RowBox[{
    SubscriptBox["a", "i"], 
    RowBox[{
     SubscriptBox["g", "b"], "(", 
     RowBox[{
      SubscriptBox["\[Kappa]", "i"], "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703349627411848*^9, 3.7033496679111443`*^9}}],

Cell["\<\
Then in each channel, the log-derivative of the wave function must be \
continuous so we have:\
\>", "Text",
 CellChangeTimes->{{3.703349692290214*^9, 3.7033497199973917`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"[", 
     RowBox[{
      FractionBox["1", 
       SubsuperscriptBox["\[Psi]", "i", "I"]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubsuperscriptBox["\[Psi]", "i", "I"]}], 
       RowBox[{"\[PartialD]", "r"}]]}], "]"}], "R"], "=", 
   SubscriptBox[
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SubscriptBox["g", "b"], "(", 
       RowBox[{
        SubscriptBox["\[Kappa]", "i"], "R"}], ")"}]], "[", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["g", "b"]}], 
      RowBox[{"\[PartialD]", "r"}]], "]"}], "R"]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703349725645406*^9, 3.703349827082872*^9}, {
  3.703349944912147*^9, 3.703349945793379*^9}}],

Cell[TextData[{
 "Define a diagonal matrix ",
 StyleBox["G ",
  FontWeight->"Bold"],
 "with elements: "
}], "Text",
 CellChangeTimes->{{3.703349946754715*^9, 3.703349947742613*^9}, {
  3.703350063270776*^9, 3.703350074846414*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "i"], "=", 
   SubscriptBox[
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SubscriptBox["g", "b"], "(", 
       RowBox[{
        SubscriptBox["\[Kappa]", "i"], "R"}], ")"}]], "[", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["g", "b"]}], 
      RowBox[{"\[PartialD]", "r"}]], "]"}], "R"]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7033499490652037`*^9, 3.7033499545136013`*^9}}],

Cell["or...", "Text",
 CellChangeTimes->{{3.703349936092491*^9, 3.703349936846897*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "i\[Alpha]"], "(", "r", ")"}]}], 
      RowBox[{"\[PartialD]", "r"}]]}]}], "=", 
   RowBox[{
    SubscriptBox["G", "i"], 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      SubscriptBox["b", "\[Alpha]"], 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "i\[Alpha]"], "(", "r", ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703349849561215*^9, 3.7033498661951447`*^9}}],

Cell["and this becomes a matrix equation of the form", "Text",
 CellChangeTimes->{{3.703349961185708*^9, 3.703349967733762*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        StyleBox["\[PartialD]",
         FontWeight->"Plain"], 
        StyleBox["\[CapitalPhi]",
         FontWeight->"Bold"]}], 
       RowBox[{"\[PartialD]", "r"}]], ")"}], "R"], 
    StyleBox["b",
     FontWeight->"Bold"]}], "=", 
   StyleBox[
    RowBox[{"G", " ", "\[CapitalPhi]", " ", "b"}],
    FontWeight->"Bold"]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7033499743287354`*^9, 3.703350036172536*^9}}],

Cell["This suggests", "Text",
 CellChangeTimes->{{3.703350047101109*^9, 3.703350059856386*^9}, {
  3.703350103430525*^9, 3.7033501076223583`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          StyleBox["\[PartialD]",
           FontWeight->"Plain"], 
          StyleBox["\[CapitalPhi]",
           FontWeight->"Bold"]}], 
         RowBox[{"\[PartialD]", "r"}]], ")"}], "R"], "-", 
      StyleBox[
       RowBox[{"G", " ", "\[CapitalPhi]"}],
       FontWeight->"Bold"]}], ")"}], 
    StyleBox["b",
     FontWeight->"Bold"]}], "=", "0"}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.703350191693865*^9, 3.703350202351116*^9}, {
  3.703350915180903*^9, 3.703350944740131*^9}}],

Cell["and require:", "Text",
 CellChangeTimes->{{3.703350949635083*^9, 3.703350951532918*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "|", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          StyleBox["\[PartialD]",
           FontWeight->"Plain"], 
          StyleBox["\[CapitalPhi]",
           FontWeight->"Bold"]}], 
         RowBox[{"\[PartialD]", "r"}]], ")"}], "R"], "-", 
      StyleBox[
       RowBox[{"G", " ", "\[CapitalPhi]"}],
       FontWeight->"Bold"]}], ")"}], "|"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703350956604969*^9, 3.703350959692622*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["f", "o"], 
        RowBox[{"-", 
         SubscriptBox["g", "o"]}], "0", "0", "0", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "11", "I"]}], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "12", "I"]}], "...", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", 
          RowBox[{"1", "N"}], "I"]}]},
       {
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["f", "o"]}], 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["g", "o"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], "0", "0", "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "11", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "12", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], "...", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", 
            RowBox[{"1", "N"}], "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}]},
       {"0", "0", 
        SubscriptBox["g", "2"], "0", "0", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "21", "I"]}], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "22", "I"]}], "...", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", 
          RowBox[{"2", "N"}], "I"]}]},
       {"0", "0", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["g", "2"]}], 
         RowBox[{"\[PartialD]", "r"}]], "0", "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "21", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "22", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], "...", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", 
            RowBox[{"2", "N"}], "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}]},
       {"0", "0", "0", "\[DescendingEllipsis]", "\[VerticalEllipsis]", 
        "\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[DescendingEllipsis]",
         "\[VerticalEllipsis]"},
       {"0", "0", "0", "0", 
        SubscriptBox["g", "N"], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "N1", "I"]}], 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "N2", "I"]}], "...", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Psi]", "NN", "I"]}]},
       {"0", "0", "0", "0", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["g", "N"]}], 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "N1", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["\[Psi]", "N2", "I"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], "...", 
        RowBox[{"-", 
