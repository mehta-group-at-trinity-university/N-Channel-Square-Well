        RowBox[{
         FractionBox["1", "2"], "+", "L"}], ",", "\[Kappa]"}], "]"}], 
      "2"]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.703197083519793*^9, 3.7031971066865263`*^9}, 
