     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "+", "L"}], ",", "\[Kappa]"}], "]"}]}], "-", 
    RowBox[{"\[Kappa]", " ", 
     SuperscriptBox[
