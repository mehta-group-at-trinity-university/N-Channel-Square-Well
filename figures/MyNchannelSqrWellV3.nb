            RowBox[{"[", 
             RowBox[{"ichan", ",", "i", ",", "1"}], "]"}], "]"}]}], ";", 
          RowBox[{"rn", "+=", "1"}], ";"}]}], "]"}], ",", 
       RowBox[{"{", 
