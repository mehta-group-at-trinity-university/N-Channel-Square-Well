Notebook[{

Cell[CellGroupData[{
Cell["N-Channel Square Well Model", "Title",
 CellChangeTimes->{{3.702919793102016*^9, 3.702919845674234*^9}}],

Cell["NPM", "Author",
 CellChangeTimes->{{3.702919850496758*^9, 3.7029198507380953`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[CellGroupData[{

Cell["Setup", "Section",
 CellChangeTimes->{{3.702919873804351*^9, 3.702919876052968*^9}}],

Cell["\<\
For background, see the \[OpenCurlyDoubleQuote]CoupledSqrWellV4.nb and *V5.nb\
\[CloseCurlyDoubleQuote] files as well as the original version of this file.  \
Here, I will set up a streamlined version of the code. \
\>", "Text",
 CellChangeTimes->{{3.7029198774354067`*^9, 3.7029199524579887`*^9}, {
  3.703415875864842*^9, 3.703415886184757*^9}}],

Cell["At the two-channel level, we have:", "Text",
 CellChangeTimes->{{3.7034175959033823`*^9, 3.703417603192461*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "1"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}], 
        SubscriptBox["V", "12"]},
       {
        SubscriptBox["V", "12"], 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "2"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "1"]}]},
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "2"]}]}
      }], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["\[Psi]", "1"]},
       {
        SubscriptBox["\[Psi]", "2"]}
      }], ")"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693700116402718*^9, 3.693700163701606*^9}, {
  3.702321514647252*^9, 3.702321519069659*^9}}],

Cell["Choose:", "Text",
 CellChangeTimes->{{3.6915361976816*^9, 3.691536199854644*^9}, 
   3.691536252013687*^9}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "1"], "(", "r", ")"}], "=", 
   RowBox[{"{", 
    RowBox[{GridBox[{
       {
        RowBox[{"-", 
         SubscriptBox["D", "1"]}]},
       {
        RowBox[{"0", "        "}]}
      }], GridBox[{
       {
        RowBox[{" ", 
         RowBox[{
          RowBox[{"for", "  ", "r"}], "<", 
          SubscriptBox["r", "0"]}]}]},
       {
        RowBox[{
         RowBox[{"for", " ", "r"}], ">", 
         SubscriptBox["r", "0"]}]}
      }]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691327061910161*^9, 3.691327172222246*^9}, {
  3.691327206479426*^9, 3.6913272731370497`*^9}, {3.691536213527432*^9, 
  3.691536229326687*^9}, {3.691536356091206*^9, 3.691536356843114*^9}, {
  3.7034176939247017`*^9, 3.7034176940832033`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "2"], "(", "r", ")"}], "=", 
   RowBox[{"{", 
    RowBox[{GridBox[{
       {
        RowBox[{
         SubsuperscriptBox["E", "2", "th"], "-", 
         SubscriptBox["D", "2"]}]},
       {
        RowBox[{
         SubsuperscriptBox["E", "2", "th"], "     "}]}
      }], GridBox[{
       {
        RowBox[{" ", 
         RowBox[{
          RowBox[{"for", "  ", "r"}], "<", 
          SubscriptBox["r", "0"]}]}]},
       {
        RowBox[{
         RowBox[{"for", " ", "r"}], ">", 
         SubscriptBox["r", "0"]}]}
      }]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691327269449114*^9, 3.691327295240769*^9}, {
  3.691499202992983*^9, 3.6914992084804487`*^9}, {3.6915362215445433`*^9, 
  3.69153623349442*^9}, {3.69153630666321*^9, 3.6915363078383493`*^9}, {
  3.703417696957048*^9, 3.703417697107031*^9}}],

Cell[TextData[{
 "We wish to measure length in units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", and energy in units of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]]],
 ", so we multiply through by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["r", "0", "2"], TraditionalForm]]],
 ", and redefine ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", " ", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.691499293219922*^9, 3.691499428237627*^9}, {
  3.6936581276542873`*^9, 3.69365814786091*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            FractionBox[
             SuperscriptBox["\[PartialD]", "2"], 
             RowBox[{"\[PartialD]", 
              SuperscriptBox["r", "2"]}]], 
            RowBox[{"+", 
             FractionBox[
              RowBox[{"2", "\[Mu]", " ", 
               SuperscriptBox[
                SubscriptBox["r", "0"], "2"]}], 
              SuperscriptBox["\[HBar]", "2"]]}]}]}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SubscriptBox["D", "1"]}], "-", "E"}], ")"}]}], "+", 
         FractionBox[
          RowBox[{"L", "(", 
           RowBox[{"L", "+", "1"}], ")"}], 
          RowBox[{" ", 
           SuperscriptBox["r", "2"]}]]}], 
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[Mu]", " ", 
           SubsuperscriptBox["r", "0", "2"]}], 
          SuperscriptBox["\[HBar]", "2"]], 
         SubscriptBox["V", "12"]}]},
       {
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[Mu]", " ", 
           SubsuperscriptBox["r", "0", "2"]}], 
          SuperscriptBox["\[HBar]", "2"]], 
         RowBox[{
          SubscriptBox["V", "12"], "\[Conjugate]"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            FractionBox[
             SuperscriptBox["\[PartialD]", "2"], 
             RowBox[{"\[PartialD]", 
              SuperscriptBox["r", "2"]}]], 
            RowBox[{"+", 
             FractionBox[
              RowBox[{"2", "\[Mu]", " ", 
               SubsuperscriptBox["r", "0", "2"]}], 
              SuperscriptBox["\[HBar]", "2"]]}]}]}], 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox["E", "2", "th"], "-", 
            SubscriptBox["D", "2"], "-", "E"}], ")"}]}], "-", 
         FractionBox[
          RowBox[{"L", "(", 
           RowBox[{"L", "+", "1"}], ")"}], 
          RowBox[{" ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Psi]", "1", "I"]},
       {
        SubsuperscriptBox["\[Psi]", "2", "I"]}
      }], ")"}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.691499360525436*^9, {3.691499433074664*^9, 3.691499485090193*^9}, {
   3.691499529849058*^9, 3.6914995565878277`*^9}, {3.691499690233552*^9, 
   3.69149969215121*^9}, {3.691515878871798*^9, 3.691515882879077*^9}, {
