Cell[TextData[{
 "Neat!  This looks like it could be a possible avenue for placing a large \
density of states at the collision threshold.  So what potential depths \
correspond to energies at the collision threshold?  The depths are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "i"], "+", 
    RowBox[{
     SubscriptBox["\[Epsilon]", "th"], "(", "i", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", and we need a binding of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "th"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", so search for energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[Epsilon]", "th"], "(", "i", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"]
}], "Text",
 CellChangeTimes->{{3.7037207093881702`*^9, 3.7037208526942177`*^9}, {
  3.703720951626439*^9, 3.703720974255426*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"TEQ0", "/.", 
     RowBox[{"\[Epsilon]", "\[Rule]", 
      RowBox[{"-", 
       RowBox[{"\[Epsilon]th", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"v0", ",", "0", ",", "2000.0"}], "}"}]}], "]"}], ";"}]], "Input",\

