   3.693658160871279*^9, 3.69365817750686*^9}, {3.693700370187428*^9, 
   3.693700379430481*^9}, {3.702321600606456*^9, 3.702321606573082*^9}, {
   3.7034176519813433`*^9, 3.703417703571127*^9}, {3.7034177337963533`*^9, 
   3.703417748621607*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             FractionBox[
              SuperscriptBox["\[PartialD]", "2"], 
              RowBox[{"\[PartialD]", 
               SuperscriptBox["r", "2"]}]], 
             RowBox[{"-", 
              FractionBox[
               RowBox[{"2", "\[Mu]", " ", 
                SuperscriptBox[
                 SubscriptBox["r", "0"], "2"]}], 
               SuperscriptBox["\[HBar]", "2"]]}]}]}], "E"}], "+", 
          FractionBox[
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}], 
           RowBox[{" ", 
            SuperscriptBox["r", "2"]}]]}], "0"},
        {"0", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             FractionBox[
              SuperscriptBox["\[PartialD]", "2"], 
              RowBox[{"\[PartialD]", 
               SuperscriptBox["r", "2"]}]], 
             RowBox[{"-", 
              FractionBox[
               RowBox[{"2", "\[Mu]", " ", 
                SubsuperscriptBox["r", "0", "2"]}], 
               SuperscriptBox["\[HBar]", "2"]]}]}]}], "E"}], "-", 
          FractionBox[
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}], 
           RowBox[{" ", 
            SuperscriptBox["r", "2"]}]]}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubsuperscriptBox["\[Psi]", "1", "I"]},
        {
         SubsuperscriptBox["\[Psi]", "2", "I"]}
       }], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[Mu]", " ", 
       SuperscriptBox[
        SubscriptBox["r", "0"], "2"]}], 
      SuperscriptBox["\[HBar]", "2"]], 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"-", 
          SubscriptBox["D", "1"]}], 
         SubscriptBox["V", "12"]},
        {
         RowBox[{
          SubscriptBox["V", "12"], "\[Conjugate]"}], 
         RowBox[{
          SubsuperscriptBox["E", "2", "th"], "-", 
          SubscriptBox["D", "2"]}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubsuperscriptBox["\[Psi]", "1", "I"]},
        {
         SubsuperscriptBox["\[Psi]", "2", "I"]}
       }], ")"}]}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7034178267809067`*^9, 3.7034179270384073`*^9}, 
   3.70341836014399*^9}],

Cell[TextData[{
 "Now rescale all energies to be in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[HBar]", "2"], "/", "2"}], "\[Mu]", " ", 
    SubsuperscriptBox["r", "0", "2"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  (effectively setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[HBar]", "2"], "/", "2"}], "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}], "\[Rule]", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " "
}], "Text",
 CellChangeTimes->{{3.70341800458741*^9, 3.703418063050968*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            FractionBox[
             SuperscriptBox["\[PartialD]", "2"], 
             RowBox[{"\[PartialD]", 
              SuperscriptBox["r", "2"]}]], 
            RowBox[{"-", "E"}]}]}], "+", 
          FractionBox[
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}], 
           RowBox[{" ", 
            SuperscriptBox["r", "2"]}]]}], "0"},
        {"0", 
         RowBox[{
          RowBox[{"-", 
