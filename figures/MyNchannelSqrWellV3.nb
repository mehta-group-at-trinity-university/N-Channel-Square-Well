Cell[CellGroupData[{

Cell["\<\
Test the position of the resonances using the open-closed couplings\
\>", "Subsection",
 CellChangeTimes->{{3.703622935067129*^9, 3.703622947401243*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NCHAN", "=", "20"}], ";", 
  RowBox[{"D0", "=", "2000.0"}], ";", 
  RowBox[{"\[Epsilon]1", "=", "500.0"}], ";", 
  RowBox[{"\[Gamma]", "=", "10.0"}], ";", 
  RowBox[{"NumOpen", "=", "1"}], ";", 
  RowBox[{"L", "=", "0"}], ";", 
  RowBox[{"rmatch", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", "V"}], 
    "}"}], "=", 
   RowBox[{"SetupPotentialOpenClosed", "[", 
    RowBox[{"NCHAN", ",", "D0", ",", "\[Epsilon]1", ",", "\[Gamma]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataArray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"RunEnergyLoop", "[", 
        RowBox[{
        "NCHAN", ",", "NumOpen", ",", "L", ",", "rmatch", ",", 
         "\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", 
         "\[Epsilon]"}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", "0.0001", ",", 
       RowBox[{"\[Epsilon]th", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Epsilon]th", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "10000.0"}]}], "}"}]}], "]"}]}],
   ";"}]}], "Input",
 CellChangeTimes->{
  3.703622928006283*^9, {3.703622975922329*^9, 3.70362304581527*^9}, {
   3.7036231401643744`*^9, 3.7036231840172453`*^9}, 3.703623225615808*^9, {
