         "\[Epsilon]"}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
