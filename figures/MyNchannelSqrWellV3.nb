Cell["\<\
Let\[CloseCurlyQuote]s try it again, this time placing a large density of \
states near threshold.\
\>", "Text",
 CellChangeTimes->{{3.70372154818356*^9, 3.703721563193612*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NCHAN", "=", "25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]1", "=", "500.0"}], ";", 
  RowBox[{"\[Gamma]", "=", "1.0"}], ";", 
  RowBox[{"NumOpen", "=", "1"}], ";", 
  RowBox[{"L", "=", "0"}], ";", 
  RowBox[{"rmatch", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TotalDepthofClosedChannel", "=", 
   RowBox[{"v0", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"TEQ0", "/.", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", "\[Rule]", 
         RowBox[{"-", "\[Epsilon]1"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"v0", ",", "2000.0"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", "V"}], 
    "}"}], "=", 
   RowBox[{"SetupPotentialOpenClosed", "[", 
    RowBox[{"NCHAN", ",", 
     RowBox[{"TotalDepthofClosedChannel", "-", "\[Epsilon]1"}], ",", 
     "\[Epsilon]1", ",", "\[Gamma]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataArray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"RunEnergyLoop", "[", 
