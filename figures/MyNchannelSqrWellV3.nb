         SuperscriptBox[
          RowBox[{"sols", "[", 
           RowBox[{"[", "SizeAB", "]"}], "]"}], "2"]}]]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Delta]", "=", 
      RowBox[{"ArcTan", "[", "tandel", "]"}]}], ";", "\[IndentingNewLine]", 
