   3.702317988373712*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", "x", ")"}], " ", "~", " ", 
   RowBox[{
    SqrtBox["x"], "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "L"], 
      RowBox[{
       SubscriptBox["J", 
        RowBox[{"L", "+", 
         RowBox[{"1", "/", "2"}]}]], "(", "x", ")"}]}], "+", 
     RowBox[{
      SubscriptBox["B", "L"], 
      RowBox[{
       SubscriptBox["Y", 
        RowBox[{"L", "+", 
         RowBox[{"1", "/", "2"}]}]], "(", "x", ")"}]}]}], "]"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702318019803307*^9, 3.702318082159*^9}}],

Cell[TextData[{
 "The fundamental unit of length is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", the unit of energy is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]]],
 ". "
}], "Text",
 CellChangeTimes->{{3.693248653482848*^9, 3.693248683220747*^9}}],

Cell["Then inside,", "Text",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.6932480277736673`*^9}, {
  3.693248109225417*^9, 3.6932481100556517`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "in"], "(", "r", ")"}], "=", " ", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], 
