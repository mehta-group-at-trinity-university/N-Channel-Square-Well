      RowBox[{"{", 
       RowBox[{
       "\"\<E/(\!\(\*SuperscriptBox[\(\[HBar]\), \
\(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\"", ",", 
        "\"\<\!\(\*SuperscriptBox[\(sin\), \(2\)]\)(\!\(\*SubscriptBox[\(\
\[Delta]\), \(0\)]\))\>\""}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.703713039353264*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TEQ0", "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
     RowBox[{"Cos", "[", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}], "+", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", "\[Epsilon]"}]], " ", 
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Depths", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]th", "[", 
       RowBox[{"[", "ichan", "]"}], "]"}], "-", 
      RowBox[{"V", "[", 
       RowBox[{"[", 
        RowBox[{"ichan", ",", "ichan"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ichan", ",", "1", ",", 
       RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NumSearch", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"egrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"e", ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", 
         RowBox[{"-", 
          RowBox[{"Depths", "[", 
           RowBox[{"[", "ichan", "]"}], "]"}]}], ",", 
         RowBox[{"-", "0.0001"}], ",", 
         RowBox[{
          RowBox[{"Depths", "[", 
           RowBox[{"[", "ichan", "]"}], "]"}], "/", "NumSearch"}]}], "}"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ichan", ",", "1", ",", 
       RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bgrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"egrid", "[", 
          RowBox[{"[", 
           RowBox[{"ichan", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"TEQ0", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Epsilon]", "\[Rule]", 
             RowBox[{"egrid", "[", 
              RowBox[{"[", 
               RowBox[{"ichan", ",", "i"}], "]"}], "]"}]}], ",", 
            RowBox[{"v0", "\[Rule]", 
             RowBox[{"Depths", "[", 
              RowBox[{"[", "ichan", "]"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "NumSearch"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ichan", ",", "1", ",", 
       RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", "50"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ichan", ",", "1", ",", 
       RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"rn", "=", "1"}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Bgrid", "[", 
            RowBox[{"[", 
             RowBox[{"ichan", ",", "i", ",", "2"}], "]"}], "]"}], 
           RowBox[{"Bgrid", "[", 
            RowBox[{"[", 
             RowBox[{"ichan", ",", 
              RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}]}], "<", "0"}],
          ",", 
         RowBox[{
          RowBox[{
           RowBox[{"rootguess", "[", 
            RowBox[{"[", 
             RowBox[{"ichan", ",", "rn"}], "]"}], "]"}], "=", 
           RowBox[{"Bgrid", "[", 
            RowBox[{"[", 
             RowBox[{"ichan", ",", "i", ",", "1"}], "]"}], "]"}]}], ";", 
          RowBox[{"rn", "+=", "1"}], ";"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "NumSearch"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ichan", ",", "1", ",", 
      RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"rootguess", "[", 
      RowBox[{"[", "ichan", "]"}], "]"}], "=", 
     RowBox[{"rootguess", "[", 
      RowBox[{"[", 
       RowBox[{"ichan", ",", 
        RowBox[{"1", ";;", 
         RowBox[{"rn", "-", "1"}]}]}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ichan", ",", "1", ",", 
      RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"roots", "=", "rootguess"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"roots", "[", 
        RowBox[{"[", 
         RowBox[{"ichan", ",", "i"}], "]"}], "]"}], "=", 
       RowBox[{"\[Epsilon]", "/.", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TEQ0", "\[Equal]", "0"}], "/.", 
           RowBox[{"v0", "\[Rule]", 
            RowBox[{"Depths", "[", 
             RowBox[{"[", "ichan", "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", 
            RowBox[{"rootguess", "[", 
             RowBox[{"[", 
              RowBox[{"ichan", ",", "i"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"rn", "-", "1"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"ichan", ",", "1", ",", 
      RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"poles", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"roots", "[", 
             RowBox[{"[", 
              RowBox[{"ichan", ",", "i"}], "]"}], "]"}], "+", 
            RowBox[{"\[Epsilon]th", "[", 
             RowBox[{"[", "ichan", "]"}], "]"}]}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"roots", "[", 
             RowBox[{"[", 
              RowBox[{"ichan", ",", "i"}], "]"}], "]"}], "+", 
            RowBox[{"\[Epsilon]th", "[", 
             RowBox[{"[", "ichan", "]"}], "]"}]}], ",", "1.2"}], "}"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"rn", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ichan", ",", "1", ",", 
       RowBox[{"NCHAN", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
