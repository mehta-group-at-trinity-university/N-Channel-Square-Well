   3.703712415317358*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dgb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"gb", "[", 
       RowBox[{"L", ",", "\[Kappa]", ",", "r"}], "]"}], ",", "r"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.702922808221755*^9, 3.7029228357083073`*^9}, {
  3.7034312333786993`*^9, 3.703431248225692*^9}, {3.703433631655361*^9, 
  3.703433642758718*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fb", "[", 
