Cell["\<\
Cool!  A high density of states right at threshold, for a fraction of the \
cost.  What happens when we crank up the coupling?\
\>", "Text",
 CellChangeTimes->{{3.7037839863848877`*^9, 3.703784019742737*^9}, {
  3.7038069183185797`*^9, 3.703806921298956*^9}}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{3.703721528001048*^9}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1-channel square well", "Section",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137821837714*^9}}],

Cell[TextData[{
 "As a preliminary to the multichannel case, we will need to solve the single \
channel case to understand where the bound states are with respect to the \
threshold.  This will help us interpret the two-channel resonances, at least \
in the weak coupling regime.  Inside the well of range ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", the radial wavefunction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "r", ")"}], TraditionalForm]]],
 " satisfies:"
}], "Text",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137929269053*^9}, {
  3.692282786010167*^9, 3.692282798297591*^9}, {3.693247648593514*^9, 
  3.693247653543399*^9}, {3.702314561705797*^9, 3.702314570270965*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["\[HBar]", "2"]}], 
        RowBox[{"2", "\[Mu]"}]], 
       FractionBox["1", 
        SuperscriptBox["r", "2"]], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        SuperscriptBox["r", "2"]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["V", "0"]}], "-", "E"}], ")"}]}]}]}], "+", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], " ", 
    RowBox[{"R", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702314610632531*^9, 3.702314657920128*^9}}],

Cell[TextData[{
 "We let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "(", "r", ")"}], "=", 
    RowBox[{"r", " ", 
     RowBox[{"R", "(", "r", ")"}]}]}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["\[HBar]", "2"]}], 
        RowBox[{"2", "\[Mu]"}]], 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["V", "0"]}], "-", "E"}], ")"}]}]}]}], "+", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702314672989156*^9, 3.702314698629549*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "+", 
         SubscriptBox["V", "0"]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], " ", 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692137942615315*^9, 3.692138038069057*^9}, {
  3.693699217056481*^9, 3.69369923706916*^9}, {3.7023145518842688`*^9, 
  3.702314554166671*^9}, {3.702314710983982*^9, 3.702314723718965*^9}}],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], "E"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], 
      SubscriptBox["V", "0"]}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 ".  Also RESCALE ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]]],
 ".  Then"
}], "Text",
 CellChangeTimes->{{3.692282700363286*^9, 3.692282744588562*^9}, {
  3.693248576840211*^9, 3.693248624217347*^9}, {3.693698939880719*^9, 
  3.693698951485581*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{"+", "\[Epsilon]"}]}], "+", 
      SubscriptBox["v", "0"], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69228274835502*^9, 3.69228275862792*^9}, {
   3.693698955472597*^9, 3.693698958976012*^9}, 3.693699242712319*^9, 
   3.702315539556018*^9, {3.702315582401114*^9, 3.702315587791356*^9}, {
   3.702317880988694*^9, 3.702317881006218*^9}}],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", "0"}], TraditionalForm]]],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     SqrtBox["\[Epsilon]"], "r"}]}], TraditionalForm]]],
 " the solutions are:"
}], "Text",
 CellChangeTimes->{{3.702317888546028*^9, 3.70231789939146*^9}, {
  3.7023179781035433`*^9, 3.70231800889008*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "x", "]"}], "+", 
     RowBox[{"1", 
      RowBox[{"\[Psi]", "[", "x", "]"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"L", 
        RowBox[{"(", 
         RowBox[{"L", "+", "1"}], ")"}]}], 
       SuperscriptBox["x", "2"]], 
      RowBox[{"\[Psi]", "[", "x", "]"}]}]}], "\[Equal]", "0"}], ",", "\[Psi]",
    ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.702317860904858*^9, 3.702317872427493*^9}, {
  3.702317921075645*^9, 3.702317958544478*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[Psi]", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", 
      RowBox[{
       RowBox[{
        SqrtBox["x"], " ", 
        RowBox[{"BesselJ", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "L"}]}], ")"}]}], ",", "x"}], "]"}], " ", 
        RowBox[{"C", "[", "1", "]"}]}], "+", 
       RowBox[{
        SqrtBox["x"], " ", 
        RowBox[{"BesselY", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "L"}]}], ")"}]}], ",", "x"}], "]"}], " ", 
        RowBox[{"C", "[", "2", "]"}]}]}]}], "]"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.702317959048237*^9}]
}, Open  ]],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "2"]}]], 
       RowBox[{"+", "1"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["x", "2"]}]]}], ")"}], "\[Psi]"}], "=", "0"}], 
