Cell[TextData[{
 "Units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "C"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ":"
}], "Text",
 CellChangeTimes->{{3.7459660583982973`*^9, 3.745966066971446*^9}, {
  3.745966904134386*^9, 3.745966911459903*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{"f", " ", "g", 
     RowBox[{"\[DifferentialD]", "r"}]}]}], "  ", "\[Proportional]", 
   RowBox[{
    RowBox[{"\[Delta]", "(", 
     RowBox[{"k", "-", 
      RowBox[{"k", "'"}]}], ")"}], "~", " ", 
    FractionBox["1", "k"], "~", 
    FractionBox["1", 
     SqrtBox[
      FractionBox[
       RowBox[{"2", "\[Mu]", " ", 
        SubscriptBox["\[Epsilon]", "0"]}], 
       SuperscriptBox["\[HBar]", "2"]]]], "~", 
    FractionBox["1", 
     SqrtBox[
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[Mu]", " "}], 
        SuperscriptBox["\[HBar]", "2"]], 
       FractionBox[
        SuperscriptBox["\[HBar]", "2"], 
        RowBox[{"2", "\[Mu]", " ", 
         SubsuperscriptBox["r", "0", "2"]}]]}]]], "~", 
    SubscriptBox["r", "0"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.74596607362132*^9, 3.7459661420462427`*^9}, {
  3.7459670604786243`*^9, 3.745967060482546*^9}, {3.745967619791318*^9, 
  3.745967695798356*^9}, {3.745967762482019*^9, 3.745967895773279*^9}}],

Cell["Okay,", "Text",
 CellChangeTimes->{{3.745967071431368*^9, 3.745967084498741*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"(", "i", ")"}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"4", "\[HBar]"}], 
      RowBox[{"\[Tau]", "(", 
       SuperscriptBox["E", 
        RowBox[{"(", "i", ")"}]], ")"}]], " ", "\[Rule]", " ", 
     RowBox[{"\[Tau]", "(", 
      SuperscriptBox["E", 
       RowBox[{"(", "i", ")"}]], ")"}]}], "=", 
    FractionBox[
     RowBox[{"4", "\[HBar]"}], 
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{"(", "i", ")"}]]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.745967171341592*^9, 3.745967193845023*^9}, {
  3.745968126165526*^9, 3.7459681437018003`*^9}}],

Cell["We found numerically that:", "Text",
 CellChangeTimes->{{3.7459671957164993`*^9, 3.745967203762587*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Z", "C"], "=", 
   FractionBox["2", 
    RowBox[{
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{"(", "i", ")"}]], "/", 
     SqrtBox[
      SuperscriptBox["E", 
       RowBox[{"(", "i", ")"}]]]}]]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.745967246918468*^9, 3.745967285159561*^9}}],

Cell[TextData[{
 "The right hand side should have units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      SubscriptBox["\[Epsilon]", "0"]]], "=", 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{"2", "\[Mu]", " ", 
        SubsuperscriptBox["r", "0", "2"]}], 
       SuperscriptBox["\[HBar]", "2"]]], "=", 
     RowBox[{
      SqrtBox[
       RowBox[{"2", "\[Mu]", " "}]], 
      FractionBox[
       SubscriptBox["r", "0"], "\[HBar]"]}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " while the left hand side should have units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  Therefore I propose the relation is:"
}], "Text",
 CellChangeTimes->{{3.7459673079268084`*^9, 3.7459673892710533`*^9}, {
  3.745967506161409*^9, 3.745967525870699*^9}, {3.745967939214678*^9, 
  3.745967986198318*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Z", "C"], "=", 
   FractionBox[
    RowBox[{"2", "\[HBar]"}], 
    RowBox[{
     SqrtBox[
      RowBox[{"2", "\[Mu]", " "}]], 
     RowBox[{
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "i", ")"}]], "/", 
      SqrtBox[
       SuperscriptBox["E", 
        RowBox[{"(", "i", ")"}]]]}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.745967987688588*^9, 3.745968014430155*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["Z", "C"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "\[HBar]", " ", 
      SqrtBox[
       SuperscriptBox["E", 
        RowBox[{"(", "i", ")"}]]]}], 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"2", "\[Mu]", " "}]], 
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "i", ")"}]]}]], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       SuperscriptBox["E", 
        RowBox[{"(", "i", ")"}]], ")"}], 
      SqrtBox[
       SuperscriptBox["E", 
        RowBox[{"(", "i", ")"}]]]}], 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"2", "\[Mu]", " "}]]}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.745968070733926*^9, 3.745968111454256*^9}, {
  3.745968151285411*^9, 3.745968153348755*^9}}],

Cell["so that now the right hand side also has units of length.", "Text",
 CellChangeTimes->{{3.745968047776228*^9, 3.74596805728327*^9}}],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "E", ")"}], 
    SqrtBox["E"]}], 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{"2", "\[Mu]", " "}]]}]], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.745968319975968*^9, 3.745968326590077*^9}}],

Cell[BoxData[""], "Input"],

Cell["", "Text",
 CellChangeTimes->{{3.7459672719538097`*^9, 3.745967274159629*^9}}],

