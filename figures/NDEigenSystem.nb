Cell[CellGroupData[{

Cell["3D Oscillator states", "Subtitle",
 CellChangeTimes->{{3.8040894224166527`*^9, 
  3.8040894264745617`*^9}},ExpressionUUID->"f6edeea7-d0d5-425f-9e97-\
207593a4ecfc"],

Cell[TextData[{
 "Specify a ",
 "Schr\[ODoubleDot]dinger",
 " operator with parameter ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]], "InlineMath",ExpressionUUID->
  "5b879f95-3f30-4f1a-a89a-a93c9f610767"],
 " and potential ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]], "InlineMath",ExpressionUUID->
  "125f1fa9-644e-4693-8041-92d7a871bcdf"],
 ":"
}], "ExampleText",
 CellID->141863318,ExpressionUUID->"df473101-2d6c-4e28-86db-4facbb4bb344"],

Cell[BoxData[
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_", ",", "kxy_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"], "+", 
      SuperscriptBox["z", "2"]}], ")"}]}], "+", 
   RowBox[{"kxy", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], " ", 
       SuperscriptBox["y", "2"]}], "+", 
      RowBox[{".5", 
       SuperscriptBox["x", "2"], " ", 
       SuperscriptBox["z", "2"]}], " ", "+", 
      RowBox[{".25", " ", 
       SuperscriptBox["y", "2"], " ", 
       SuperscriptBox["z", "2"]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.758890029060527*^9, 3.758890079193564*^9}, 
   3.758890297831205*^9, {3.804089182809661*^9, 3.804089209339796*^9}, {
   3.80408925983727*^9, 3.804089384822945*^9}, {3.804089941063932*^9, 
   3.8040899662475843`*^9}, {3.804090065006564*^9, 3.8040900778937073`*^9}, {
