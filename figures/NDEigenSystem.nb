Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{"0.25", "\[Pi]"}]}], ";", 
  RowBox[{"RotatedCont", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
      RowBox[{"I", " ", "r", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "2", ",", ".1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.789254470475505*^9, {3.7892564761800632`*^9, 3.7892565649267273`*^9}, {
