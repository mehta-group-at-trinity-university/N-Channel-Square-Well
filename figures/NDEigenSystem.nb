Cell[BoxData[
 RowBox[{
  RowBox[{"W", "[", 
   RowBox[{"x_", ",", "xc_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"x", "<", "xc"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "xc"}], ")"}], "2"], ",", 
       RowBox[{"x", "\[GreaterEqual]", "xc"}]}], "}"}]}], "}"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.788630246240197*^9, 3.788630300497199*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"c842379d-980b-44c4-85f8-84a4357ff09e"],

