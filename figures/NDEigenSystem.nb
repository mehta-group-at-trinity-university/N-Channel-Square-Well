Cell[BoxData[
 RowBox[{
  RowBox[{"TestNDEigErrors", "[", 
   RowBox[{"eps_", ",", "xmax_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vals", ",", "funs"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", ",", "funs"}], "}"}], "=", 
      RowBox[{"NDEigensystem", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"-", "1"}], "2"], 
           RowBox[{"Laplacian", "[", 
            RowBox[{
             RowBox[{"u", "[", "x", "]"}], ",", 
             RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"], 
           RowBox[{"u", "[", "x", "]"}]}]}], "}"}], ",", "u", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "xmax"}], ",", "xmax"}], "}"}], ",", "4", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "eps"}], "}"}]}],
