Cell[BoxData[{
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"], "+", 
     SuperscriptBox["z", "2"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], "2"], 
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], "*", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.758890029060527*^9, 3.758890079193564*^9}, 
   3.758890297831205*^9, {3.804089182809661*^9, 3.804089209339796*^9}, {
   3.80408925983727*^9, 3.804089384822945*^9}},
 CellLabel->"In[1]:=",
 CellID->2025942646,ExpressionUUID->"c5e11b81-4982-40ea-bed9-a74b11645c77"],

Cell["\<\
\[LineSeparator]Find the 10 smallest eigenvalues and eigenfunctions on a \
refined mesh:\
\>", "ExampleText",
 CellChangeTimes->{{3.758898289861843*^9, 3.758898302146721*^9}, 
   3.804089167250441*^9},
 CellID->1664828137,ExpressionUUID->"51c440a2-bfcd-4859-9ce3-aec820b55058"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"vals", ",", "funs"}], "}"}], "=", 
  RowBox[{"NDEigensystem", "[", 
   RowBox[{"\[ScriptCapitalL]", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", "10", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<FiniteElement\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"MaxCellMeasure", "\[Rule]", "0.1"}], "}"}]}], "}"}]}], 
        "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7588900670262127`*^9, 3.758890068826151*^9}, 
   3.80408917275838*^9, {3.804089326581066*^9, 3.804089337180328*^9}, {
