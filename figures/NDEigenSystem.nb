 CellID->414401295,ExpressionUUID->"4f515362-59d9-48f7-a432-97b08dcf60ad"],

Cell["\<\
\[LineSeparator]Find the 10 smallest eigenvalues and eigenfunctions on a \
refined mesh:\
\>", "ExampleText",
 CellChangeTimes->{{3.758898289861843*^9, 3.758898302146721*^9}, 
   3.804089167250441*^9},
 CellID->1056649693,ExpressionUUID->"76dcd8e5-ff4b-48f0-ac9d-411e3f439fd8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kvals", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "2", ",", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Asymevals", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", "1"}], "2"], 
         RowBox[{"Laplacian", "[", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "kxy"}], "]"}], "*", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], ",", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "10", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<FiniteElement\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"MaxCellMeasure", "\[Rule]", "0.1"}], "}"}]}], "}"}]}],
            "}"}]}], "}"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"kxy", ",", "kvals"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.7588900670262127`*^9, 3.758890068826151*^9}, 
