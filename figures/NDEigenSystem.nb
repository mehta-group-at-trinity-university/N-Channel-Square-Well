Cell[BoxData[
 RowBox[{
  RowBox[{"CalcERE", "[", 
   RowBox[{
   "v0_", ",", "r0_", ",", "rmax_", ",", "ksqrMin_", ",", "ksqrMax_"}], "]"}],
   ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlocal", ",", "EREData", ",", "ascat", ",", "reff", ",", "A", ",", "B", 
      ",", "fitpars", ",", "dE"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dE", "=", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"ksqrMax", "-", "ksqrMin"}], ")"}], "10"]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vlocal", "=", "v0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"EREData", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ksqr", ",", 
          RowBox[{
           SqrtBox["ksqr"], 
           RowBox[{"CalcCotanDelta", "[", 
            RowBox[{"vlocal", ",", "r0", ",", "ksqr", ",", "rmax"}], 
            "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ksqr", ",", "ksqrMin", ",", "ksqrMax", ",", "dE"}], "}"}]}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fitpars", "=", 
      RowBox[{"FindFit", "[", 
       RowBox[{"EREData", ",", 
        RowBox[{"A", "+", 
         RowBox[{"B", " ", "ksqr"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "B"}], "}"}], ",", "ksqr"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ascat", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "A"], "/.", "fitpars"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"reff", "=", 
      RowBox[{
       RowBox[{"2", "B"}], "/.", "fitpars"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"ascat", ",", "reff"}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
