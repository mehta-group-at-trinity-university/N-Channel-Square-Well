 CellLabel->"In[24]:=",ExpressionUUID->"03914250-2b5e-457e-a114-4949ba45e1f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xmax", "=", "10"}], ";", 
  RowBox[{"xc", "=", "5"}], ";", 
  RowBox[{"\[Eta]", "=", ".05"}], ";", 
  RowBox[{"v0", "=", "7.5"}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "funcs"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", "1"}], "2"], 
         RowBox[{"Laplacian", "[", 
          RowBox[{
           RowBox[{"u", "[", "x", "]"}], ",", 
           RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"v0", " ", 
            SuperscriptBox["x", 
             RowBox[{"2", " "}]], 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "x"}], "]"}]}], "-", 
           RowBox[{"I", " ", "\[Eta]", " ", 
            RowBox[{"W", "[", 
             RowBox[{"x", ",", "xc"}], "]"}]}]}], ")"}], " ", 
         RowBox[{"u", "[", "x", "]"}]}]}], ",", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "\[Equal]", "0"}], ",", "True"}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"u", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "xmax"}], "}"}], ",", "50", ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<PDEDiscretization\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<FiniteElement\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.02"}], "}"}]}], 
           "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
