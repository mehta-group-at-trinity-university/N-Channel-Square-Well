Cell[BoxData[
 RowBox[{"NDEigensystem", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "2"], 
       RowBox[{"Laplacian", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", 
         RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["x", "2"], 
       RowBox[{"u", "[", "x", "]"}]}]}], ",", 
     RowBox[{"DirichletCondition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", "x", "]"}], "\[Equal]", "0"}], ",", "True"}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"u", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<FiniteElement\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.5"}], "}"}]}], 
