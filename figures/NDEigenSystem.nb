Cell[CellGroupData[{

Cell["Zero-range boundary conditions", "Section",
 CellChangeTimes->{{3.7027277015851088`*^9, 
  3.702727718998105*^9}},ExpressionUUID->"f4c4c840-2522-4b1c-8a01-\
1c9962470b6e"],

Cell["\<\
Let\[CloseCurlyQuote]s see if we can get the zero-range boundary condition \
using the \[OpenCurlyDoubleQuote]Robin boundary condition\
\[CloseCurlyDoubleQuote] imposed with the NeumannValue function.\
\>", "Text",
 CellChangeTimes->{{3.70272772091743*^9, 
  3.7027277600837603`*^9}},ExpressionUUID->"aa8e8a83-c77a-4606-91fe-\
02022964b2f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"vals", ",", "funs"}], "}"}], "=", 
  RowBox[{"NDEigensystem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Laplacian", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", 
         RowBox[{"{", "x", "}"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"10000", ",", 
            RowBox[{"x", ">", "10"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"x", "<", "10"}]}], "}"}]}], "}"}], "]"}], 
       RowBox[{"u", "[", "x", "]"}]}], "+", 
      RowBox[{"NeumannValue", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], 
         RowBox[{"u", "[", "x", "]"}]}], ",", 
        RowBox[{"x", "\[Equal]", "0"}]}], "]"}]}], "}"}], ",", "u", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "20"}], "}"}], ",", "5", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", "\"\<FEAST\>\"", "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.702732832100219*^9, 3.702732846602216*^9}, {
   3.702732975067874*^9, 3.70273309923463*^9}, {3.702733144499548*^9, 
