Cell[BoxData[
 RowBox[{
  RowBox[{"CalcCotanDelta", "[", 
   RowBox[{
    RowBox[{"v0_", "?", "NumberQ"}], ",", 
    RowBox[{"r0_", "?", "NumberQ"}], ",", 
    RowBox[{"ksqr_", "?", "NumberQ"}], ",", 
    RowBox[{"rmax_", "?", "NumberQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlocal", ",", "CotanDelta", ",", "sol", ",", "k", ",", "u1", ",", "u2", 
      ",", "r1", ",", "r2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"0.95", " ", "rmax"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"0.99", "rmax"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vlocal", "=", "v0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", "=", 
      SqrtBox["ksqr"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"u", "''"}], "[", "r", "]"}]}], "+", 
            RowBox[{"vlocal", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["r", "2"]}], "/", 
               SuperscriptBox["r0", "2"]}], "]"}], 
             RowBox[{"u", "[", "r", "]"}]}]}], "\[Equal]", 
           RowBox[{"ksqr", " ", 
            RowBox[{"u", "[", "r", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "'"}], "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], 
        ",", "u", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "rmax"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u1", "=", 
      RowBox[{
       RowBox[{"u", "[", "r1", "]"}], "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u2", "=", 
      RowBox[{
       RowBox[{"u", "[", "r2", "]"}], "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"CotanDelta", "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "u2"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", " ", "r1"}], "]"}]}], "+", 
        RowBox[{"u1", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", " ", "r2"}], "]"}]}]}], 
       RowBox[{
        RowBox[{"u2", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "r1"}], "]"}]}], "-", 
        RowBox[{"u1", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "r2"}], "]"}]}]}]]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Return", "[", "CotanDelta", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.631057498729328*^9, 3.63105752460035*^9}, {
  3.631057562752059*^9, 3.631057647753542*^9}, {3.6310576821944313`*^9, 
