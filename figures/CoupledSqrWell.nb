   RowBox[{
    SubscriptBox["r\[Psi]", "in"], "(", 
    RowBox[{"\[Beta]", " ", "r"}], ")"}], "=", " ", 
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["j", "l"], "(", 
     RowBox[{"\[Beta]", " ", "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
