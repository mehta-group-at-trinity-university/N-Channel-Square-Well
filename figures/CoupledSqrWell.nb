      SqrtBox["r"], 
      RowBox[{"BesselK", "[", 
       RowBox[{
        RowBox[{"L", "+", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"\[Kappa]", " ", "r"}]}], "]"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"L", 
        RowBox[{"(", 
         RowBox[{"L", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], 
      SqrtBox["r"], 
      RowBox[{"BesselK", "[", 
       RowBox[{
        RowBox[{"L", "+", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"\[Kappa]", " ", "r"}]}], "]"}]}]}], ")"}]}], "]"}]], "Input",\

