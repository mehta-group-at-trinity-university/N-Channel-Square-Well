         RowBox[{" ", 
          RowBox[{"EE", "+", "V0"}]}]]}], ",", 
       RowBox[{"k", "\[Rule]", 
        SqrtBox[
         RowBox[{" ", "EE"}]]}], ",", 
       RowBox[{"\[Kappa]", "\[Rule]", 
        SqrtBox[
         RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693248994419087*^9, 3.693249022960253*^9}, {
