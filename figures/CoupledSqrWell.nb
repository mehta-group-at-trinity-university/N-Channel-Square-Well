f86cc12c7026"],

Cell[TextData[{
 "Where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "L"], TraditionalForm]],ExpressionUUID->
  "de4dbc18-4d5a-4627-9f59-a2cef0672153"],
 " is the partial wave K-matrix element.  Require:"
}], "Text",
 CellChangeTimes->{{3.691596389061142*^9, 3.69159639148116*^9}, {
  3.69193815121591*^9, 3.691938168052532*^9}, {3.692015518092482*^9, 
