  3.692015430372551*^9}},ExpressionUUID->"c0381f5c-45e5-44e4-ba1e-\
fab747dc8784"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "\[Rho]", " ", 
      RowBox[{"SphericalBesselJ", "[", " ", 
       RowBox[{"L", ",", 
        RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}], ",", 
     RowBox[{"k", " ", "\[Rho]", " ", 
      RowBox[{"SphericalBesselY", "[", 
       RowBox[{"L", ",", 
        RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}]}], "}"}], "->", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", " ", "\[Rho]", " ", 
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"L", ",", 
             RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}], ",", 
          RowBox[{"k", " ", "\[Rho]", " ", 
           RowBox[{"SphericalBesselY", "[", 
            RowBox[{"L", ",", 
             RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", 
          RowBox[{"DirectedInfinity", "[", "1", "]"}], ",", "0"}], "}"}]}], 
       "]"}], "]"}], ",", 
     RowBox[{"k", ">", "0"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.69197375052801*^9, 3.6919737519240847`*^9}, {
  3.691973849955374*^9, 3.691973880610902*^9}, {3.6919739479200993`*^9, 
