a0af36c029a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[Rho]\[Psi]", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "\[Rho]", "}"}], ",", 
      RowBox[{
       RowBox[{
        SqrtBox["\[Rho]"], " ", 
        RowBox[{"BesselJ", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
          RowBox[{"k", " ", "\[Rho]"}]}], "]"}], " ", 
        RowBox[{"C", "[", "1", "]"}]}], "+", 
       RowBox[{
        SqrtBox["\[Rho]"], " ", 
        RowBox[{"BesselY", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
