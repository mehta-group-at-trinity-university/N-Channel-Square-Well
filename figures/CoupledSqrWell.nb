8477140ad112"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["r\[Psi]", "out"], "(", 
    RowBox[{"k", " ", "r"}], ")"}], "=", " ", 
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["k", "l"], "(", 
     RowBox[{"\[Kappa]", " ", "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693248097589587*^9, 3.6932481486696253`*^9}, {
