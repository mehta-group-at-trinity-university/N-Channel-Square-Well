Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
        RowBox[{"(", GridBox[{
           {
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"k", " ", "r"}], "]"}], "+", 
             RowBox[{"Kmat", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"k", " ", "r"}], "]"}]}]}]},
           {
            RowBox[{"b2", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["\[Nu]2", "2"], "-", 
                  SuperscriptBox["k", "2"]}]]}], "r"}]]}]}
          }], ")"}]}], ",", 
       RowBox[{
        RowBox[{"AvecsNormed", ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[Phi]mat", ",", "r"}], "]"}]}], "\[Equal]", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"k", " ", "r"}], "]"}], "+", 
               RowBox[{"Kmat", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"k", " ", "r"}], "]"}]}]}]},
             {
              RowBox[{"b2", " ", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                 RowBox[{"-", 
                  SqrtBox[
                   RowBox[{
                    SuperscriptBox["\[Nu]2", "2"], "-", 
                    SuperscriptBox["k", "2"]}]]}], "r"}]]}]}
            }], ")"}], ",", "r"}], "]"}]}]}], "}"}], "/.", 
     RowBox[{"r", "\[Rule]", "1"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"a1", ",", "a2", ",", "b2", ",", "Kmat"}], "}"}]}], "]"}], 
  "]"}]], "Input",
