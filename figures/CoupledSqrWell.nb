       RowBox[{"Assumptions", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "\[Element]", "Reals"}], ",", 
          RowBox[{
           SubscriptBox["\[Gamma]", "1"], "\[Element]", "Reals"}], ",", 
          RowBox[{
           SubscriptBox["\[Gamma]", "2"], "\[Element]", "Reals"}], ",", 
          RowBox[{
           SubscriptBox["\[Nu]", "2"], "\[Element]", "Reals"}], ",", 
          RowBox[{"g", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.691515593370042*^9, 3.691515675270022*^9}, {
