Cell["\<\
Define an orthogonal matrix comprised of normalized eigenvectors in the \
columns of the matrix.  Mathematica puts eigenvectors in the rows, so I\
\[CloseCurlyQuote]ll define this as the transpose of the output of \
\[OpenCurlyDoubleQuote]Eigenvectors\[CloseCurlyDoubleQuote] above:\
\>", "Text",
 CellChangeTimes->{{3.691541379569765*^9, 
  3.691541458673847*^9}},ExpressionUUID->"d7b6ef65-e728-4390-ae9b-\
e2361b2ba7ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AvecsNormed", "=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Normalize", "[", 
