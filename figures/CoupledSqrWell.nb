e8db0fe57821"],

Cell[CellGroupData[{

Cell["Coupled square well scattering and bound states", "Title",
 CellChangeTimes->{{3.691192381712702*^9, 3.691192391380272*^9}, {
  3.6915360359596577`*^9, 
  3.691536037733398*^9}},ExpressionUUID->"c2dd0ee6-194c-454b-8607-\
586a83c9ada1"],

Cell["A \[OpenCurlyDoubleQuote]simple\[CloseCurlyDoubleQuote] multichannel \
model", "Subtitle",
 CellChangeTimes->{{3.691192392150342*^9, 
  3.691192404821622*^9}},ExpressionUUID->"4ff760a4-c0bf-454e-a327-\
c4b8efd123e0"],

Cell[CellGroupData[{

Cell["1-channel square well", "Section",
 CellChangeTimes->{{3.692137809394552*^9, 
  3.692137821837714*^9}},ExpressionUUID->"bebc8e25-ac6c-4a92-95be-\
8d89056e471c"],

Cell[TextData[{
 "As a preliminary to the multichannel case, we will need to solve the single \
channel case to understand where the bound states are with respect to the \
threshold.  This will help us interpret the two-channel resonances, at least \
in the weak coupling regime.  Inside the well of range ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "62ee9b2b-56bb-4c33-afe5-1abd663a3fc8"],
 ", the wavefunction satisfies:"
}], "Text",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137929269053*^9}, {
  3.692282786010167*^9, 3.692282798297591*^9}, {3.693247648593514*^9, 
  3.693247653543399*^9}},ExpressionUUID->"3bcb2934-242f-468c-8deb-\
f5ed047874b5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "+", 
         SubscriptBox["V", "0"]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], "r", " ", "\[Psi]"}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692137942615315*^9, 
  3.692138038069057*^9}},ExpressionUUID->"b98269bd-2c40-4752-ba34-\
c386748c62d6"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], "E"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]],ExpressionUUID->
  "d7b745f9-4e15-48a1-8012-39f904d42672"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Gamma]", "2"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], 
      SubscriptBox["V", "0"]}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]],ExpressionUUID->
  "1959f96c-369a-4578-a342-fa3a257ed206"],
 ".  Also RESCALE ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "46c506b2-3e6f-485d-a0f2-48650ea39dca"],
 ".  Then"
}], "Text",
 CellChangeTimes->{{3.692282700363286*^9, 3.692282744588562*^9}, {
  3.693248576840211*^9, 
  3.693248624217347*^9}},ExpressionUUID->"53644d24-8f44-4a33-b5f7-\
cc5547810fea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{"+", 
        SuperscriptBox["k", "2"]}]}], "+", 
      SuperscriptBox["\[Gamma]", "2"], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], "r", " ", "\[Psi]"}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69228274835502*^9, 
  3.69228275862792*^9}},ExpressionUUID->"a94bb0c0-b1e6-49e0-bd9c-\
069486ff87ca"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "2"], "=", 
    RowBox[{
     SuperscriptBox["k", "2"], "+", 
     SuperscriptBox["\[Gamma]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "e3e7f1bd-49f0-4bb3-b9a1-fe5bc9deb9f1"],
 ", and divide through by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "769d07f0-e6d5-4c2b-b0dc-b167fd848111"]
}], "Text",
 CellChangeTimes->{{3.6932478860162077`*^9, 3.6932479787780113`*^9}, {
  3.693248723972603*^9, 
  3.69324872423641*^9}},ExpressionUUID->"66a1efc7-a1c0-4fd5-a1fa-\
4c910b4150db"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Beta]", " ", "r"}], ")"}], "2"]}]], 
       RowBox[{"+", "1"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Beta]", " ", "r"}], ")"}], "2"]}]]}], ")"}], "r", " ", 
    "\[Psi]"}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.693247868285534*^9, {3.6932479524396048`*^9, 
   3.693248019369544*^9}},ExpressionUUID->"b594d805-a654-4539-b5f8-\
fb9a788756eb"],

Cell[TextData[{
 "The fundamental unit of length is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "9ed3b776-b959-4b6d-b5e8-48f9828fd680"],
 ", the unit of energy is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]],ExpressionUUID->
  "c7d7be6d-ab94-4259-a505-2063a4f0b0e4"],
 ". "
}], "Text",
 CellChangeTimes->{{3.693248653482848*^9, 
  3.693248683220747*^9}},ExpressionUUID->"b0428351-c42a-4404-bb6f-\
e260ba3ba4ed"],

Cell["Then inside,", "Text",
 CellChangeTimes->{{3.6932480263508663`*^9, 3.6932480277736673`*^9}, {
  3.693248109225417*^9, 
  3.6932481100556517`*^9}},ExpressionUUID->"1db2b74c-5c5f-4870-89e7-\
dbacb6e87973"],

Cell[BoxData[
 FormBox[
