}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ1", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
