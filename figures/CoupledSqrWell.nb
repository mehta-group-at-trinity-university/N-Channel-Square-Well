   3.6932506260624533`*^9},ExpressionUUID->"60e5e544-94f5-4e4e-9167-\
47cff3635147"]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s make this easier to handle by multiplying through by \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"sin", "(", 
    SqrtBox[
     RowBox[{"E", "+", 
      SubscriptBox["V", "0"]}]], ")"}], TraditionalForm]],ExpressionUUID->
  "2f1e43df-e164-4424-ab0c-812fa02daa2e"],
 " (it\[CloseCurlyQuote]s all equal to zero anyhow, so this doesn\
\[CloseCurlyQuote]t change the position of the roots.)"
}], "Text",
 CellChangeTimes->{{3.693250554885047*^9, 
  3.6932505906618643`*^9}},ExpressionUUID->"1e38b777-f60c-486b-8c73-\
dd54ac084089"],

Cell["For s-waves:", "Text",
 CellChangeTimes->{{3.693525710238262*^9, 
  3.693525717359888*^9}},ExpressionUUID->"ad1c393d-4c90-4e65-82c9-\
0e33d65799ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"EE", "+", "V0"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
       "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"SphericalBesselK", "[", 
           RowBox[{"L", ",", 
            RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], 
        "]"}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "\[Rule]", "0"}], ",", 
      RowBox[{"r", "\[Rule]", "1"}], ",", 
      RowBox[{"\[Beta]", "\[Rule]", 
       SqrtBox[
        RowBox[{" ", 
         RowBox[{"EE", "+", "V0"}]}]]}], ",", 
      RowBox[{"k", "\[Rule]", 
       SqrtBox["EE"]}], ",", 
      RowBox[{"\[Kappa]", "\[Rule]", 
       SqrtBox[
        RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693250594646847*^9, 
  3.6932506485730143`*^9}},ExpressionUUID->"ccebf8ed-e666-4633-949e-\
0cb4e6e699ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"EE", "+", "V0"}]], " ", 
   RowBox[{"Cos", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"-", "EE"}]], " ", 
   RowBox[{"Sin", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.693250613454967*^9, 3.693250649741685*^9}, 
   3.693486800412026*^9},ExpressionUUID->"ec92ff1d-6454-4513-8177-\
42d3a7ba80c6"]
}, Open  ]],

