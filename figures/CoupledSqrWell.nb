Cell[CellGroupData[{

Cell["Scattering theory basics", "Subsection",
 CellChangeTimes->{{3.6919286666980658`*^9, 
  3.691928672984501*^9}},ExpressionUUID->"b08f68b6-3b79-4ce3-b6fb-\
37bafd92d3ea"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   StyleBox["r",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "eabe82d1-d72d-4636-ba90-75540cc128b2"],
 " be the relative vector from molecule 1 to molecule 2.  Let ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "80c5e377-49df-460a-8c63-c0f2f84df19e"],
 " denote the internal state of the \[OpenCurlyDoubleQuote]projectile\
\[CloseCurlyDoubleQuote] and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "7f3e38b1-27de-4573-900d-2b0ff039d73a"],
 " describe the \[OpenCurlyDoubleQuote]target\[CloseCurlyDoubleQuote]. Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "p"], TraditionalForm]],ExpressionUUID->
  "d726b409-fc56-4f47-b734-bd23a1ed9552"],
 " be the angular momentum of the projectile and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "t"], TraditionalForm]],ExpressionUUID->
  "5aec6a42-5fcb-4db5-80ed-987bada1f207"],
 " be the angular momentum of the target, and ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "3b82c42a-b519-4a6f-b83e-15e7fb003227"],
 " be the relative angular momentum of the two particles.  There are two \
different coupling schemes that are possible:"
}], "Text",
 CellChangeTimes->{{3.692021206427711*^9, 3.692021452364347*^9}, {
  3.69203684109052*^9, 3.692036993324337*^9}, {3.6920373734682493`*^9, 
  3.6920373754667892`*^9}, {3.6920374080013*^9, 3.6920374504867887`*^9}, {
  3.692039221677293*^9, 3.6920392719793262`*^9}, {3.692130959316618*^9, 
  3.692130998276024*^9}, {3.692131074568791*^9, 
  3.6921311354729567`*^9}},ExpressionUUID->"90622ee8-b729-402f-8ac7-\
90c7d52a929c"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]S basis\[CloseCurlyDoubleQuote]:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S",
     FontWeight->"Bold"], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["J",
       FontWeight->"Bold"], "p"], "+", 
     SubscriptBox[
      StyleBox["J",
       FontWeight->"Bold"], "t"]}]}], TraditionalForm]],ExpressionUUID->
  "b7957625-9555-47a3-a189-e1c73c114581"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["J",
      FontWeight->"Bold"], "tot"], "=", 
    RowBox[{
     StyleBox["L",
      FontWeight->"Bold"], "+", 
     StyleBox["S",
      FontWeight->"Bold"]}]}], TraditionalForm]],ExpressionUUID->
  "de14fd96-9d1c-41e4-8169-a6d6d526a83a"]
}], "Text",
 CellChangeTimes->{{3.692021206427711*^9, 3.692021452364347*^9}, {
  3.69203684109052*^9, 3.6920370368044853`*^9}, {3.692131140933716*^9, 
  3.692131143309265*^9}},ExpressionUUID->"560073e4-540e-48fc-b152-\
1589cb6bf63a"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]J basis\[CloseCurlyDoubleQuote]:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["J",
      FontWeight->"Bold"], "a"], "=", 
    RowBox[{
     StyleBox["L",
      FontWeight->"Bold"], "+", 
     SubscriptBox[
      StyleBox["J",
       FontWeight->"Bold"], "t"]}]}], TraditionalForm]],ExpressionUUID->
  "943d92c0-bf5c-4ab0-ac69-ffd7f3b28589"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["J",
       FontWeight->"Bold"], "a"], "+", 
     SubscriptBox[
      StyleBox["J",
       FontWeight->"Bold"], "p"]}], "=", 
    SubscriptBox[
     StyleBox["J",
      FontWeight->"Bold"], "tot"]}], TraditionalForm]],ExpressionUUID->
  "f16f34ed-846d-4e5e-94f7-cd3ee97f5137"]
}], "Text",
 CellChangeTimes->{{3.692021206427711*^9, 3.692021452364347*^9}, {
  3.69203684109052*^9, 3.6920370411232862`*^9}, {3.692131152229031*^9, 
  3.69213116819174*^9}},ExpressionUUID->"7b5ec72b-1e1b-488b-82f7-\
e4de74a9c204"],

Cell[TextData[{
 "Asymptotically, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold"], ">>", 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "0"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->
  "f91e1c7a-e56b-4714-ae05-61355aac5e87"],
 ", with both the projectile and target in the ro-vibrational ground state, \
we expect ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "p"], "=", 
    RowBox[{
     SubscriptBox["J", "t"], "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "067464ac-d197-4110-bc8a-c02fec671e4c"],
 " and thus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "ba6b878e-fde9-4ac4-826f-8df24b7ff61f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "tot"], "=", "L"}], TraditionalForm]],ExpressionUUID->
  "1f9fc91b-5e60-4fc9-b641-a4f6dabb029d"],
 ".  Or, in the J basis, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "a"], "=", 
    RowBox[{
     SubscriptBox["J", "tot"], "=", "L"}]}], TraditionalForm]],ExpressionUUID->
  "3db3c4fb-b03f-47b1-8f82-63758c84f909"],
 ".  We further let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", " ", "t"}], ";", " ", 
      RowBox[{
       SubscriptBox["J", "p"], 
       SubscriptBox["J", "t"], " ", "S", " ", "L", " ", 
       SubscriptBox["J", 
        RowBox[{"tot", " "}]]}]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "7333455d-0d15-4625-8e52-59ec61170d89"],
 " denote all relevant quantum numbers in the S basis and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", " ", "t"}], ";", " ", 
      RowBox[{
       SubscriptBox["J", "t"], " ", "L", " ", 
       SubscriptBox["J", "a"], " ", 
       SubscriptBox["J", "p"], " ", 
       SubscriptBox["J", "tot"]}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"72711715-845a-4f9e-95e5-74f0f1ae486a"],
 " be the analogous index in the J basis."
}], "Text",
 CellChangeTimes->{{3.6920372265454206`*^9, 3.692037320341529*^9}, {
  3.692039114666522*^9, 3.6920391287122507`*^9}, {3.69203929530538*^9, 
  3.6920393936986637`*^9}, {3.6921311804466257`*^9, 
  3.692131244391676*^9}},ExpressionUUID->"55b093a8-7f5f-467f-87c0-\
2f437967bb28"],

Cell["We can write the asymptotic wavefunction as:", "Text",
 CellChangeTimes->{{3.692039198346092*^9, 
  3.692039206491434*^9}},ExpressionUUID->"4850cfa3-f3bf-4d9f-9e1b-\
15adf11f8beb"],

Cell[BoxData[
 FormBox["", TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6920392093206997`*^9, 3.6920392141710777`*^9}, {
  3.692039399498385*^9, 3.6920394411845503`*^9}, {3.6921375844201717`*^9, 
  3.692137587625348*^9}},ExpressionUUID->"b460bf4a-5432-4e80-895e-\
aa03781475cb"],

Cell["", "Text",
 CellChangeTimes->{{3.692039287007218*^9, 
  3.692039290137784*^9}},ExpressionUUID->"2940dd55-7172-4ab8-9ba2-\
13ea0bce4e6b"],

Cell["\<\
The basic formulas for multichannel scattering (See Taylor section 17d).  The \
partial wave multichannel scattering amplitude is defined as:\
\>", "Text",
 CellChangeTimes->{{3.6920206450751343`*^9, 
  3.6920206467636967`*^9}},ExpressionUUID->"f326b825-9643-4e80-a9ba-\
3a972a082c11"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["f", 
    RowBox[{
     RowBox[{"\[Alpha]", "'"}], ",", " ", "\[Alpha]"}], "l"], "=", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox["s", 
      RowBox[{
       RowBox[{"\[Alpha]", "'"}], ",", " ", "\[Alpha]"}], "l"], "-", 
     SubscriptBox["\[Delta]", 
      RowBox[{
       RowBox[{"\[Alpha]", "'"}], ",", " ", "\[Alpha]"}]]}], 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SqrtBox[
      RowBox[{
       SubscriptBox["p", 
        RowBox[{"\[Alpha]", "'"}]], 
       SubscriptBox["p", "\[Alpha]"]}]]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6919338214063*^9, 3.691933932367949*^9}, {
  3.691936183134004*^9, 
  3.6919362555570087`*^9}},ExpressionUUID->"76979c70-7d80-4d81-bd55-\
273bed10296a"],

Cell[TextData[{
 "where, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "\[Alpha]"], "=", 
    SqrtBox[
     RowBox[{"2", 
      RowBox[{
       SubscriptBox["\[Mu]", "\[Alpha]"], "(", 
       RowBox[{"E", "-", 
        SubsuperscriptBox["E", "\[Alpha]", "th"]}], ")"}]}]]}], 
   TraditionalForm]],ExpressionUUID->"8f32144e-caca-437d-962e-72da3994bb28"],
 ".  With this definition, the full scattering amplitude is"
}], "Text",
 CellChangeTimes->{{3.6919362708180304`*^9, 3.691936302352887*^9}, {
  3.691936339975876*^9, 
  3.6919363732227907`*^9}},ExpressionUUID->"6ea0d415-434b-4bb7-8bc7-\
b02965b28168"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", 
    RowBox[{
     StyleBox[
      RowBox[{"p", "'"}],
      FontWeight->"Bold"], 
     StyleBox[",",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox[
       RowBox[{"\[Alpha]", "'"}],
       FontWeight->"Plain"], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      StyleBox["\[LeftArrow]",
       FontWeight->"Plain"], 
      StyleBox["p",
       FontWeight->"Bold"]}], ",", "\[Alpha]"}], ")"}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "L"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "L"}], "+", "1"}], ")"}], 
     SubsuperscriptBox["f", 
      RowBox[{
       RowBox[{"\[Alpha]", "'"}], ",", " ", "\[Alpha]"}], "l"], 
     RowBox[{
      SubscriptBox["P", "l"], "(", 
      RowBox[{"cos", " ", "\[Theta]"}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691936375161148*^9, 3.69193643129381*^9}, {
  3.69201528939918*^9, 3.692015292260913*^9}, {3.692018055738287*^9, 
  3.692018063176505*^9}},ExpressionUUID->"85a11e3c-ed9e-4eef-bd03-\
f5ff0bdf80fa"],

Cell["With only one channel open channel,", "Text",
 CellChangeTimes->{{3.691936439808535*^9, 
  3.691936446400388*^9}},ExpressionUUID->"038aba5f-962e-463b-826f-\
b4a84442cea5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["s", 
    RowBox[{"1", ",", "1"}], "L"], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     SubscriptBox["\[Delta]", "L"]}]]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.691936439808535*^9, 3.691936461644619*^9}, {
  3.6920152939238367`*^9, 
  3.692015298484623*^9}},ExpressionUUID->"3a52ec41-99ed-4f48-987b-\
501eead773f0"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.691774672982987*^9, 3.691774707034924*^9}, 
   3.691937157165182*^9},ExpressionUUID->"99ea28a4-aca3-4e4a-ab58-\
2c34d69ce30f"],

Cell[BoxData[
 FormBox["", TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.6917740916218443`*^9},ExpressionUUID->"b890e419-6885-483d-81eb-\
1e3851d95c7e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generalize to N channels...", "Section",
 CellChangeTimes->{{3.69119241526888*^9, 3.691192436520215*^9}, {
  3.691541195693425*^9, 
  3.691541208493631*^9}},ExpressionUUID->"f12bbc7c-c802-409b-a901-\
3ac985a439ab"],

Cell["\<\
Let\[CloseCurlyQuote]s imagine a two-body Hamiltonian in relative coordinates \
that is of the form:\
\>", "Text",
 CellChangeTimes->{{3.69119241526888*^9, 
  3.691192467680552*^9}},ExpressionUUID->"00eece22-afaa-4f7a-8987-\
498372ae5368"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{"T", "+", "V"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 
  3.6911924796418753`*^9}},ExpressionUUID->"170de261-425e-4b6a-a49e-\
a422041541d4"],

Cell[BoxData[
 FormBox[
  RowBox[{"V", "=", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["V", "11"], 
       SubscriptBox["V", "12"], 
       SubscriptBox["V", "13"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "21"], 
       SubscriptBox["V", "22"], 
       SubscriptBox["V", "23"], "\[CenterEllipsis]"},
      {
       SubscriptBox["V", "31"], 
       SubscriptBox["V", "32"], 
       SubscriptBox["V", "33"], "\[CenterEllipsis]"},
      {"\[VerticalEllipsis]", "\[VerticalEllipsis]", "\[VerticalEllipsis]", 
       "\[DescendingEllipsis]"}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691192472212595*^9, 3.6911924829762497`*^9}, {
  3.691192582195599*^9, 3.691192621779035*^9}, {3.6911926721912203`*^9, 
  3.691192724406451*^9}},ExpressionUUID->"6210c701-0767-484c-81cc-\
dbd8ad1bc2be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["scratch...", "Section",
 CellChangeTimes->{{3.6919398092710953`*^9, 
  3.691939814134585*^9}},ExpressionUUID->"0ce50df9-64b0-422e-b228-\
de5cb53ccce9"],

Cell[BoxData[
 RowBox[{"Clear", "[", "k", "]"}]], "Input",
 CellChangeTimes->{{3.691939895409574*^9, 
  3.6919398982319*^9}},ExpressionUUID->"62fde4f5-3c95-49da-819e-59b7c2d02681"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]phys", "=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], "S"}], "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}]},
     {
      RowBox[{"n", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "q"}], " ", "r"}]]}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{{3.691939824542192*^9, 
  3.691939891774976*^9}},ExpressionUUID->"5954cfd9-15cc-406e-9370-\
1282bb848b4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}]], " ", "S"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "q"}], " ", "r"}]], " ", "n"}], "}"}]}], "}"}]], "Output",\

 CellChangeTimes->{
  3.692020734651424*^9},ExpressionUUID->"836d89da-535b-4e41-a022-\
7bc9acceb841"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{"\[Psi]phys", ",", "r"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.6919399315358477`*^9, 3.691939948564246*^9}, {
  3.692020739268639*^9, 
  3.692020743900567*^9}},ExpressionUUID->"45cb5451-634f-4b68-be77-\
99ba7767b655"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "r"}]], " ", "k", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "k", " ", "r"}]], " ", 
        "S"}]}], ")"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "q"}], " ", "r"}]]}], " ", "n", " ", "q"}], "}"}]}], 
