         FractionBox["1", "2"], " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            SuperscriptBox["k", "2"]}], "+", 
           SuperscriptBox["\[Gamma]1", "2"], "+", 
           SuperscriptBox["\[Gamma]2", "2"], "-", 
           SuperscriptBox["\[Nu]2", "2"], "-", 
           SqrtBox[
            RowBox[{
             RowBox[{"4", " ", 
              SuperscriptBox["g", "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["\[Gamma]1", "2"], "-", 
                SuperscriptBox["\[Gamma]2", "2"], "+", 
                SuperscriptBox["\[Nu]2", "2"]}], ")"}], "2"]}]]}], ")"}]}], 
        "]"}]}], 
      SqrtBox[
       RowBox[{"4", "+", 
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["\[Gamma]1", "2"]}], "+", 
            SuperscriptBox["\[Gamma]2", "2"], "-", 
            SuperscriptBox["\[Nu]2", "2"], "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"4", " ", 
               SuperscriptBox["g", "2"]}], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["\[Gamma]1", "2"], "-", 
                 SuperscriptBox["\[Gamma]2", "2"], "+", 
                 SuperscriptBox["\[Nu]2", "2"]}], ")"}], "2"]}]]}], "g"], 
          "]"}], "2"]}]]], "+", 
     FractionBox[
      RowBox[{"2", " ", "a2", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            SuperscriptBox["k", "2"]}], "+", 
           SuperscriptBox["\[Gamma]1", "2"], "+", 
