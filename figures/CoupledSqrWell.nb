  3.6919732179600487`*^9},ExpressionUUID->"3d15cf44-2e17-4b94-8893-\
8c05d146d255"]
}, Open  ]],

Cell[TextData[{
 "Evidently, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Rho]\[Psi]", "1", "II"], TraditionalForm]],
  CellChangeTimes->{{3.6919735103557243`*^9, 3.6919735145815077`*^9}},
  ExpressionUUID->"eb345565-d66f-444f-a82f-c042586b1297"],
 " must be a linear combination of ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]],ExpressionUUID->
  "eaa9ad2c-0de3-44f5-8ca9-e0127f13c2db"],
 " times a spherical Bessel functions.  i.e. that ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]],ExpressionUUID->
  "3e41c37f-3664-42ef-b3bc-53e369106971"],
 " goes as linear combination of spherical bessel functions."
}], "Text",
 CellChangeTimes->{{3.6919735103557243`*^9, 3.691973512296915*^9}, {
   3.691973548818554*^9, 3.6919735734009523`*^9}, 3.691973746478595*^9, {
   3.6919738143820133`*^9, 
   3.691973845601947*^9}},ExpressionUUID->"a8442c07-1874-4a0e-bdd4-\
71014c856e39"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Rho]\[Psi]", "1", "II"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "L"], "\[Rho]", " ", 
     RowBox[{
      SubscriptBox["j", "L"], "(", 
      RowBox[{"k", " ", "\[Rho]"}], ")"}]}], "+", 
    RowBox[{
     SubscriptBox["B", "L"], "\[Rho]", " ", 
     RowBox[{
      SubscriptBox["y", "L"], "(", 
      RowBox[{"k", " ", "\[Rho]"}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6919735103557243`*^9, 3.6919735145815077`*^9}, {
  3.6919736043588247`*^9, 3.691973632381414*^9}, {3.69197378247095*^9, 
