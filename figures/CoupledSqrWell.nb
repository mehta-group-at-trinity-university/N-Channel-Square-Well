6f93180968c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["A",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SubscriptBox[
     RowBox[{"(", GridBox[{
        {
