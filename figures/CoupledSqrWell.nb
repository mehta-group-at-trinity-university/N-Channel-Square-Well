Cell[CellGroupData[{

Cell["2-channel model", "Section",
 CellChangeTimes->{{3.6913254006973877`*^9, 
  3.6913254033273582`*^9}},ExpressionUUID->"d2e6434b-2d51-468c-bbde-\
fd91c7bb5823"],

Cell["\<\
Before attempting the N-channel problem, let\[CloseCurlyQuote]s see if we can \
understand the 2-channel problem.  Consider a two-particle problem with the \
following Schrodinger equation for the radial wavefunction.\
\>", "Text",
 CellChangeTimes->{{3.69132540528559*^9, 3.691325503700852*^9}, {
  3.691329515923091*^9, 3.6913295227177267`*^9}, {3.692015310814674*^9, 
  3.692015315123601*^9}},ExpressionUUID->"a76c5cfa-688d-4a60-a418-\
e0f39719f5a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "1"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}], 
        SubscriptBox["V", "12"]},
       {
        SubscriptBox["V", "12"], 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "2"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{" ", 
         RowBox[{"r", " ", 
          SubscriptBox["\[Psi]", "1"]}]}]},
       {
        RowBox[{" ", 
         RowBox[{"r", " ", 
          SubscriptBox["\[Psi]", "2"]}]}]}
      }], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"r", " ", 
         SubscriptBox["\[Psi]", "1"]}]},
       {
        RowBox[{"r", " ", 
         SubscriptBox["\[Psi]", "2"]}]}
      }], ")"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69132540528559*^9, 3.6913257122886*^9}, {
  3.691325850309527*^9, 3.6913258503812103`*^9}, {3.691329492441304*^9, 
  3.691329529218878*^9}, {3.6915358826316853`*^9, 3.691535886196721*^9}, {
