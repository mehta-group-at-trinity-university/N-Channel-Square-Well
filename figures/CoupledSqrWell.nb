67b6a0202419"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["A",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SubscriptBox[
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["a", "1"], 
