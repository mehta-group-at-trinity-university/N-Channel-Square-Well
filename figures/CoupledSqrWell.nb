        }], ")"}]}]}], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       FormBox[
        StyleBox[
         RowBox[{"(", GridBox[{
            {
             SubscriptBox["h", "0"], "0"},
            {"0", 
             SubscriptBox["h", "0"]}
           }], ")"}],
         FontWeight->"Plain"],
        TraditionalForm], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"a", " ", "f"}], "+", 
            RowBox[{"b", " ", "g"}]}]},
          {
           RowBox[{
            RowBox[{"c", " ", "f"}], "+", 
            RowBox[{"d", " ", "g"}]}]}
         }], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {"a", "b"},
          {"c", "d"}
         }], ")"}], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            SubscriptBox["h", "0"], "[", "f", "]"}]},
          {
           RowBox[{
            SubscriptBox["h", "0"], "[", "g", "]"}]}
         }], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "f", "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "g", "]"}]}]}]},
          {
           RowBox[{
            RowBox[{"c", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "f", "]"}]}], "+", 
            RowBox[{"d", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "g", "]"}]}]}]}
         }], ")"}], "-", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "f", "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "g", "]"}]}]}]},
          {
           RowBox[{
            RowBox[{"c", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "f", "]"}]}], "+", 
            RowBox[{"d", " ", 
             RowBox[{
              SubscriptBox["h", "0"], "[", "g", "]"}]}]}]}
         }], ")"}]}], "=", "0"}]}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.691540497895067*^9, 3.691540731179389*^9}, {
  3.691540781999652*^9, 3.691540901815838*^9}, {3.691540947286111*^9, 
