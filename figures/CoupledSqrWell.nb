Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Rho]\[Psi]", "[", "\[Rho]", "]"}], ",", "\[Rho]"}], 
         "]"}], ",", "\[Rho]"}], "]"}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"L", 
         RowBox[{"(", 
          RowBox[{"L", "+", "1"}], ")"}]}], 
        SuperscriptBox["\[Rho]", "2"]], 
       RowBox[{"\[Rho]\[Psi]", "[", "\[Rho]", "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["k", "2"], 
       RowBox[{"\[Rho]\[Psi]", "[", "\[Rho]", "]"}]}]}], "\[Equal]", "0"}], 
    ",", "\[Rho]\[Psi]", ",", "\[Rho]"}], "]"}], "]"}]], "Input",
