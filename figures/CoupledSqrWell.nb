Cell["matching the log-derivatives gives:", "Text",
 CellChangeTimes->{{3.693248262840794*^9, 3.6932482687550173`*^9}, 
   3.7971228932264442`*^9},ExpressionUUID->"c3bd8e01-666d-41f9-aa3e-\
c15ffe80e086"],

Cell[BoxData[
 RowBox[{"Clear", "[", "V0", "]"}]], "Input",
 CellChangeTimes->{{3.6932506211816063`*^9, 
  3.693250622797802*^9}},ExpressionUUID->"60b20535-5a55-43bc-9848-\
3795607e1d4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalBesselK", "[", 
   RowBox[{"L_", ",", "z_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", 
     RowBox[{"2", "z"}]]], 
   RowBox[{"BesselK", "[", 
    RowBox[{
     RowBox[{"L", "+", 
      RowBox[{"1", "/", "2"}]}], ",", "z"}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.693248343472334*^9},ExpressionUUID->"bf261fbb-ab4c-4a1e-85b9-\
290997d41228"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"L", ",", 
          RowBox[{"\[Beta]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
     "-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"SphericalBesselK", "[", 
         RowBox[{"L", ",", 
          RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], "]"}], ",", "r"}], "]"}]}],
     "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "\[Rule]", "0"}], ",", 
      RowBox[{"r", "\[Rule]", "1"}], ",", 
      RowBox[{"\[Beta]", "\[Rule]", 
       SqrtBox[
        RowBox[{" ", 
         RowBox[{"EE", "+", "V0"}]}]]}], ",", 
      RowBox[{"k", "\[Rule]", 
       SqrtBox["EE"]}], ",", 
      RowBox[{"\[Kappa]", "\[Rule]", 
       SqrtBox[
        RowBox[{"-", "EE"}]]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693248309096943*^9, 3.693248421137924*^9}, {
   3.693248491845243*^9, 3.6932485401534233`*^9}, {3.693248759742799*^9, 
   3.6932488029412737`*^9}, {3.693248843931534*^9, 3.6932488497787848`*^9}, {
   3.6932489835882883`*^9, 3.6932490173124523`*^9}, {3.693249070494452*^9, 
   3.693249072508464*^9}, {3.6932491242032824`*^9, 3.69324912463411*^9}, {
   3.6932491655362043`*^9, 3.693249173168014*^9}, 3.693249236451098*^9, {
   3.693249436966845*^9, 3.693249439221077*^9}, {3.693250545054103*^9, 
   3.6932505531712313`*^9}},ExpressionUUID->"7981c907-1b90-443b-abd6-\
787477ce2e3d"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"-", "EE"}]], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"EE", "+", "V0"}]], " ", 
   RowBox[{"Cot", "[", 
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.693248412131929*^9, 3.693248426612399*^9}, {
   3.693248751713696*^9, 3.693248820921893*^9}, 3.693248853522028*^9, 
