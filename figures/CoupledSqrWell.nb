e535773c79c4"],

Cell[TextData[{
 "In the interior region, the situation is more complicated due to the \
coupling.  It turns out that it is still possible to solve the problem \
exactly.  The trick is to use \[OpenCurlyDoubleQuote]dressed\
\[CloseCurlyDoubleQuote] states that are eigenstates of the constant matrix \
(assume ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "1a3f109a-547d-4f9c-ac7c-1dc313e75993"],
 " is real):"
}], "Text",
 CellChangeTimes->{{3.69150528489655*^9, 3.691505339447569*^9}, {
  3.691505438178183*^9, 
  3.691505442730088*^9}},ExpressionUUID->"8b0166df-2e6c-4ffb-a0bc-\
f1a26ef5da79"],

Cell[BoxData[
 FormBox[
  RowBox[{"W", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SuperscriptBox["k", "2"], "+", 
        SubsuperscriptBox["\[Gamma]", "1", "2"]}], "g"},
      {"g", 
       RowBox[{
        SuperscriptBox["k", "2"], "+", 
        SubsuperscriptBox["\[Gamma]", "2", "2"], "-", 
        SubsuperscriptBox["\[Nu]", "2", "2"]}]}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.69150528489655*^9, 3.691505347146747*^9}, 
   3.6915054343146048`*^9, {3.6915160390718*^9, 3.69151604699188*^9}, {
   3.691539773710031*^9, 3.6915397761785393`*^9}, 3.6915421732179203`*^9, {
   3.691940502347138*^9, 
   3.691940509390524*^9}},ExpressionUUID->"5c882e0f-b3b1-4a9c-a299-\
07cf7940af57"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"g", ",", "k"}], "]"}]], "Input",
 CellChangeTimes->{{3.6919405384191017`*^9, 
  3.691940571191972*^9}},ExpressionUUID->"d6cd40eb-6bc0-4e8a-9573-\
0b139d1cdbb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"W", "=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{
       SuperscriptBox["k", "2"], "+", 
       SubsuperscriptBox["\[Gamma]", "1", "2"]}], "g"},
     {"g", 
      RowBox[{
       SuperscriptBox["k", "2"], "-", 
       SubsuperscriptBox["\[Nu]", "2", "2"], "+", 
       SubsuperscriptBox["\[Gamma]", "2", "2"]}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{{3.6915053513402*^9, 3.691505354183426*^9}, 
