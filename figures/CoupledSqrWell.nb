       RowBox[{"{", 
        RowBox[{"Vn", ",", "2", ",", "Vmax", ",", "1"}], "}"}]}], "]"}], ",", 
     
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
