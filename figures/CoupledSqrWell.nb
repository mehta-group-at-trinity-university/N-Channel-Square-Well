Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[Gamma]1", ",", "\[Gamma]2", ",", "g", ",", "k", ",", "\[Nu]2"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.692066805022387*^9, 
  3.692066815422254*^9}},ExpressionUUID->"0d8da4a9-5e02-4214-96f5-\
8272414988c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ascat", "[", 
   RowBox[{
   "\[Gamma]1_", ",", "\[Gamma]2_", ",", "g_", ",", "k_", ",", "\[Nu]2_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SuperscriptBox["k", "2"], "+", 
          SuperscriptBox["\[Gamma]1", "2"]}], "g"},
        {"g", 
         RowBox[{
          SuperscriptBox["k", "2"], "+", 
          SuperscriptBox["\[Gamma]2", "2"], "-", 
          SuperscriptBox["\[Nu]2", "2"]}]}
       }], ")"}]}], ";", 
    RowBox[{"Avals", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Phi]mat", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a1", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"Avals", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "r"}], "]"}]}]},
        {
         RowBox[{"a2", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"Avals", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "r"}], "]"}]}]}
       }], ")"}]}], ";", 
    RowBox[{"AvecsNormed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "Kmat"}], "/", "k"}], "/.", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
            RowBox[{"(", GridBox[{
               {
                RowBox[{
                 RowBox[{"Sin", "[", 
                  RowBox[{"k", " ", "r"}], "]"}], "+", 
                 RowBox[{"Kmat", " ", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"k", " ", "r"}], "]"}]}]}]},
               {
                RowBox[{"b2", " ", 
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   RowBox[{"-", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[Nu]2", "2"], "-", 
                    SuperscriptBox["k", "2"]}]]}], "r"}]]}]}
              }], ")"}]}], ",", 
           RowBox[{
            RowBox[{"AvecsNormed", ".", 
             RowBox[{"D", "[", 
              RowBox[{"\[Phi]mat", ",", "r"}], "]"}]}], "\[Equal]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"(", GridBox[{
                 {
                  RowBox[{
                   RowBox[{"Sin", "[", 
                    RowBox[{"k", " ", "r"}], "]"}], "+", 
                   RowBox[{"Kmat", " ", 
                    RowBox[{"Cos", "[", 
                    RowBox[{"k", " ", "r"}], "]"}]}]}]},
                 {
                  RowBox[{"b2", " ", 
                   SuperscriptBox["\[ExponentialE]", 
                    RowBox[{
                    RowBox[{"-", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["\[Nu]2", "2"], "-", 
                    SuperscriptBox["k", "2"]}]]}], "r"}]]}]}
                }], ")"}], ",", "r"}], "]"}]}]}], "}"}], "/.", 
         RowBox[{"r", "\[Rule]", "1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "b2", ",", "Kmat"}], "}"}]}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.69213580819692*^9, 3.692136000685926*^9}, {
