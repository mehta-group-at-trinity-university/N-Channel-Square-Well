  3.6922834856129713`*^9, 3.692283487599886*^9}, {3.692283558719763*^9, 
  3.692283558895958*^9}},ExpressionUUID->"67746bb8-25bb-4e2a-97db-\
0722a763c23e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"r\[Psi]", "[", "r", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SqrtBox["r"], " ", 
      RowBox[{"BesselJ", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
        RowBox[{"k", " ", "r"}]}], "]"}], " ", 
      RowBox[{"C", "[", "1", "]"}]}], "+", 
     RowBox[{
      SqrtBox["r"], " ", 
      RowBox[{"BesselY", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
        RowBox[{"k", " ", "r"}]}], "]"}], " ", 
      RowBox[{"C", "[", "2", "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.69228341040399*^9, 3.692283488089788*^9, 
  3.6922835592054863`*^9},ExpressionUUID->"3d2f201f-33dc-41b6-a365-\
10dfba2433a3"]
}, Open  ]],

Cell["This is proportional to a spherical bessel funtion:", "Text",
 CellChangeTimes->{{3.692283780916402*^9, 
  3.692283798485758*^9}},ExpressionUUID->"4656f6c6-6dc2-44c6-af2b-\
27434c0d2354"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"FunctionExpand", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Rho]", " ", 
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"L", ",", 
        RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}], ",", 
     RowBox[{"\[Rho]", " ", 
      RowBox[{"SphericalBesselY", "[", 
       RowBox[{"L", ",", 
        RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}]}], "}"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{
  3.6922837901050777`*^9},ExpressionUUID->"0aff25aa-be37-4c03-9e13-\
fe8551a60df6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox[
      FractionBox["\[Pi]", "2"]], " ", "\[Rho]", " ", 
     RowBox[{"BesselJ", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "+", "L"}], ",", 
       RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}], 
    SqrtBox[
     RowBox[{"k", " ", "\[Rho]"}]]], ",", 
   FractionBox[
    RowBox[{
     SqrtBox[
      FractionBox["\[Pi]", "2"]], " ", "\[Rho]", " ", 
     RowBox[{"BesselY", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "+", "L"}], ",", 
       RowBox[{"k", " ", "\[Rho]"}]}], "]"}]}], 
    SqrtBox[
     RowBox[{"k", " ", "\[Rho]"}]]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.692283790811202*^9},ExpressionUUID->"24239ec5-309a-45c4-8529-\
2fe22bb61416"]
}, Open  ]],

Cell[TextData[{
 "Here, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "166ca434-d665-42a3-9d12-2014e7ff9f96"],
 " is measured in units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "c2210719-4b4c-4e37-8990-d6c3584eacee"],
 ", the well width.  ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "75a8120c-0d26-4001-890f-a6a769a311c7"],
 " is measured in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["r", "0", 
     RowBox[{"-", "1"}]], "."}], TraditionalForm]],ExpressionUUID->
  "16d1c8b2-c4aa-418e-8ebd-f45f9783bf56"]
}], "Text",
 CellChangeTimes->{{3.692283583085637*^9, 
  3.692283608472599*^9}},ExpressionUUID->"e2e3fb00-e586-4b7e-8d7f-\
2d130e4fa555"],

Cell["The solution that is regular at the origin is", "Text",
 CellChangeTimes->{{3.692282831236063*^9, 
  3.692282837494726*^9}},ExpressionUUID->"9fa36d69-d3f7-43e1-a34b-\
1426b665d370"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"r", " ", 
    SuperscriptBox["\[Psi]", "I"]}], "=", 
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["j", "L"], "(", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox["k", "2"], "+", 
        SuperscriptBox["\[Gamma]", "2"]}]], "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692282767037106*^9, 3.692282770707182*^9}, {
  3.6922828844191723`*^9, 3.692282902450287*^9}, {3.692282977737417*^9, 
  3.6922829782176456`*^9}},ExpressionUUID->"98d051d3-eb9b-4734-ac4f-\
594da503c93d"],

Cell[TextData[{
 "For bound states, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "<", "0"}], TraditionalForm]],ExpressionUUID->
  "23051c02-b95d-4476-b0c8-933aaba9bb52"],
 ".  Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Kappa]", "2"], "=", 
    RowBox[{"-", 
     SuperscriptBox["k", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "c44c3fb2-9f03-4a48-a902-d3676190d32d"],
 ".  The solution in the exterior region is "
}], "Text",
 CellChangeTimes->{{3.692282907515349*^9, 
  3.692282962521265*^9}},ExpressionUUID->"62469b27-1193-47eb-ad11-\
72432e48cb87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", 
  RowBox[{"FunctionExpand", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"r\[Psi]", "[", "r", "]"}], ",", "r"}], "]"}], ",", "r"}], 
        "]"}], "-", 
       RowBox[{
        SuperscriptBox["\[Kappa]", "2"], 
        RowBox[{"r\[Psi]", "[", "r", "]"}]}], "-", 
       RowBox[{
        FractionBox[
         RowBox[{"L", 
          RowBox[{"(", 
           RowBox[{"L", "+", "1"}], ")"}]}], 
         SuperscriptBox["r", "2"]], 
        RowBox[{"r\[Psi]", "[", "r", "]"}]}]}], "\[Equal]", "0"}], ",", 
     RowBox[{"r\[Psi]", "[", "r", "]"}], ",", "r", ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"\[Kappa]", "\[Element]", "Reals"}]}]}], " ", "]"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.692283978469503*^9, 3.692284061602264*^9}, {
  3.692284191115615*^9, 3.692284191874199*^9}, {3.6922843348621607`*^9, 
  3.692284361588541*^9}},ExpressionUUID->"c40081bb-877e-4fea-ba3c-\
056b5c3d144d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r\[Psi]", "(", "r", ")"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Kappa]", " ", 
       SuperscriptBox["r", 
        RowBox[{"3", "/", "2"}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Kappa]", " ", "r"}], ")"}], 
        RowBox[{
         RowBox[{"-", "L"}], "-", 
         FractionBox["1", "2"]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Kappa]", " ", "r"}], ")"}], 
        
        RowBox[{
         RowBox[{"-", "L"}], "-", 
         FractionBox["1", "2"]}]], " ", 
       TemplateBox[{RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}],
         RowBox[{"r", " ", "\[Kappa]"}]},
        "BesselI"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox[
           TagBox["c",
            C], "1"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Kappa]", " ", "r"}], 
            ")"}], 
           RowBox[{"2", " ", "L"}]]}], "+", 
         RowBox[{
          SubscriptBox[
           TagBox["c",
            C], "2"], " ", 
          RowBox[{"cot", "(", 
           RowBox[{
            FractionBox["1", "2"], " ", "\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}], ")"}], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Kappa]", " ", "r"}], 
            ")"}], 
           RowBox[{"2", " ", "L"}]]}], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubscriptBox[
           TagBox["c",
            C], "2"], " ", 
          RowBox[{"csc", "(", 
           RowBox[{
            FractionBox["1", "2"], " ", "\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}], ")"}], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Kappa]", " ", "r"}], ")"}], 
           RowBox[{"2", " ", "L"}]]}]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"2", " ", 
        SubscriptBox[
         TagBox["c",
          C], "2"], " ", 
        SqrtBox["r"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Kappa]", " ", "r"}], ")"}], 
         RowBox[{"L", "+", 
          FractionBox["1", "2"]}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Kappa]", " ", "r"}], ")"}], 
         RowBox[{
          RowBox[{"-", "L"}], "-", 
          FractionBox["1", "2"]}]], " ", 
        TemplateBox[{RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
              RowBox[{
                RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}],
          RowBox[{"r", " ", "\[Kappa]"}]},
         "BesselK"]}], "\[Pi]"]}]}], "}"}], "}"}], TraditionalForm]], "Output",\

 CellChangeTimes->{{3.692284007341052*^9, 3.692284062779064*^9}, 
   3.692284195703434*^9, {3.692284337249044*^9, 3.692284362082488*^9}, 
   3.6922863925010843`*^9},ExpressionUUID->"4a3f311d-aec5-4e8e-865b-\
04649f4bd0e5"]
}, Open  ]],

Cell[TextData[{
 "The part that is regular as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "5d7ff366-fa39-45c2-841a-2ce4ff2d53da"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"L", "+", 
     RowBox[{"1", "/", "2"}]}]], TraditionalForm]],ExpressionUUID->
  "a49ba348-2ede-414e-9aea-41e5180dc3b4"],
 " piece.  The ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", 
    RowBox[{"L", "+", 
     RowBox[{"1", "/", "2"}]}]], TraditionalForm]],ExpressionUUID->
  "a917ff69-4d10-4f3b-ad33-c224e9ef828e"],
 " blows up as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "83626339-b469-4ce1-ba34-9af7fe309a9b"],
 ".  We have"
}], "Text",
 CellChangeTimes->{{3.6922844653123903`*^9, 
  3.692284506295208*^9}},ExpressionUUID->"c90ecb1d-8d30-440a-9f93-\
9ece57187aa7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"r", " ", 
    SuperscriptBox["\[Psi]", "II"]}], "\[Proportional]", "  ", 
   RowBox[{
    SqrtBox["r"], "  ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "\[ImaginaryI]"}], " ", ")"}], 
     RowBox[{
      RowBox[{"-", "L"}], "-", 
      FractionBox["1", "2"]}]], " ", 
    TemplateBox[{RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}],
      RowBox[{"r", " ", "\[Kappa]"}]},
     "BesselK"]}], "\[Proportional]", 
   RowBox[{
    SqrtBox["r"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "\[ImaginaryI]"}], ")"}], "L"], " ", 
    TemplateBox[{RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{"2", " ", "L"}], "+", "1"}], ")"}]}],
      RowBox[{"r", " ", "\[Kappa]"}]},
     "BesselK"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692282968062481*^9, 3.692282986256995*^9}, {
  3.692284529191883*^9, 3.692284603177414*^9}, {3.6922860743101263`*^9, 
