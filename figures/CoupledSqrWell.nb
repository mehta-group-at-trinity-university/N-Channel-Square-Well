fd86cfd98805"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SqrtBox[
     RowBox[{"EE", "+", "V0"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"EE", " ", 
