Cell[BoxData[{
 RowBox[{
  RowBox[{"Vmax", "=", "2000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Vmax"}], "+", 
        SuperscriptBox[
         RowBox[{"N", "[", 
          RowBox[{"BesselJZero", "[", 
           RowBox[{
            RowBox[{"5", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}], ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
