Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"r\[Psi]", "[", "r", "]"}], ",", "r"}], "]"}], ",", "r"}], 
      "]"}], "+", 
     RowBox[{
      SuperscriptBox["k", "2"], 
      RowBox[{"r\[Psi]", "[", "r", "]"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"L", 
        RowBox[{"(", 
         RowBox[{"L", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], 
      RowBox[{"r\[Psi]", "[", "r", "]"}]}]}], "\[Equal]", "0"}], ",", 
   RowBox[{"r\[Psi]", "[", "r", "]"}], ",", "r"}], "]"}]], "Input",
