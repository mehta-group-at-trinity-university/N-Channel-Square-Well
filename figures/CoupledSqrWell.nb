Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         SqrtBox["r"], 
         RowBox[{"BesselK", "[", 
          RowBox[{
           RowBox[{"L", "+", 
            RowBox[{"1", "/", "2"}]}], ",", 
           RowBox[{"\[Kappa]", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], ",", 
      "r"}], "]"}]}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
