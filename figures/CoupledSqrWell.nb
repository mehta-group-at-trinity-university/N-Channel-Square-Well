   3.693250492125453*^9},ExpressionUUID->"d8ad51ea-594f-4b4c-9d75-\
dc78f48f8a97"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Kappa]", "2"], "=", 
    RowBox[{
     RowBox[{"-", "2"}], "\[Mu]", " ", 
     RowBox[{"E", "/", 
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], "."}]}]}]}], TraditionalForm]],
  ExpressionUUID->"070710d4-7a77-42be-9f8a-6b43ddca97a7"],
 "  or."
}], "Text",
 CellChangeTimes->{{3.6932482222548237`*^9, 3.6932482263765917`*^9}, {
  3.69324908776475*^9, 
  3.693249102522346*^9}},ExpressionUUID->"491d2bae-7c88-4357-bab6-\
a47e8b6b9212"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "in"], "=", 
   RowBox[{
    SubscriptBox["j", "l"], "(", 
    RowBox[{"\[Beta]", " ", "r"}], ")"}]}], 
