  3.691781222227126*^9}},ExpressionUUID->"00b5d9d2-fb94-412a-8be6-\
06b6946e043a"],

Cell[TextData[{
 "The wavefunction is not properly normalizable due to the open channel \
component.  What we really care about is how much of the wavefunction is in \
the open channel component and how much is in the closed channel component.  \
Right now, we have 5 unknowns ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["a", "1"], ",", 
     SubscriptBox["a", "2"], ",", 
     SubscriptBox["b", "1"], ",", 
     SubscriptBox["b", "2"], ",", " ", "\[Delta]"}], ")"}], TraditionalForm]],
  ExpressionUUID->"d42d66da-3bab-45d3-9f34-f281238f248d"],
 " and 4 equations, but we can set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "1"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "25b55e6f-5e39-4d8a-829c-8dacb8b586ad"],
 ", and all other ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", "'"}], "s"}], TraditionalForm]],ExpressionUUID->
  "e8cbf3d0-cb9b-47f4-af10-384714af3954"],
 " are measured relative to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "1"], "."}], TraditionalForm]],ExpressionUUID->
  "3224dbc5-7aee-4f88-a580-1a7fecbb7c91"],
 "  This way we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "N"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "5981f480-4834-431b-8d8b-761718859883"],
 " equations (one of which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "1"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "dd5cadac-16ec-4c1a-8257-b77bc94358ec"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "N"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "c578e05a-fc7d-4040-9257-ff3045ff40c4"],
 " unknowns."
}], "Text",
 CellChangeTimes->{{3.6918827840113277`*^9, 3.691882917915082*^9}, {
  3.691882949106834*^9, 3.691883067026555*^9}, {3.691883121126008*^9, 
  3.691883174348481*^9}, {3.6918834117796803`*^9, 
  3.691883462978074*^9}},ExpressionUUID->"a9dbbb0c-8e0f-451e-b2f8-\
d5011559946b"],

Cell["\<\
The one thing that worries me is that this reasoning is not so readily \
generalized to the case where an arbitrary number of channels are open.  I \
need to go through this and recast it in terms of an S-matrix to make sure I\
\[CloseCurlyQuote]m thinking of it correctly.\
\>", "Text",
 CellChangeTimes->{{3.6918827840113277`*^9, 3.691882917915082*^9}, {
  3.691882949106834*^9, 3.691883067026555*^9}, {3.691883121126008*^9, 
  3.691883174348481*^9}, {3.6918834117796803`*^9, 
  3.691883547136565*^9}},ExpressionUUID->"c7a32650-5fbc-4ed1-a3d7-\
dc7183b8e43d"],

Cell[CellGroupData[{

Cell["Perhaps we\[CloseCurlyQuote]re ready for some numbers...", "Subsection",
 CellChangeTimes->{{3.6919376123926783`*^9, 
  3.69193762963272*^9}},ExpressionUUID->"1118f4dc-bf1a-4300-ad7d-\
67ed4b3f5f9f"],

Cell["Recall that we defined", "Text",
 CellChangeTimes->{{3.6919376773703947`*^9, 
  3.691937682950429*^9}},ExpressionUUID->"fe129309-f5a4-4276-9687-\
15be2bfab4c7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[Mu]", " ", 
       SubsuperscriptBox["r", "0", "2"]}], 
      SuperscriptBox["\[HBar]", "2"]], 
     SubscriptBox["V", "12"]}]}], TraditionalForm]],ExpressionUUID->
  "b00fbfc2-39d4-40cf-81b7-1b704a80e7d8"],
 "  is a dimensionless coupling,"
}], "Text",
 CellChangeTimes->{{3.691499608876347*^9, 3.691499725036026*^9}, {
  3.6914997758645973`*^9, 3.6914998275525084`*^9}, {3.691500086165386*^9, 
  3.691500149736658*^9}, {3.691500264638363*^9, 3.691500264638435*^9}, {
  3.691537024933874*^9, 
  3.691537034149106*^9}},ExpressionUUID->"0dcf6a78-ac7a-4306-a931-\
af081fefeea4"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Gamma]", "i", "2"], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Mu]", " ", 
        SubsuperscriptBox["r", "0", "2"]}], 
       SuperscriptBox["\[HBar]", "2"]], 
      SubscriptBox["V", "i"]}], ">", "0"}]}], TraditionalForm]],
  ExpressionUUID->"b604d398-77d1-49f2-8968-a4720cc4f10a"],
 "  is a wavenumber (squared) that measures the depth of the well in channel ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "9e0998de-fa6e-4300-8a58-d12425e2fc61"],
 ", "
