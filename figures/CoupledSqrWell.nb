  3.691974313624295*^9}},ExpressionUUID->"a1cf7fc8-eea7-4e82-bf81-\
f38468763604"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", " ", "\[Rho]", " ", 
      TemplateBox[{"L",RowBox[{"k", " ", "\[Rho]"}]},
       "SphericalBesselJ"]}], ",", 
     RowBox[{"k", " ", "\[Rho]", " ", 
      TemplateBox[{"L",RowBox[{"k", " ", "\[Rho]"}]},
       "SphericalBesselY"]}]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"L", " ", 
        RowBox[{"(", 
         RowBox[{"L", "+", "1"}], ")"}], " ", 
        RowBox[{"cos", "(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Pi]", " ", "L"}], "2"], "-", 
          RowBox[{"k", " ", "\[Rho]"}]}], ")"}]}], "-", 
       RowBox[{"2", " ", "k", " ", "\[Rho]", " ", 
        RowBox[{"sin", "(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Pi]", " ", "L"}], "2"], "-", 
          RowBox[{"k", " ", "\[Rho]"}]}], ")"}]}]}], 
      RowBox[{"2", " ", "k", " ", "\[Rho]"}]], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"L", " ", 
         RowBox[{"(", 
          RowBox[{"L", "+", "1"}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Pi]", " ", "L"}], "2"], "-", 
           RowBox[{"k", " ", "\[Rho]"}]}], ")"}]}], "+", 
        RowBox[{"2", " ", "k", " ", "\[Rho]", " ", 
         RowBox[{"cos", "(", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Pi]", " ", "L"}], "2"], "-", 
           RowBox[{"k", " ", "\[Rho]"}]}], ")"}]}]}], 
       RowBox[{"2", " ", "k", " ", "\[Rho]"}]]}]}], "}"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.691973975834837*^9, 3.691974019091975*^9}, 
