Cell[CellGroupData[{

Cell["Potential Alternatives to the Brody distribution", "Subsection",
 CellChangeTimes->{{3.744547304114995*^9, 3.744547310513595*^9}}],

Cell[TextData[{
 "Are there other functions that extrapolate between the Poisson and Wigner \
limits?  The SP distribution appears to have the right idea, but doesn\
\[CloseCurlyQuote]t produce a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "2"], "\[TildeTilde]", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", so can we imagine another family of functions that achieves the desired \
goal but with less repulsion at intermediate values of ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "?"
}], "Text",
 CellChangeTimes->{{3.74454731375282*^9, 3.7445474302174273`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PBrody", "[", 
  RowBox[{"s", ",", "w"}], "]"}]], "Input",
 CellChangeTimes->{{3.7445454704614983`*^9, 3.744545507433723*^9}, {
  3.744545660839126*^9, 3.7445456609638853`*^9}, {3.744545979899029*^9, 
  3.7445459803359137`*^9}, {3.7445460924900827`*^9, 3.744546092576473*^9}}],

