Cell["Zclose vs. width", "Subsection",
 CellChangeTimes->{{3.742215168005196*^9, 3.7422151731956043`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Scaledgammazc", "[", 
   RowBox[{"ic_", ",", "E1_", ",", "E2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"WidthData", ",", "i", ",", "nw"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WidthData", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"ARD", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], " ", "&&", 
           " ", 
           RowBox[{"E1", "<", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "<", "E2"}]}], ")"}], "&"}]}], 
       "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"AWDTrimmed", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], " ", ")"}], 
          "&"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nw", "=", 
      RowBox[{"Length", "[", "WidthData", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"WidthData", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "7"}], "]"}], "]"}], "/", 
          SqrtBox[
           RowBox[{"WidthData", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "5"}], "]"}], "]"}]]}], ",", 
         RowBox[{"WidthData", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "6"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nw"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
