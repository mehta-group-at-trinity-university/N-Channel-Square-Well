          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "hist", "]"}]}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nbin", "=", 
      RowBox[{"Length", "[", "hist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "tab1", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
