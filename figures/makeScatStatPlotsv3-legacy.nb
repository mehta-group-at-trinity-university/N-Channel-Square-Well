Cell[BoxData[
 RowBox[{
  RowBox[{"ChiSqr", "[", 
   RowBox[{"func_", ",", "hist_", ",", "p_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tab1", ",", "nbin", ",", "dbin", ",", "Ntot"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dbin", "=", 
      RowBox[{
       RowBox[{"hist", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
       RowBox[{"hist", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ntot", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"hist", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tab1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"hist", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"Ntot", "  ", "dbin", " ", 
             RowBox[{"func", "[", 
              RowBox[{
               RowBox[{"hist", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "p"}], "]"}]}]}],
            ")"}], "2"], 
         RowBox[{"Ntot", " ", "dbin", "  ", 
          RowBox[{"func", "[", 
           RowBox[{
            RowBox[{"hist", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "p"}], "]"}]}]], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "hist", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "p", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"p", "==", " ", "Null"}], ",", "\[IndentingNewLine]", 
       RowBox[{"tab1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          FractionBox[
           SuperscriptBox[
