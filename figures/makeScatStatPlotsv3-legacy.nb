Cell[BoxData[
 RowBox[{
  RowBox[{"Spoles", "[", 
   RowBox[{"ic_", ",", "E1_", ",", "E2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"WidthData", ",", "i", ",", "nw"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WidthData", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"ARD", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], " ", "&&", 
           " ", 
           RowBox[{"E1", "<", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "<", "E2"}]}], ")"}], "&"}]}], 
       "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"AWD", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], " ", ")"}], 
          "&"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nw", "=", 
      RowBox[{"Length", "[", "WidthData", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"WidthData", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "5"}], "]"}], "]"}], ",", 
         FractionBox[
          RowBox[{"WidthData", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "7"}], "]"}], "]"}], 
          SqrtBox[
           RowBox[{"WidthData", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "5"}], "]"}], "]"}]]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nw"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
