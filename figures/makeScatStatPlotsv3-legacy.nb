Cell[CellGroupData[{

Cell["What to expect for semi-poisson?", "Subsection",
 CellChangeTimes->{{3.743179799286852*^9, 3.743179810261674*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PBrody", "[", 
    RowBox[{"x_", ",", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "w"}], 
        RowBox[{"1", "+", "w"}]], "]"}], ")"}], 
     RowBox[{"1", "+", "w"}]], 
    SuperscriptBox["x", "w"], 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          FractionBox[
           RowBox[{"2", "+", "w"}], 
           RowBox[{"1", "+", "w"}]], "]"}], "x"}], ")"}], 
       RowBox[{"1", "+", "w"}]]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"BrodyDistribution", "=", 
  RowBox[{"ProbabilityDistribution", "[", 
   RowBox[{
    RowBox[{"PBrody", "[", 
     RowBox[{"x", ",", "w"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"w", ">", "0"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"FitError", "[", 
   RowBox[{"func_", ",", "list_", ",", "p_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tab1", ",", "nbin"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tab1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"func", "[", 
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "p"}], "]"}]}], 
          ")"}], "2"], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"p", "==", "Null"}], ",", "\[IndentingNewLine]", 
       RowBox[{"tab1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"func", "[", 
              RowBox[{"list", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], ")"}], "2"], 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"tab1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"func", "[", 
              RowBox[{
               RowBox[{"list", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "p"}], "]"}]}], 
            ")"}], "2"], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nbin", "=", 
      RowBox[{"Length", "[", "tab1", "]"}]}], ";", "\[IndentingNewLine]", 
     SqrtBox[
      FractionBox[
       RowBox[{"Total", "[", "tab1", "]"}], 
       RowBox[{"nbin", "-", "1"}]]]}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"SemiPoisson", "[", "s_", "]"}], ":=", 
  RowBox[{"4", " ", "s", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "s"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"porterthomas", "[", "x_", "]"}], ":=", 
  FractionBox[
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "x"}], "/", "2"}], "]"}], 
   SqrtBox[
    RowBox[{"2", "\[Pi]", " ", "x"}]]]}], "\n", 
 RowBox[{
  RowBox[{"genpt", "[", 
   RowBox[{"x_", ",", "\[Nu]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Nu]", "2"], "x"}], ")"}], 
     RowBox[{
      RowBox[{"\[Nu]", "/", "2"}], "-", "1"}]], 
    RowBox[{"Gamma", "[", 
     RowBox[{"\[Nu]", "/", "2"}], "]"}]], 
   FractionBox["\[Nu]", "2"], 
   RowBox[{"Exp", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "\[Nu]"}], "2"], "x"}], "]"}]}]}], "\n", 
 RowBox[{"GenPTDistribution", "=", 
  RowBox[{"ProbabilityDistribution", "[", 
   RowBox[{
    RowBox[{"genpt", "[", 
     RowBox[{"x", ",", "\[Nu]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"\[Nu]", ">", "0"}]}]}], "]"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.744380969419621*^9, 3.744380988516396*^9}}],

Cell[BoxData[
 RowBox[{"ProbabilityDistribution", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalX]", "w"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[FormalX]", " ", 
         RowBox[{"Gamma", "[", 
          FractionBox[
           RowBox[{"2", "+", "w"}], 
           RowBox[{"1", "+", "w"}]], "]"}]}], ")"}], 
       RowBox[{"1", "+", "w"}]]}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"2", "+", "w"}], 
       RowBox[{"1", "+", "w"}]], "]"}], 
     RowBox[{"1", "+", "w"}]]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[FormalX]", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"w", ">", "0"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.7443809892798147`*^9}],

Cell[BoxData[
 RowBox[{"ProbabilityDistribution", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "\[Nu]"}], "/", "2"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[FormalX]", " ", "\[Nu]"}], "2"]}]], " ", "\[Nu]", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[FormalX]", " ", "\[Nu]"}], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       FractionBox["\[Nu]", "2"]}]]}], 
    RowBox[{"Gamma", "[", 
     FractionBox["\[Nu]", "2"], "]"}]], ",", 
   RowBox[{"{", 
    RowBox[{"\[FormalX]", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"\[Nu]", ">", "0"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.744380989307315*^9}]
}, Open  ]],

Cell["\<\
If we sample the semi-poisson distribution, what Brody parameter do we \
expect, and with what standard error?\
\>", "Text",
 CellChangeTimes->{{3.743179812957426*^9, 3.743179839676024*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"cumsp", "[", "s_", "]"}], ":=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"4", "s", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], "s"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "0", ",", "s"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.743179845271131*^9, 3.743179880764538*^9}, {
  3.743180765347973*^9, 3.7431807677610693`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cumsp", "[", "s", "]"}]], "Input",
 CellChangeTimes->{{3.74318030235832*^9, 3.743180304127221*^9}}],

