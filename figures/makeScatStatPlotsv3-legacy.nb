Cell[BoxData[{
 RowBox[{
  RowBox[{"pSP", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      FractionBox["L", "2"], "+", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "L"}], "]"}]}], ")"}], "8"]}], ",", 
     RowBox[{"{", 
      RowBox[{"L", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dotted"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sig2Formula", "[", 
    RowBox[{"\[Beta]_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox["2", 
      RowBox[{"\[Beta]", " ", 
       SuperscriptBox["\[Pi]", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}], "+", "EulerGamma",
        "+", "1", "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}], "-", 
       RowBox[{"CosIntegral", "[", 
        RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}]}], ")"}]}], " ", 
    "+", " ", 
    RowBox[{"r", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["2", "\[Pi]"], 
        RowBox[{"SinIntegral", "[", 
         RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sig2GOE", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"Sig2Formula", "[", 
      RowBox[{"2.0", ",", "r"}], "]"}]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"SinIntegral", "[", 
        RowBox[{"\[Pi]", " ", "r"}], "]"}], "\[Pi]"], ")"}], "2"], "-", 
    RowBox[{
     FractionBox["1", "\[Pi]"], 
     RowBox[{"SinIntegral", "[", 
      RowBox[{"\[Pi]", " ", "r"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psigendcases", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sig2Formula", "[", 
        RowBox[{"0.001", ",", "r"}], "]"}], ",", 
       RowBox[{"Sig2GOE", "[", "r", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.7415400048566093`*^9, 3.741540079883584*^9}, {
