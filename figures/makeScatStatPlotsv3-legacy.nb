Cell[CellGroupData[{

Cell["Level Spacings with Mathematica", "Subsection",
 CellChangeTimes->{{3.743762013030389*^9, 3.743762019676791*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"genpt", "[", 
   RowBox[{"x_", ",", "\[Nu]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Nu]", "2"], "x"}], ")"}], 
     RowBox[{
      RowBox[{"\[Nu]", "/", "2"}], "-", "1"}]], 
    RowBox[{"Gamma", "[", 
     RowBox[{"\[Nu]", "/", "2"}], "]"}]], 
   FractionBox["\[Nu]", "2"], 
   RowBox[{"Exp", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "\[Nu]"}], "2"], "x"}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.744374097859569*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PBrody", "[", 
    RowBox[{"x_", ",", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "w"}], 
        RowBox[{"1", "+", "w"}]], "]"}], ")"}], 
     RowBox[{"1", "+", "w"}]], 
    SuperscriptBox["x", "w"], 
