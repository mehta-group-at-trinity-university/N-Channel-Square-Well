Cell["This seems to work very well. ", "Text",
 CellChangeTimes->{{3.733786641377063*^9, 3.733786643072357*^9}, {
  3.733935032834462*^9, 3.733935036559691*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s plot some potentials and energies with threshold \
offsets.  Let\[CloseCurlyQuote]s first just plot the square-well potential\
\>", "Text",
 CellChangeTimes->{{3.733793250719462*^9, 3.733793291712178*^9}}],

Cell[TextData[{
 "I\[CloseCurlyQuote]ll set the closed channel depth equal to something that \
gives a binding at around ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"100", " ", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"2", "\[Mu]", " ", 
       SubsuperscriptBox["r", "0", "2"]}]]}]}], TraditionalForm]]],
 ", then just shift the entire closed channel up and down to move the \
resonance position. "
}], "Text",
 CellChangeTimes->{{3.7339350413919773`*^9, 3.733935101604456*^9}, {
  3.733935144367141*^9, 3.733935175641555*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"B0", "=", "100"}], ";", 
  RowBox[{"vClosed", "=", 
   RowBox[{"v0Depth", "[", 
    RowBox[{"B0", ",", "1"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7339351787894506`*^9, 3.7339351993844433`*^9}, {
   3.733935825374784*^9, 3.733935832912915*^9}, 3.733963319835576*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Vfun", "[", 
   RowBox[{"r_", ",", "V0_", ",", "eth_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "V0"}], "+", "eth"}], ",", 
       RowBox[{"r", "<", "1"}]}], "}"}], ",", 
