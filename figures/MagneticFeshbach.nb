Cell["\<\
A magnetic Feshbach resonance is modeled by letting the position of the \
uncoupled bound states be:\
\>", "Text",
 CellChangeTimes->{{3.7340471316522617`*^9, 3.734047146382175*^9}, {
  3.73428133066623*^9, 3.734281347776515*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Epsilon]", "i"], "(", "B", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Epsilon]", "i"], "(", "0", ")"}], "+", 
    RowBox[{
     SubscriptBox["\[Alpha]", "i"], " ", "B"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.734047187489161*^9, 3.7340472226894817`*^9}, {
  3.7340472597838287`*^9, 3.734047294067088*^9}, {3.734267746952104*^9, 
  3.734267773264331*^9}}],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "i"], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[Epsilon]", "i"]}], 
     RowBox[{"\[PartialD]", "B"}]]}], TraditionalForm]]],
 " tuned to give the correct density of magnetic Feshbach resonances.  For \
simplicity let\[CloseCurlyQuote]s assume that ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]]],
 " is independent of ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "i"], "=", "\[Alpha]"}], TraditionalForm]]],
 ".  It ",
 StyleBox["should",
  FontSlant->"Italic"],
 " correspond to the slope of the Zeeman shift for these levels, since the \
density of states in each channel potential is only ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SubscriptBox["V", "0"]], TraditionalForm]]],
 " in our model, we must include many many more channels to reproduce the ."
}], "Text",
 CellChangeTimes->{{3.734047373719404*^9, 3.734047411846203*^9}, {
  3.7340474544192257`*^9, 3.734047517209248*^9}, {3.7342677753499002`*^9, 
  3.734267779340488*^9}, {3.7342678158694973`*^9, 3.734267887922633*^9}, {
  3.7342812751871233`*^9, 3.734281308178734*^9}}],

Cell["\<\
One immediate question is: are the resonance line-shapes different for the \
two resonances?  We are also interested in the effect of the open channel \
resonance. And what happens as the number of bound states increases?  Do the \
resonances become narrower or broader? \
\>", "Text",
 CellChangeTimes->{{3.7341336118834143`*^9, 3.734133615929863*^9}}],

Cell["Perhaps we should try a 3-channel model with", "Text",
 CellChangeTimes->{{3.73413361878926*^9, 3.734133629245912*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"V", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["V", "C1"]}], "+", 
        RowBox[{
         SubscriptBox["\[Epsilon]", "1"], "(", "B", ")"}]}], "0", 
       "\[Gamma]"},
      {"0", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["V", "C2"]}], "+", 
        RowBox[{
         SubscriptBox["\[Epsilon]", "2"], "(", "B", ")"}]}], "\[Gamma]"},
      {"\[Gamma]", "\[Gamma]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["V", "open"], "(", "B", ")"}]}]}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7341336329298077`*^9, 3.73413369818856*^9}, {
  3.734266313056583*^9, 3.734266313213402*^9}, {3.7342663926938066`*^9, 
  3.7342664922943287`*^9}, {3.734266546768194*^9, 3.734266564239015*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Epsilon]", "th"], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["\[Epsilon]", "1"], "(", "B", ")"}], 
       RowBox[{
        SubscriptBox["\[Epsilon]", "2"], "(", "B", ")"}], "0"}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7341336329298077`*^9, 3.73413369818856*^9}, {
  3.734266313056583*^9, 3.7342663261753798`*^9}, {3.734266394954879*^9, 
  3.734266437619184*^9}, {3.734266496072158*^9, 3.734266499165841*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now on to the magnetic Feshbach resonance...", "Subsection",
 CellChangeTimes->{{3.7337866475242662`*^9, 3.73378666622537*^9}, {
  3.733792665315137*^9, 3.733792668435483*^9}, {3.7337930411462584`*^9, 
  3.733793042223178*^9}}],

Cell[CellGroupData[{

Cell["Setup", "Subsubsection",
 CellChangeTimes->{{3.733793045638747*^9, 3.733793048278288*^9}}],

Cell["Solutions of just the diagonal operator are:", "Text",
 CellChangeTimes->{{3.703418110045464*^9, 3.703418134868466*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       FractionBox["1", "2"]}], ",", 
      RowBox[{"k", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7023181956761847`*^9, 3.702318255529701*^9}, {
  3.702318472957452*^9, 3.702318486560416*^9}, {3.7023185367232847`*^9, 
  3.702318554228112*^9}, {3.702319282766176*^9, 3.7023192852972527`*^9}, {
  3.7028544074561863`*^9, 3.702854440399633*^9}, {3.7029227268144617`*^9, 
  3.7029227288043547`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
       RowBox[{"BesselJ", "[", 
        RowBox[{
         RowBox[{"L", "+", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{"k", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7029226895450687`*^9, 3.7029227235156097`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
    RowBox[{"BesselY", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       FractionBox["1", "2"]}], ",", 
      RowBox[{"k", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.702854656410961*^9, 3.70285466632973*^9}, {
  3.702922751133884*^9, 3.7029227534518414`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dg", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
       RowBox[{"BesselY", "[", 
        RowBox[{
         RowBox[{"L", "+", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{"k", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.702922755520462*^9, 3.7029227886036*^9}}],

Cell["\<\
I\[CloseCurlyQuote]ll multiply the decaying function by a constant to rescale \
it for the strongly closed channels.\
\>", "Text",
 CellChangeTimes->{{3.703433719425181*^9, 3.703433737842691*^9}, 
   3.70351624809765*^9, 3.705282381172503*^9, {3.7337930834623003`*^9, 
   3.7337930844055767`*^9}, {3.733964047973168*^9, 3.733964050305986*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{
       FractionBox["2", "\[Pi]"], "\[Kappa]", " ", "r"}]], 
     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{"L", "+", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], 
     SuperscriptBox["\[ExponentialE]", 
