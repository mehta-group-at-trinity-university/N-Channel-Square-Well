Cell["\<\
Let\[CloseCurlyQuote]s define a function that will construct the diagonal \
part of the potential matrix and the thresholds.  \
\>", "Text",
 CellChangeTimes->{{3.734297771317482*^9, 3.734297821519046*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeVDiag", "[", 
   RowBox[{
   "NumChan_", ",", "NumOpen_", ",", "NumEven_", ",", "\[IndentingNewLine]", 
    "BClosedEven_", ",", "nClosedEven_", ",", "BClosedOdd_", ",", 
    "nClosedOdd_", ",", "\[IndentingNewLine]", "\[Epsilon]Open_", ",", 
    "nOpen_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "vClosedE", ",", "vClosedO", ",", "vOpen", ",", "vDiag", ",", 
      "\[Epsilon]th"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vClosedE", "=", 
      RowBox[{"v0Depth", "[", 
       RowBox[{"BClosedEven", ",", "nClosedEven"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vClosedO", "=", 
      RowBox[{"v0Depth", "[", 
       RowBox[{"BClosedOdd", ",", "nClosedOdd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vOpen", "=", 
      RowBox[{"v0Depth", "[", 
       RowBox[{
        RowBox[{"-", "\[Epsilon]Open"}], ",", "nOpen"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vDiag", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"i", "<=", "NumEven"}], ",", 
          RowBox[{
           RowBox[{"-", "vClosedE"}], "+", "BClosedEven"}], ",", 
          RowBox[{"NumEven", "<", "i", "\[LessEqual]", 
           RowBox[{"NumChan", "-", "1"}]}], ",", 
          RowBox[{
           RowBox[{"-", "vClosedO"}], "+", "BClosedOdd"}], ",", 
          RowBox[{"i", "\[Equal]", "NumChan"}], ",", 
          RowBox[{"-", "vOpen"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]th", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"i", "\[LessEqual]", "NumEven"}], ",", "BClosedEven", ",", 
          RowBox[{"NumEven", "<", "i", "\[LessEqual]", 
           RowBox[{"NumChan", "-", "1"}]}], ",", "BClosedOdd", ",", 
          RowBox[{"i", "\[Equal]", "NumChan"}], ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
