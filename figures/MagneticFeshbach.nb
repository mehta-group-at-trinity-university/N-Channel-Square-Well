Notebook[{
Cell["", "Text",
 CellChangeTimes->{{3.736463719242353*^9, 3.7364637228102818`*^9}}],

Cell[CellGroupData[{

Cell["Magnetic Feshbach resonance with square well model", "Section",
 CellChangeTimes->{{3.733671850557733*^9, 3.733671863562336*^9}}],

Cell["\<\
We now have an N-channel square well model coded up in \
\[OpenCurlyDoubleQuote]MyNchannelSqrWell?.nb\[CloseCurlyDoubleQuote]  Let\
\[CloseCurlyQuote]s start with a 2-channel model and rig-up a magnetic \
Feshbach resonance by mapping the channel separation (Zeeman splitting) to \
the magnetic field. \
\>", "Text",
 CellChangeTimes->{{3.7336718671658077`*^9, 3.73367189863363*^9}, {
  3.733672079108017*^9, 3.7336721009412518`*^9}, {3.733672220929462*^9, 
  3.7336722835117292`*^9}, {3.733699041257024*^9, 3.733699041259427*^9}}],

Cell[CellGroupData[{

Cell["Find an approximate function for the energy.", "Subsection",
 CellChangeTimes->{{3.7337620207416267`*^9, 3.73376202982065*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s start with the single-channel s-wave transcendental \
equation for the bound-state energy.\
\>", "Text",
 CellChangeTimes->{{3.7336718671658077`*^9, 3.73367189863363*^9}, {
  3.733672079108017*^9, 3.7336721009412518`*^9}, {3.733672220929462*^9, 
  3.7336722835117292`*^9}, {3.7336990416854897`*^9, 3.733699066350005*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"TEQ0", "[", 
   RowBox[{"r0_", ",", "v0_", ",", "\[Epsilon]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"r0", " ", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]]}], "]"}]}], "+", 
   RowBox[{
    SqrtBox[
     RowBox[{"-", "\[Epsilon]"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"r0", " ", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.706376417516831*^9, 3.706376450338232*^9}}],

Cell["When the energy is zero,", "Text",
 CellChangeTimes->{{3.706406044659027*^9, 3.7064060488040524`*^9}, {
  3.729382995685349*^9, 3.729382996796825*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "[", 
  RowBox[{"1", ",", "v0", ",", "0"}], "]"}]], "Input",
 CellChangeTimes->{{3.706406050614011*^9, 3.7064060609251337`*^9}}],

Cell[BoxData[
 RowBox[{
  SqrtBox["v0"], " ", 
  RowBox[{"Cos", "[", 
   SqrtBox["v0"], "]"}]}]], "Output",
 CellChangeTimes->{{3.706406058135435*^9, 3.706406061362792*^9}, 
   3.706437964505143*^9, 3.706487192484247*^9, 3.7293829988461514`*^9, 
   3.7336990755166473`*^9, 3.7342895381987143`*^9, 3.734348609740273*^9, 
   3.734348728064743*^9, 3.734372835890648*^9, 3.734719335254512*^9, 
   3.734970300432849*^9, 3.736253221862008*^9, 3.736253266522501*^9, 
   3.7362533676425457`*^9, 3.7362534712052193`*^9}]
}, Open  ]],

Cell[TextData[{
 "suggests ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      SubscriptBox["v", "0"]], "=", 
     RowBox[{
      FractionBox["1", "2"], "\[Pi]"}]}], ",", " ", 
    RowBox[{
     FractionBox["3", "2"], "\[Pi]"}], ",", "..."}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.706406083969327*^9, 3.7064061512607393`*^9}}],

Cell[TextData[{
 "so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"n", "+", 
        FractionBox["1", "2"]}], ")"}], "2"], 
     SuperscriptBox["\[Pi]", "2"]}]}], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", "1", ",", "2", ",", "..."}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.706406083969327*^9, 3.7064061679582987`*^9}, {
  3.70640678057661*^9, 3.706406818006267*^9}, {3.706437790639159*^9, 
  3.706437795204452*^9}}],

Cell[TextData[{
 "Solving this for ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " gives the approximate number of bound states as a function of the depth ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.7064064277259407`*^9, 3.7064064792155523`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"n", "=", 
   RowBox[{
    FractionBox[
     SqrtBox[
      SubscriptBox["v", "0"]], "\[Pi]"], "-", 
    FractionBox["1", "2"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.706406482673071*^9, 3.706406519573653*^9}}],

Cell[TextData[{
 "The number of bound states is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.70640702130394*^9, 3.706407033701193*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Floor", "[", 
     RowBox[{
      FractionBox[
       SqrtBox["v0"], "\[Pi]"], "+", 
      FractionBox["1", "2"]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0", ",", "0", ",", "500"}], "}"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SubscriptBox[\(V\), \(0\)]\)/(\!\(\*SuperscriptBox[\(\[HBar]\
\), \(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\"", ",", 
       "\"\<# of bound states\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", "Large"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.7064065275269527`*^9, 3.7064065534895906`*^9}, {
   3.706406647285573*^9, 3.706406657103909*^9}, {3.706406717858857*^9, 
   3.706406754468498*^9}, {3.7064070368962708`*^9, 3.7064070393514633`*^9}, {
   3.706437179219944*^9, 3.7064372612722883`*^9}, 3.734432735069098*^9}],

Cell[TextData[{
 "This is quite useful because we can immediately estimate the total density \
of states for an ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]]],
 "-channel problem by noting that the total number of bound states in the \
uncoupled limit is:"
}], "Text",
 CellChangeTimes->{{3.706407097773615*^9, 3.706407166769493*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["n", "tot"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["V", 
         RowBox[{"i", " ", "i"}]], "+", 
        SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "\[Pi]"], "+", 
      FractionBox["1", "2"]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
  3.706407269179851*^9, 3.70640728058729*^9}, {3.706437320044181*^9, 
  3.70643732005888*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Rho]", "=", 
   FractionBox["1", 
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["V", 
          RowBox[{"i", " ", "i"}]], "+", 
         SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "\[Pi]"], "+", 
       FractionBox["1", "2"]}], ")"}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
  3.706407269179851*^9, 3.70640728058729*^9}, {3.706437320044181*^9, 
  3.706437340582612*^9}}],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"i", " ", "i"}]], "+", 
     SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "=", 
    SubscriptBox["D", "i"]}], TraditionalForm]],
  CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
   3.706407269179851*^9, 3.70640728058729*^9}}],
 " is the total depth of the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 "th channel."
}], "Text",
 CellChangeTimes->{{3.706407293248767*^9, 3.706407384422244*^9}, {
  3.706407452695809*^9, 3.706407454423995*^9}, {3.706437310775002*^9, 
  3.706437317028542*^9}}],

Cell["\<\
The energies may be easily plotted as a contour plot.  And compared to the \
approximate energies from the infinite square well:\
\>", "Text",
 CellChangeTimes->{{3.7064025894041224`*^9, 3.706402599046376*^9}, {
  3.706403191799199*^9, 3.706403207950688*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Mu]"}], 
       SuperscriptBox["\[HBar]", "2"]], 
      RowBox[{"(", 
       RowBox[{"E", "+", 
        SubscriptBox["V", "0"]}], ")"}]}]], " ", 
    SubscriptBox["r", "0"]}], "=", 
   RowBox[{"n", " ", "\[Pi]"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.706403226390329*^9, {3.7064032588689013`*^9, 3.706403259068685*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Epsilon]", " ", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "2"], " ", 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    SubscriptBox["v", "0"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7064032412557707`*^9, 3.7064032647403727`*^9}, {
  3.706403295225522*^9, 3.706403311513691*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
    RowBox[{"n", " ", "\[Pi]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.706404859658216*^9, 3.7064048778316593`*^9}, {
  3.706438021237844*^9, 3.706438032555088*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", "\[Pi]"}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"2", " ", "\[Pi]"}]}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"3", " ", "\[Pi]"}]}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"4", " ", "\[Pi]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.7064048600639477`*^9, 3.706404878248433*^9}, 
   3.706405365154366*^9, 3.706438035364337*^9, 3.706487208789798*^9, 
   3.729383006849658*^9, 3.7336991142249928`*^9, 3.734289548050461*^9, 
   3.734348624519517*^9, 3.734348737160205*^9, 3.734372844405675*^9, 
   3.734719335412135*^9, 3.736253372858212*^9, 3.7362534713741426`*^9}]
}, Open  ]],

Cell[TextData[{
 "A ",
 StyleBox["lower bound",
  FontSlant->"Italic"],
 " is found by setting the phase accumulated inside the well to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    RowBox[{
     RowBox[{"n", " ", "\[Pi]"}], "-", 
     RowBox[{"\[Pi]", "/", "2"}]}]}], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "1"}], ",", "2", ",", 
    RowBox[{"3", "..."}]}], TraditionalForm]]],
 ". This estimate gives the exact energy only for those states with \
eigen-energy equal to zero, so that an odd multiple of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "2"}], TraditionalForm]]],
 " phase is accumulated inside the well, and there is an infinitely long \
exponential tail outside the well (since ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Rule]", "\[Infinity]"}], TraditionalForm]]],
 ").  As the state becomes more deeply bound, more an more of the \
wavefunction is drawn into the well and the exponential tail shrinks.  The \
additional confinement can only raise the energy."
}], "Text",
 CellChangeTimes->{{3.729449184309001*^9, 3.729449523607942*^9}, {
  3.733699152462928*^9, 3.733699169191783*^9}}],

Cell[TextData[{
 "An ",
 StyleBox["upper bound",
  FontSlant->"Italic"],
 " is provided by the condition that the exponential tail has shrunk to zero \
so that we have an approximation to the infinite square well: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    RowBox[{"n", " ", "\[Pi]"}]}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.729449184309001*^9, 3.7294495905266027`*^9}}],

Cell[TextData[{
 "At threshold, the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]]],
 " values corresponding to a zero-energy state are:"
}], "Text",
 CellChangeTimes->{{3.733699350975312*^9, 3.733699354484211*^9}, {
  3.733699542989048*^9, 3.7336995589755507`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["v", "0"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"n", "+", 
       FractionBox["1", "2"]}], ")"}], "2"], 
    SuperscriptBox["\[Pi]", "2"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.733699350975312*^9, 3.733699354484211*^9}, {
  3.733699542989048*^9, 3.733699560219095*^9}}],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", "1", ",", "2", ",", "..."}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.733699744860108*^9, 3.733699744862926*^9}}],

Cell[TextData[{
 "The slope of the ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]]],
 " vs. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]]],
 " asymptotically must approach ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", "\[Epsilon]"}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox["v", "0"]}]], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]]],
 ".  Let\[CloseCurlyQuote]s use instead the binding energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"|", "\[Epsilon]", "|"}]}], TraditionalForm]]],
 ".  "
}], "Text",
 CellChangeTimes->{{3.733700022675025*^9, 3.733700106880102*^9}, {
   3.733700154254034*^9, 3.733700157388176*^9}, 3.733700225273971*^9, {
   3.733701212294037*^9, 3.733701260900338*^9}, {3.73370148739041*^9, 
   3.7337015205390873`*^9}, {3.733742753036079*^9, 3.733742774641024*^9}, 
   3.733742834905908*^9}],

Cell[TextData[{
 "We deduce that the exact energy for the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 "th state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"m", "=", "1"}], ",", "2", ",", 
     RowBox[{"3", "..."}]}]}], TraditionalForm]]],
 ") must be bounded by the lines:"
}], "Text",
 CellChangeTimes->{{3.733743168203267*^9, 3.733743203644114*^9}, {
  3.733743241132545*^9, 3.733743255090497*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Epsilon]", "lower"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"m", "-", 
        FractionBox["1", "2"]}], ")"}], "2"], 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    SubscriptBox["v", "0"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.733743208291211*^9, 3.733743218681013*^9}, {
  3.733743262124909*^9, 3.733743293868565*^9}, {3.733743452518808*^9, 
  3.73374345636243*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]lower", "[", 
   RowBox[{"m_", ",", "v0_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"m", "-", 
       FractionBox["1", "2"]}], ")"}], "2"], 
    SuperscriptBox["\[Pi]", "2"]}], "-", "v0"}]}]], "Input",
 CellChangeTimes->{{3.73374353027477*^9, 3.733743555416512*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Epsilon]", "upper"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["m", "2"], 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    SubscriptBox["v", "0"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.733743208291211*^9, 3.733743218681013*^9}, {
  3.733743262124909*^9, 3.733743293868565*^9}, {3.733743452518808*^9, 
  3.733743474799046*^9}, {3.733743837962563*^9, 3.733743841415593*^9}, {
  3.734372850068129*^9, 3.734372852315737*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]upper", "[", 
   RowBox[{"m_", ",", "v0_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SuperscriptBox["m", "2"], 
    SuperscriptBox["\[Pi]", "2"]}], "-", "v0"}]}]], "Input",
 CellChangeTimes->{{3.733743563149967*^9, 3.733743568655751*^9}, {
  3.7337438478735247`*^9, 3.733743850064616*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"m", "=", "1"}], ";", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TEQ0", "[", 
       RowBox[{"1", ",", "vtest", ",", 
        RowBox[{"\[Epsilon]lower", "[", 
         RowBox[{"m", ",", "vtest"}], "]"}]}], "]"}], ",", 
      RowBox[{"TEQ0", "[", 
       RowBox[{"1", ",", "vtest", ",", 
        RowBox[{"\[Epsilon]upper", "[", 
         RowBox[{"m", ",", "vtest"}], "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"vtest", ",", "0", ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Black", ",", "Red"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.734475500278453*^9, 3.734475530254813*^9}, {
  3.734475563717183*^9, 3.734475567442813*^9}, {3.734475633651773*^9, 
