Cell[CellGroupData[{

Cell["How to set up the potential...", "Subsection",
 CellChangeTimes->{{3.733785347917088*^9, 3.733785370408987*^9}, {
  3.7337928304655523`*^9, 3.7337928497347918`*^9}, {3.7340477308143253`*^9, 
  3.734047751832366*^9}}],

Cell["\<\
In order to construct a model more easily, I\[CloseCurlyQuote]d like to \
create a function that simply returns the value of the potential depth needed \
to place an energy at a particular place. \
\>", "Text",
 CellChangeTimes->{{3.733785372333713*^9, 3.7337854409843616`*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s assume we\[CloseCurlyQuote]re talking about the ground \
state.  Then using the average of the lower and upper bound as a starting \
point for the root-finder, we have:\
\>", "Text",
 CellChangeTimes->{{3.7337854621486187`*^9, 3.733785496813443*^9}, {
  3.733785595352903*^9, 3.733785627696176*^9}, {3.733786576955572*^9, 
  3.733786605434771*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "[", 
  RowBox[{"1", ",", "v0", ",", "\[Epsilon]"}], "]"}]], "Input",
 CellChangeTimes->{3.73379292639289*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
   RowBox[{"Cos", "[", 
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"-", "\[Epsilon]"}]], " ", 
   RowBox[{"Sin", "[", 
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.733792949646202*^9, 3.733934851849638*^9, 3.7342895683920116`*^9, 
   3.734348641684833*^9, 3.7343487540853357`*^9, 3.734372861470611*^9, 
   3.7347193360896397`*^9, {3.734734156635047*^9, 3.734734167153524*^9}, 
   3.7349703197368107`*^9, {3.7362532414786*^9, 3.736253274015317*^9}, 
   3.736253386794808*^9, 3.736253472150688*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FortranForm", "[", 
  RowBox[{"Simplify", "[", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"TEQ0", "[", 
      RowBox[{"1", ",", "v0", ",", "energy"}], "]"}], ",", "energy"}], "]"}], 
   "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.73473412800069*^9, 3.734734146504505*^9}, {
  3.7347341843918*^9, 3.734734195461444*^9}, {3.7347347779181623`*^9, 
  3.734734781411524*^9}}],

Cell["\<\
((Sqrt(-energy) - energy)*Cos(Sqrt(energy + v0)) - (1 + \
Sqrt(-energy))*Sqrt(energy + v0)*Sin(Sqrt(energy + \
v0)))/(2.*Sqrt(-energy)*Sqrt(energy + v0))\
\>", "Output",
 CellChangeTimes->{{3.734734146914103*^9, 3.734734196878944*^9}, 
   3.734734782004755*^9, 3.7349703216894712`*^9, {3.736253243821927*^9, 
   3.7362532751294613`*^9}, 3.736253388728183*^9, 3.7362534724790487`*^9}]
}, Open  ]],

Cell[TextData[{
 "Determine the potential depth that yields the nth state with binding energy \
",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.733876492870809*^9, 3.733876519882769*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"v0Depth", "[", 
   RowBox[{"B_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"v0", "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"v0", "-", "B"}]], " ", 
        RowBox[{"Cos", "[", 
         SqrtBox[
          RowBox[{"v0", "-", "B"}]], "]"}]}], "+", 
       RowBox[{
        SqrtBox["B"], " ", 
        RowBox[{"Sin", "[", 
         SqrtBox[
          RowBox[{"v0", "-", "B"}]], "]"}]}]}], "\[Equal]", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"v0", ",", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"n", "-", 
               FractionBox["1", "2"]}], ")"}], "2"], "+", 
            SuperscriptBox["n", "2"]}], ")"}], "2"], 
         SuperscriptBox["\[Pi]", "2"]}], "+", "B"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.733785512137014*^9, 3.733785567432342*^9}, {
   3.733785816721085*^9, 3.733785952585648*^9}, {3.733786325580361*^9, 
   3.7337863398025312`*^9}, {3.733786382848216*^9, 3.7337864021555567`*^9}, 
   3.733792932528368*^9, {3.7338753431670237`*^9, 3.733875345004496*^9}, {
   3.7338753972378693`*^9, 3.733875425146895*^9}, {3.73387568729599*^9, 
   3.733875687384193*^9}, {3.7338763388910637`*^9, 3.733876357726182*^9}, {
   3.73387646441087*^9, 3.733876489201785*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Energy", "[", 
   RowBox[{"v0_", ",", "n_", ",", "\[Epsilon]th_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Epsilon]", "+", "\[Epsilon]th"}], "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
        RowBox[{"Cos", "[", 
         SqrtBox[
          RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}], "+", 
       RowBox[{
        SqrtBox[
         RowBox[{"-", "\[Epsilon]"}]], " ", 
        RowBox[{"Sin", "[", 
         SqrtBox[
          RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}], "\[Equal]", "0"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"n", "-", 
               FractionBox["1", "2"]}], ")"}], "2"], "+", 
            SuperscriptBox["n", "2"]}], ")"}], "2"], 
         SuperscriptBox["\[Pi]", "2"]}], "-", "v0"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.733962393646541*^9, 3.7339624425436163`*^9}, {
  3.7339624818917227`*^9, 3.7339625275240192`*^9}, {3.733962601135757*^9, 
  3.733962625600564*^9}}],

Cell[CellGroupData[{

