   3.701350270021366*^9, 3.702338352524465*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"SolInfo", "[", 
   RowBox[{
   "v1_", ",", "v2_", ",", "g_", ",", "\[Epsilon]_", ",", "\[Epsilon]2_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v1"}], ")"}], "g"},
        {"g", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v2", "-", "\[Epsilon]2"}], ")"}]}
       }], ")"}]}], ";", 
    RowBox[{"Avals", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Phi]mat", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a1", " ", 
          RowBox[{"\[Psi]In", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "1", "]"}], "]"}]], " ", "r"}]}], "]"}]}]},
        {
         RowBox[{"a2", " ", 
          RowBox[{"\[Psi]In", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "2", "]"}], "]"}]], " ", "r"}]}], "]"}]}]}
       }], ")"}]}], ";", 
    RowBox[{"AvecsNormed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               RowBox[{"\[Psi]SOut", "[", 
                RowBox[{"L", ",", 
                 RowBox[{
                  SqrtBox["\[Epsilon]"], "r"}]}], "]"}], " "}]},
             {
              RowBox[{"b2", " ", 
               RowBox[{"\[Psi]BOut", "[", 
                RowBox[{"L", ",", 
                 RowBox[{
                  SqrtBox[
                   RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                "]"}]}]}
            }], ")"}]}], ",", 
         RowBox[{
          RowBox[{"AvecsNormed", ".", 
           RowBox[{"D", "[", 
            RowBox[{"\[Phi]mat", ",", "r"}], "]"}]}], "\[Equal]", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"(", GridBox[{
               {
                RowBox[{
                 RowBox[{"\[Psi]SOut", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox["\[Epsilon]"], "r"}]}], "]"}], " "}]},
               {
                RowBox[{"b2", " ", 
                 RowBox[{"\[Psi]BOut", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    SqrtBox[
                    RowBox[{"\[Epsilon]2", "-", "\[Epsilon]"}]], "r"}]}], 
                  "]"}]}]}
              }], ")"}], ",", "r"}], "]"}]}]}], "}"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"L", "\[Rule]", "0"}], ",", 
         RowBox[{"r", "\[Rule]", "1"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a1", ",", "a2", ",", "b2", ",", "Kmat"}], "}"}]}], "]"}]}], 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.70259403839172*^9, 3.702594063823073*^9}, {
  3.702853991283902*^9, 3.7028540040107117`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", "a1", "]"}], "/.", 
    RowBox[{"SolInfo", "[", 
     RowBox[{
     "0.0", ",", "10.0", ",", "0.1", ",", ".000001", ",", "\[Epsilon]2"}], 
     "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]2", ",", "4.6", ",", "4.7"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Red", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
