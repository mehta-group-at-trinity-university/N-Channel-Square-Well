 Cell[BoxData[
  FormBox[
   StyleBox["A",
    FontWeight->"Bold"], TraditionalForm]]],
 " is a ",
 StyleBox["constant ",
  FontSlant->"Italic"],
 "matrix (independent of ",
 Cell[BoxData[
