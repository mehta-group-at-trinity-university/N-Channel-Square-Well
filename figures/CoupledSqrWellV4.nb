Cell["\<\
Define an orthogonal matrix comprised of normalized eigenvectors in the \
columns of the matrix.  Mathematica puts eigenvectors in the rows, so I\
\[CloseCurlyQuote]ll define this as the transpose of the output of \
\[OpenCurlyDoubleQuote]Eigenvectors\[CloseCurlyDoubleQuote] above:\
\>", "Text",
 CellChangeTimes->{{3.691541379569765*^9, 3.691541458673847*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AvecsNormed", "=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{"Avecs", "[", 
         RowBox[{"[", "n", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Assumptions", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Epsilon]", "\[Element]", "Reals"}], ",", 
          RowBox[{"v1", ">", "0"}], ",", 
          RowBox[{"v2", ">", "0"}], ",", 
          RowBox[{"\[Epsilon]2", ">", "0"}], ",", 
          RowBox[{"g", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}]], "Input",
