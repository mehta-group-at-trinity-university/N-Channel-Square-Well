            RowBox[{"L", ",", 
             RowBox[{
              SqrtBox[
               RowBox[{"\[Epsilon]", "+", "v0"}]], " ", "r"}]}], "]"}], "]"}],
           ",", "r"}], "]"}], "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"\[Psi]BOut", "[", 
            RowBox[{"L", ",", 
             RowBox[{
              SqrtBox[
               RowBox[{"-", "\[Epsilon]"}]], " ", "r"}]}], "]"}], "]"}], ",", 
          "r"}], "]"}]}], ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "\[Rule]", "1"}], ",", 
       RowBox[{"r", "\[Rule]", "1"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693248994419087*^9, 3.693249022960253*^9}, {
   3.693249147578043*^9, 3.693249150127239*^9}, {3.693249182023652*^9, 
