Cell["For d-waves,", "Text",
 CellChangeTimes->{{3.693699601504759*^9, 3.693699604065412*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ2", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         SqrtBox[
          RowBox[{"-", "\[Epsilon]"}]]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "+", 
           SqrtBox[
            RowBox[{"-", "\[Epsilon]"}]]}], ")"}], " ", "\[Epsilon]"}]}], 
       ")"}], " ", 
      RowBox[{"(", 
