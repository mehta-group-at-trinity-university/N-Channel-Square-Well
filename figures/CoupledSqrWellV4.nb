 "), and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["H", "0"],
    FontWeight->"Bold"], TraditionalForm]]],
 " is diagonal, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
