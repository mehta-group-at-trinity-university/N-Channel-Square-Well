  3.7023179781035433`*^9, 3.70231800889008*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "x", "]"}], "+", 
     RowBox[{"1", 
