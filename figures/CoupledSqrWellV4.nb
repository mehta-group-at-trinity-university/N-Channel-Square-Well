Cell[TextData[{
 "Let\[CloseCurlyQuote]s make this easier to handle by multiplying through by \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"sin", "(", 
    SqrtBox[
     RowBox[{"\[Epsilon]", "+", 
      SubscriptBox["v", "0"]}]], ")"}], TraditionalForm]]],
 " (it\[CloseCurlyQuote]s all equal to zero anyhow, so this doesn\
\[CloseCurlyQuote]t change the position of the roots.)"
}], "Text",
 CellChangeTimes->{{3.693250554885047*^9, 3.6932505906618643`*^9}, {
  3.693699439528891*^9, 3.693699441905134*^9}}],

Cell["For s-waves:", "Text",
 CellChangeTimes->{{3.693525710238262*^9, 3.693525717359888*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"\[Epsilon]", "+", "v0"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"\[Psi]In", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"\[Epsilon]", "+", "v0"}]], " ", "r"}]}], "]"}], "]"}], 
         ",", "r"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"\[Psi]BOut", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"-", "\[Epsilon]"}]], " ", "r"}]}], "]"}], "]"}], ",", 
         "r"}], "]"}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "\[Rule]", "0"}], ",", 
      RowBox[{"r", "\[Rule]", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693250594646847*^9, 3.6932506485730143`*^9}, {
  3.693699409392538*^9, 3.693699432173963*^9}, {3.702316706356161*^9, 
  3.702316708883093*^9}, {3.702319408721799*^9, 3.702319420182884*^9}}],

Cell[BoxData[
 RowBox[{
