     FontWeight->"Bold"], " ", 
    StyleBox["A",
     FontWeight->"Bold"]}], "=", 
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691506438060916*^9, 3.6915064899813423`*^9}, {
  3.691540139994213*^9, 3.691540148601808*^9}}],

Cell[TextData[{
 "Where ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"], TraditionalForm]]],
 " is a diagonal matrix with the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   StyleBox["W",
    FontWeight->"Bold"], TraditionalForm]]],
 ".  We have in region I:"
}], "Text",
 CellChangeTimes->{{3.691540331320681*^9, 3.691540373915174*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", "(", 
              RowBox[{"L", "+", "1"}], ")"}], 
             RowBox[{" ", 
              SuperscriptBox["r", "2"]}]]}]}], "0"},
         {"0", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", "(", 
              RowBox[{"L", "+", "1"}], ")"}], 
             RowBox[{" ", 
              SuperscriptBox["r", "2"]}]]}]}]}
        }], ")"}], "+", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "1"]}], ")"}], "g"},
         {"g", 
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "+", 
            SubscriptBox["v", "2"], "-", 
            SubscriptBox["\[Epsilon]", "2"]}], ")"}]}
        }], ")"}]}], "]"}], 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Psi]", "1", "I"]},
       {
        RowBox[{" ", 
         SubsuperscriptBox["\[Psi]", "2", "I"]}]}
      }], ")"}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.691506434252818*^9, 3.691540179737887*^9, {3.691542291173915*^9, 
   3.691542306891548*^9}, {3.691940612475456*^9, 3.69194064231033*^9}, {
