Notebook[{
Cell["", "Text",
 CellChangeTimes->{{3.692452374626791*^9, 3.692452375839117*^9}}],

Cell[CellGroupData[{

Cell["Coupled square well scattering and bound states", "Title",
 CellChangeTimes->{{3.691192381712702*^9, 3.691192391380272*^9}, {
  3.6915360359596577`*^9, 3.691536037733398*^9}}],

Cell["A \[OpenCurlyDoubleQuote]simple\[CloseCurlyDoubleQuote] multichannel \
model", "Subtitle",
 CellChangeTimes->{{3.691192392150342*^9, 3.691192404821622*^9}}],

Cell[CellGroupData[{

Cell["1-channel square well", "Section",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137821837714*^9}}],

Cell[TextData[{
 "As a preliminary to the multichannel case, we will need to solve the single \
channel case to understand where the bound states are with respect to the \
threshold.  This will help us interpret the two-channel resonances, at least \
in the weak coupling regime.  Inside the well of range ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", the radial wavefunction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "r", ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " satisfies:"
}], "Text",
 CellChangeTimes->{{3.692137809394552*^9, 3.692137929269053*^9}, {
  3.692282786010167*^9, 3.692282798297591*^9}, {3.693247648593514*^9, 
  3.693247653543399*^9}, {3.702314561705797*^9, 3.702314570270965*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["\[HBar]", "2"]}], 
        RowBox[{"2", "\[Mu]"}]], 
       FractionBox["1", 
        SuperscriptBox["r", "2"]], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        SuperscriptBox["r", "2"]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], 
        RowBox[{"+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["V", "0"]}], "-", "E"}], ")"}]}]}]}], "+", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], " ", 
    RowBox[{"R", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702314610632531*^9, 3.702314657920128*^9}}],

Cell[TextData[{
 "We let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "(", "r", ")"}], "=", 
    RowBox[{"r", " ", 
     RowBox[{"R", "(", "r", ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"]
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["\[HBar]", "2"]}], 
        RowBox[{"2", "\[Mu]"}]], 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["V", "0"]}], "-", "E"}], ")"}]}]}]}], "+", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702314672989156*^9, 3.702314698629549*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "+", 
         SubscriptBox["V", "0"]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"L", "(", 
        RowBox[{"L", "+", "1"}], ")"}], 
       RowBox[{" ", 
        SuperscriptBox["r", "2"]}]]}], ")"}], " ", 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.692137942615315*^9, 3.692138038069057*^9}, {
  3.693699217056481*^9, 3.69369923706916*^9}, {3.7023145518842688`*^9, 
  3.702314554166671*^9}, {3.702314710983982*^9, 3.702314723718965*^9}}],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], "E"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", 
    FractionBox[
     RowBox[{"2", "\[Mu]", " ", 
      SubsuperscriptBox["r", "0", "2"], 
      SubscriptBox["V", "0"]}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]]],
 ".  Also RESCALE ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]]],
 ".  Then"
}], "Text",
 CellChangeTimes->{{3.692282700363286*^9, 3.692282744588562*^9}, {
  3.693248576840211*^9, 3.693248624217347*^9}, {3.693698939880719*^9, 
