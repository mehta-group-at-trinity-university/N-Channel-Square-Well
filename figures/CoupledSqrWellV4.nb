}, Open  ]],

Cell[TextData[{
 "For purposes of root-finding, we\[CloseCurlyQuote]ll need to make a guess \
as to where the roots are.  Since we know the solutions in the interior \
region are simply Bessel functions, we can find approximate positions of the \
roots by treating the finite well like an infinite well and using the known \
zeroes of the Bessel function.  The additional \[OpenCurlyDoubleQuote]fudge \
factor\[CloseCurlyDoubleQuote] of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"], TraditionalForm]]],
 " seems to work well in correcting the high-lying states."
}], "Text",
 CellChangeTimes->{{3.693525760843252*^9, 3.693525863769813*^9}, {
  3.702316768639798*^9, 3.7023167792633677`*^9}, {3.7023175464637527`*^9, 
  3.7023175466850777`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Vmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rootguess0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "Vmax"}], " ", "+", 
        SuperscriptBox[
         RowBox[{"N", "[", 
          RowBox[{"BesselJZero", "[", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}], ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"rootguess0", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"TEQ0", "/.", 
      RowBox[{"v0", "\[Rule]", "Vmax"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", 
       RowBox[{"-", "Vmax"}], ",", "0"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], ";", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p2", ",", "p3"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Vmax"}], ",", "0"}], "}"}], ",", "All"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"GridLines", "\[Rule]", "Automatic"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.693489621101309*^9, 3.6934896883477173`*^9}, {
   3.693489895692281*^9, 3.693490248640182*^9}, {3.693490296358223*^9, 
   3.69349030020483*^9}, {3.6934903883405647`*^9, 3.69349055046262*^9}, {
