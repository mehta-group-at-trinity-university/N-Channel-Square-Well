     RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"-", "\[Epsilon]"}]], " ", 
   RowBox[{"Sin", "[", 
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}]], "Output",
