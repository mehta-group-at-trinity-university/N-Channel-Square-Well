}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ascat", "[", 
   RowBox[{
   "v1_", ",", "v2_", ",", "g_", ",", "\[Epsilon]_", ",", "\[Epsilon]2_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v1"}], ")"}], "g"},
        {"g", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "+", "v2", "-", "\[Epsilon]2"}], ")"}]}
       }], ")"}]}], ";", 
    RowBox[{"Avals", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "W", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Phi]mat", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a1", " ", 
          RowBox[{"\[Psi]In", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "1", "]"}], "]"}]], " ", "r"}]}], "]"}]}]},
        {
         RowBox[{"a2", " ", 
          RowBox[{"\[Psi]In", "[", 
           RowBox[{"L", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"Avals", "[", 
               RowBox[{"[", "2", "]"}], "]"}]], " ", "r"}]}], "]"}]}]}
       }], ")"}]}], ";", 
    RowBox[{"AvecsNormed", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "W", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "Kmat"}], "/", 
      SqrtBox["\[Epsilon]"]}], "/.", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"AvecsNormed", ".", "\[Phi]mat"}], "\[Equal]", 
            RowBox[{"(", GridBox[{
               {
                RowBox[{
                 RowBox[{"\[Psi]SOut", "[", 
                  RowBox[{"L", ",", 
