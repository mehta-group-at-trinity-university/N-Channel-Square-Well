  RowBox[{"Vmax", "=", "1000"}], ";", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"VV", ",", 
        RowBox[{"\[Epsilon]", "/.", 
