              SqrtBox[
               RowBox[{"\[Epsilon]", "+", "v0"}]], " ", "r"}]}], "]"}], "]"}],
           ",", "r"}], "]"}], "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"\[Psi]BOut", "[", 
