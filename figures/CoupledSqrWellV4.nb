Cell["\<\
Okay, there are some numerical quirks that need to be worked out here, and \
the code is clunky to be sure, but more or less this is right.  \
\>", "Text",
 CellChangeTimes->{{3.693700079943727*^9, 3.693700094850073*^9}, {
  3.6937031665364428`*^9, 3.6937031744866533`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["2-channel model", "Section",
 CellChangeTimes->{{3.693700109024497*^9, 3.69370011503261*^9}}],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s work through the two-channel physics before trying N \
channels.  In the ",
 StyleBox["interior",
  FontSlant->"Italic"],
 " region,"
}], "Text",
 CellChangeTimes->{{3.693700119210544*^9, 3.6937001306955757`*^9}, {
  3.693700166652358*^9, 3.693700172636544*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "1"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}], 
        SubscriptBox["V", "12"]},
       {
        SubscriptBox["V", "12"], 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox["\[HBar]", "2"]}], 
           RowBox[{"2", "\[Mu]"}]], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            RowBox[{
             SubscriptBox["V", "2"], "(", "r", ")"}]}]}]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], 
           RowBox[{"L", "(", 
            RowBox[{"L", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "1"]}]},
       {
        RowBox[{" ", 
         SubscriptBox["\[Psi]", "2"]}]}
      }], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["\[Psi]", "1"]},
       {
        SubscriptBox["\[Psi]", "2"]}
      }], ")"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.693700116402718*^9, 3.693700163701606*^9}, {
  3.702321514647252*^9, 3.702321519069659*^9}}],

Cell["Choose:", "Text",
 CellChangeTimes->{{3.6915361976816*^9, 3.691536199854644*^9}, 
   3.691536252013687*^9}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "1"], "(", "r", ")"}], "=", 
   RowBox[{"{", 
    RowBox[{GridBox[{
       {
        RowBox[{"-", 
         SubscriptBox["V", "1"]}]},
       {
        RowBox[{"0", "        "}]}
      }], GridBox[{
       {
        RowBox[{" ", 
         RowBox[{
          RowBox[{"for", "  ", "r"}], "<", 
          SubscriptBox["r", "0"]}]}]},
       {
        RowBox[{
         RowBox[{"for", " ", "r"}], ">", 
         SubscriptBox["r", "0"]}]}
      }]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691327061910161*^9, 3.691327172222246*^9}, {
  3.691327206479426*^9, 3.6913272731370497`*^9}, {3.691536213527432*^9, 
  3.691536229326687*^9}, {3.691536356091206*^9, 3.691536356843114*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "2"], "(", "r", ")"}], "=", 
   RowBox[{"{", 
    RowBox[{GridBox[{
       {
        RowBox[{
         SubsuperscriptBox["E", "2", "th"], "-", 
         SubscriptBox["V", "2"]}]},
       {
        RowBox[{
         SubsuperscriptBox["E", "2", "th"], "     "}]}
      }], GridBox[{
       {
        RowBox[{" ", 
         RowBox[{
          RowBox[{"for", "  ", "r"}], "<", 
          SubscriptBox["r", "0"]}]}]},
       {
        RowBox[{
         RowBox[{"for", " ", "r"}], ">", 
         SubscriptBox["r", "0"]}]}
      }]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.691327269449114*^9, 3.691327295240769*^9}, {
  3.691499202992983*^9, 3.6914992084804487`*^9}, {3.6915362215445433`*^9, 
  3.69153623349442*^9}, {3.69153630666321*^9, 3.6915363078383493`*^9}}],

Cell[TextData[{
 "We wish to measure length in units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]]],
 ", and energy in units of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], 
    RowBox[{"2", "\[Mu]", " ", 
     SubsuperscriptBox["r", "0", "2"]}]], TraditionalForm]]],
 ", so we multiply through by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["r", "0", "2"], TraditionalForm]]],
 ", and redefine ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", " ", 
    RowBox[{"r", "/", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.691499293219922*^9, 3.691499428237627*^9}, {
  3.6936581276542873`*^9, 3.69365814786091*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            FractionBox[
             RowBox[{"2", "\[Mu]", " ", 
              SuperscriptBox[
               SubscriptBox["r", "0"], "2"]}], 
             SuperscriptBox["\[HBar]", "2"]]}]}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "1"], "+", "E"}], ")"}]}], "-", 
         FractionBox[
          RowBox[{"L", "(", 
           RowBox[{"L", "+", "1"}], ")"}], 
          RowBox[{" ", 
           SuperscriptBox["r", "2"]}]]}], 
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[Mu]", " ", 
           SubsuperscriptBox["r", "0", "2"]}], 
          SuperscriptBox["\[HBar]", "2"]], 
         SubscriptBox["V", "12"]}]},
       {
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[Mu]", " ", 
           SubsuperscriptBox["r", "0", "2"]}], 
          SuperscriptBox["\[HBar]", "2"]], 
         RowBox[{
          SubscriptBox["V", "12"], "\[Conjugate]"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            FractionBox[
             RowBox[{"2", "\[Mu]", " ", 
              SubsuperscriptBox["r", "0", "2"]}], 
             SuperscriptBox["\[HBar]", "2"]]}]}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "2"], "-", 
            SubsuperscriptBox["E", "2", "th"], "+", "E"}], ")"}]}], "-", 
         FractionBox[
          RowBox[{"L", "(", 
           RowBox[{"L", "+", "1"}], ")"}], 
          RowBox[{" ", 
           SuperscriptBox["r", "2"]}]]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Psi]", "1", "I"]},
       {
        SubsuperscriptBox["\[Psi]", "2", "I"]}
      }], ")"}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.691499360525436*^9, {3.691499433074664*^9, 3.691499485090193*^9}, {
   3.691499529849058*^9, 3.6914995565878277`*^9}, {3.691499690233552*^9, 
   3.69149969215121*^9}, {3.691515878871798*^9, 3.691515882879077*^9}, {
   3.691536688089007*^9, 3.691536700032086*^9}, {3.691940012797779*^9, 
   3.69194008363231*^9}, {3.6920153680421867`*^9, 3.6920153697509327`*^9}, {
   3.693658160871279*^9, 3.69365817750686*^9}, {3.693700370187428*^9, 
   3.693700379430481*^9}, {3.702321600606456*^9, 3.702321606573082*^9}}],

Cell[TextData[{
 "Now note that for the scattering problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", ">", "0"}], TraditionalForm]]],
 ".  By definition, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "i"], ">", 
    RowBox[{"0", " ", 
     RowBox[{"\[ForAll]", "i"}]}]}], TraditionalForm]]],
 " and also, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["E", "i", "th"], ">", 
    RowBox[{"0", " ", 
     RowBox[{"\[ForAll]", "i"}]}]}], TraditionalForm]]],
 ".   "
}], "Text",
 CellChangeTimes->{{3.691536733729191*^9, 3.691536810680797*^9}}],

Cell["Let\[CloseCurlyQuote]s define ", "Text",
 CellChangeTimes->{{3.691499608876347*^9, 3.691499725036026*^9}, {
  3.6914997758645973`*^9, 3.6914998275525084`*^9}, {3.691500086165386*^9, 
