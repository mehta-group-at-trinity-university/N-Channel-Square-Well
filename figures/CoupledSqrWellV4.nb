Cell[TextData[{
 "It\[CloseCurlyQuote]s also very helpful to know when there is a state at \
threshold.  So for what ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "0"], TraditionalForm]]],
 " is the ",
 StyleBox["energy",
  FontSlant->"Italic"],
 " zero?"
}], "Text",
 CellChangeTimes->{{3.6936092994457273`*^9, 3.6936093262891006`*^9}}],

