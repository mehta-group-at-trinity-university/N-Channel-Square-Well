   3.702317880988694*^9, 3.702317881006218*^9}}],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
