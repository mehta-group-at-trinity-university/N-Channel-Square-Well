Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ1", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FunctionExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"-", "\[Epsilon]"}]]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v0", "+", "\[Epsilon]"}], ")"}], " ", 
