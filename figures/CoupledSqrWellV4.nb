                 RowBox[{
                  RowBox[{"3", "/", "2"}], ",", "n"}], "]"}], "]"}], "2"], 
              "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 FractionBox["\[Pi]", "4"], "n"}], ")"}], "2"]}]}], "}"}]}], 
          "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "10"}], "}"}], ",", 
