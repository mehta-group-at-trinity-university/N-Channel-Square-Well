  3.693526007189639*^9, 3.6935260151621227`*^9}, {3.693699558080374*^9, 
  3.6936995924153843`*^9}, {3.702316757210832*^9, 3.702316760369177*^9}, {
  3.702319504602696*^9, 3.702319520987032*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
   RowBox[{"(", 
