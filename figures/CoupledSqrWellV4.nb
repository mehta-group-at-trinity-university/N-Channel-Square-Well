          RowBox[{
           RowBox[{"TEQ1", "/.", 
            RowBox[{"v0", "\[Rule]", "VV"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Epsilon]", ",", 
             RowBox[{
              RowBox[{"-", "VV"}], "+", 
              SuperscriptBox[
               RowBox[{"N", "[", 
