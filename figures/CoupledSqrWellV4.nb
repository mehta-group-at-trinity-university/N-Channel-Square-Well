Cell[TextData[{
 "Define the matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["A",
    FontWeight->"Bold"], TraditionalForm]]],
 " such that it diagonalizes ",
 Cell[BoxData[
  FormBox[
   StyleBox["W",
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
