    "10.0", ",", "100.0", ",", "1", ",", "\[Epsilon]", ",", "100", ",", "0"}],
     "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
