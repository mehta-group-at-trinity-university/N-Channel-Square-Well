 CellChangeTimes->{3.7412853024964*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ic", "=", "40"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WDtest", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"AWD", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], ")"}], "&"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nw", "=", 
   RowBox[{"Length", "[", "WDtest", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Warray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"WDtest", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "7"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nw"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"meanw", "=", 
  RowBox[{"Mean", "[", "Warray", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wc1", "=", 
   RowBox[{"BinCounts", "[", 
    RowBox[{
     RowBox[{"Warray", "/", "meanw"}], ",", 
     RowBox[{"{", "bins", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wcnorm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bins", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"wc1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "/", "nw"}], "/", "db"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "bins", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
