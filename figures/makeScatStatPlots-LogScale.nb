Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nufitdata", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"WDtest", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"AWD", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "ic"}], ")"}], 
         "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nw", "=", 
      RowBox[{"Length", "[", "WDtest", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Warray", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"WDtest", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "7"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nw"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meanw", "=", 
      RowBox[{"Mean", "[", "Warray", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wc1", "=", 
      RowBox[{"BinCounts", "[", 
       RowBox[{
        RowBox[{"Warray", "/", "meanw"}], ",", 
        RowBox[{"{", "bins", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wcnorm", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"bins", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"wc1", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "/", "nw"}], "/", "db"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "bins", "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Nu]0", "=", "0.954"}], ";", "\[IndentingNewLine]", 
     RowBox[{"wcfit", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"bfit", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"wcnorm", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "wcnorm", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nlm", "=", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"wcfit", ",", 
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Gamma]", 
            RowBox[{
             RowBox[{"\[Nu]", "/", "2"}], "-", "1"}]], 
           RowBox[{"Gamma", "[", 
            RowBox[{"\[Nu]", "/", "2"}], "]"}]], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "\[Gamma]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "1.0"}], "}"}], "}"}], ",", "\[Gamma]", ",", 
        RowBox[{"Method", "->", "\"\<LevenbergMarquardt\>\""}], ",", 
        RowBox[{"ConfidenceLevel", "\[Rule]", "0.99"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SD", "[", 
          RowBox[{"[", 
           RowBox[{"ic", ",", "5"}], "]"}], "]"}], ",", 
         RowBox[{"\[Nu]", "/.", 
          RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], "}"}], 
       ",", 
       RowBox[{"ErrorBar", "[", 
        RowBox[{
         RowBox[{"nlm", "[", "\"\<ParameterErrors\>\"", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ic", ",", "1", ",", "40"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.741285109151649*^9, 3.741285113794232*^9}, {
  3.741285228955152*^9, 3.741285237326269*^9}}],

