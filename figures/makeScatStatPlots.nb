Cell[CellGroupData[{

Cell["What to expect for semi-poisson?", "Subsection",
 CellChangeTimes->{{3.743179799286852*^9, 3.743179810261674*^9}}],

Cell["\<\
If we sample the semi-poisson distribution, what Brody parameter do we \
expect, and with what standard error?\
\>", "Text",
 CellChangeTimes->{{3.743179812957426*^9, 3.743179839676024*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"cumsp", "[", "s_", "]"}], ":=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"4", "s", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], "s"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "0", ",", "s"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.743179845271131*^9, 3.743179880764538*^9}, {
  3.743180765347973*^9, 3.7431807677610693`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cumsp", "[", "s", "]"}]], "Input",
 CellChangeTimes->{{3.74318030235832*^9, 3.743180304127221*^9}}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "s"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "s"}]], "-", 
    RowBox[{"2", " ", "s"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.743180304510663*^9, 3.743180770319962*^9, 
  3.743180876634276*^9}]
}, Open  ]],

