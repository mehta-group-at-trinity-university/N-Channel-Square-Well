Cell[BoxData[
 RowBox[{
  RowBox[{"Sig2Formula", "[", 
   RowBox[{"\[Beta]_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["2", 
     RowBox[{"\[Beta]", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}], "+", "EulerGamma", 
      "+", "1", "-", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}], "-", 
      RowBox[{"CosIntegral", "[", 
       RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}]}], ")"}]}], " ", 
   "+", " ", 
   RowBox[{"r", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["2", "\[Pi]"], 
       RowBox[{"SinIntegral", "[", 
        RowBox[{"\[Beta]", " ", "\[Pi]", " ", "r"}], "]"}]}]}], 
     ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.741560884830719*^9, 3.741560966106285*^9}, {
  3.74156117421966*^9, 3.7415612346942987`*^9}, {3.7415615284244328`*^9, 
  3.741561569755032*^9}, {3.74156160924681*^9, 3.741561611512842*^9}, {
  3.7429048946692057`*^9, 3.742904945935472*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sig2GOE", "[", "r_", "]"}], ":=", 
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"Sig2Formula", "[", 
     RowBox[{"2.0", ",", "r"}], "]"}]}], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"SinIntegral", "[", 
       RowBox[{"\[Pi]", " ", "r"}], "]"}], "\[Pi]"], ")"}], "2"], "-", 
   RowBox[{
    FractionBox["1", "\[Pi]"], 
    RowBox[{"SinIntegral", "[", 
     RowBox[{"\[Pi]", " ", "r"}], "]"}]}]}]}]], "Input",
