Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"BinCounts", "[", 
      RowBox[{"samp", ",", 
       RowBox[{"{", "Bins", "}"}]}], "]"}], "/", "NP"}], "/", "dx"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bnorm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Bins", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ")"}], ",", 
       RowBox[{"bc", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "Bins", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bfit", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Bins", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+", 
          RowBox[{"Bins", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
       RowBox[{"bc", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "Bins", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ph", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"bnorm", ",", 
     RowBox[{"InterpolationOrder", "\[Rule]", "0"}], ",", 
     RowBox[{"Joined", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psp", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"4", "s", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
