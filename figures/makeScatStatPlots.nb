        RowBox[{"2", "+", "w"}], 
        RowBox[{"1", "+", "w"}]], "]"}], ")"}], 
     RowBox[{"1", "+", "w"}]], 
    SuperscriptBox["x", "w"], 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
