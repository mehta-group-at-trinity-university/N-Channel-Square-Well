}, Open  ]],

Cell[TextData[{
 "First define ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " to be the number of data points, and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " to be the number of parameters."
}], "Text",
 CellChangeTimes->{{3.7441152312262506`*^9, 3.744115297457636*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.743877042670693*^9, 3.743877053244802*^9}, {
  3.743893735088929*^9, 3.743893735152667*^9}, {3.7441152290242558`*^9, 
  3.744115241826684*^9}}],

Cell[TextData[{
 "Adjust estimate of \[Sigma] so that the estimator of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is \[OpenCurlyDoubleQuote]unbiased\[CloseCurlyDoubleQuote].  "
}], "Text",
 CellChangeTimes->{{3.7441152938111067`*^9, 3.744115316773408*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sigma", "=", 
  RowBox[{
   RowBox[{"\[Sigma]", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"n", "/", 
      RowBox[{"(", 
       RowBox[{"n", "-", "p"}], ")"}]}], "]"}]}], "/.", 
   RowBox[{"sol", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.743877061221635*^9, 3.744079432526762*^9, {3.7441152895528584`*^9, 
   3.744115292352895*^9}}],

Cell[BoxData["0.6665905728554096`"], "Output",
 CellChangeTimes->{3.7438770616411*^9, 3.743893739625415*^9, 
  3.744079440758871*^9, 3.7441152098926163`*^9, 3.744115322924711*^9, 
  3.74411572184579*^9}]
}, Open  ]],

Cell["Modify the maximum likelihood estimate for \[Sigma]", "Text",
 CellChangeTimes->{{3.74411533117789*^9, 3.744115334004513*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"[", 
    RowBox[{"2", ",", "2"}], "]"}], "]"}], "=", 
  RowBox[{"\[Sigma]", "\[Rule]", "sigma"}]}]], "Input",
 CellChangeTimes->{{3.743877072790594*^9, 3.743877077535467*^9}, {
  3.743893757618743*^9, 3.743893757719569*^9}, {3.744115330265458*^9, 
  3.744115335630837*^9}}],

Cell[BoxData[
 RowBox[{"\[Sigma]", "\[Rule]", "0.6665905728554096`"}]], "Output",
 CellChangeTimes->{
  3.743877078003829*^9, {3.743893751025693*^9, 3.743893758105151*^9}, 
   3.7441153374467993`*^9, 3.744115799210232*^9}]
}, Open  ]],

Cell[TextData[{
 "Now get the standard errors for the estimators of ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.7441153498838778`*^9, 3.74411535760992*^9}}],

Cell["First construct the second derivative of logL symbolically", "Text",
 CellChangeTimes->{{3.7441153498838778`*^9, 3.7441153588678627`*^9}}],

Cell[TextData[{
 "This is just as before, but with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], ",", 
    SubscriptBox["y", "i"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " symbolically represented."
}], "Text",
 CellChangeTimes->{{3.744115411000598*^9, 3.744115441991366*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "y", "]"}]], "Input",
 CellChangeTimes->{{3.7441158210804234`*^9, 3.744115822320825*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"symbolicData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "i", "]"}], ",", 
       RowBox[{"y", "[", "i", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"logL", "=", 
   RowBox[{"LogLikelihood", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "\[Sigma]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"symbolicData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"py", "[", 
       RowBox[{"a", ",", 
        RowBox[{"symbolicData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.743877181459058*^9, 3.743877183202105*^9}, {
   3.7438772556184397`*^9, 3.74387727841882*^9}, {3.743893773211844*^9, 
   3.743893773431381*^9}, {3.744115421240035*^9, 3.74411542162812*^9}, {
   3.744115572450427*^9, 3.744115572790182*^9}, 3.744115840433485*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "6"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", "2", "]"}], "+", 
        RowBox[{"Log", "[", "\[Pi]", "]"}]}], ")"}]}], "+", 
     RowBox[{"Log", "[", "\[Sigma]", "]"}]}], ")"}]}], "-", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "1", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "1", "]"}]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "2", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "2", "]"}]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "3", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "3", "]"}]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "4", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "4", "]"}]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "5", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "5", "]"}]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", 
          RowBox[{"x", "[", "6", "]"}]}]]}], "+", 
       RowBox[{"y", "[", "6", "]"}]}], ")"}], "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]]}]], "Output",
 CellChangeTimes->{
  3.743877183691854*^9, 3.74387728056056*^9, 3.7438937739408197`*^9, 
   3.744115443644824*^9, 3.7441155743754807`*^9, {3.7441158239492807`*^9, 
   3.744115840891577*^9}}]
}, Open  ]],

Cell[TextData[{
 "Take the second derivative of logL with respect to the free parameter ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "."
}], "Text",
 CellChangeTimes->{{3.744115453950181*^9, 3.7441154728857603`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"h", "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["\[DifferentialD]", "2"], 
     RowBox[{"\[DifferentialD]", 
      SuperscriptBox["a", "2"]}]], 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}]], "n"], 
     RowBox[{"log", "(", " ", 
      FormBox[
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["y", "i"], "-", 
               RowBox[{"py", "(", 
                RowBox[{"a", ",", " ", 
                 SubscriptBox["x", "i"]}], ")"}]}], ")"}], ")"}], "2"], 
           RowBox[{"2", " ", 
            SuperscriptBox["\[Sigma]", "2"]}]]}]], 
        RowBox[{
         SqrtBox[
          RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]],
       TraditionalForm], ")"}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.74411550257381*^9, 3.744115522614993*^9}, 
   3.744115853718449*^9, {3.744115907589047*^9, 3.744115908045253*^9}, {
   3.7441160004977407`*^9, 3.744116002452104*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", "=", 
  RowBox[{"D", "[", 
   RowBox[{"logL", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "a", "}"}], ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7438771953366003`*^9, 3.743877219535018*^9}, {
   3.74389377905142*^9, 3.743893780406719*^9}, 3.7441160523625727`*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Sigma]", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
          RowBox[{"x", "[", "1", "]"}]}]], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "1", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
          RowBox[{"x", "[", "2", "]"}]}]], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "2", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
          RowBox[{"x", "[", "3", "]"}]}]], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "3", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
          RowBox[{"x", "[", "4", "]"}]}]], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "4", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
          RowBox[{"x", "[", "5", "]"}]}]], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "5", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "a", " ", 
