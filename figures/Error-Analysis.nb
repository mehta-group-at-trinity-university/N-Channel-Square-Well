Cell[TextData[{
 "Let\[CloseCurlyQuote]s assume that the observed data may be binned to a \
normal distribution about the expected values.  The residual values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "i"], "-", 
    RowBox[{"y", "(", 
     SubscriptBox["x", "i"], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " are treated as the random variable.  Because the log is a monotonically \
increasing function of its argument, the maximum of the normal distribution \
occurs at the same point as the maximum of its log.  Construct the log \
likelihood function for the normal distribution with the estimated variance \
computed above:"
}], "Text",
 CellChangeTimes->{{3.7440755365397453`*^9, 3.744075557320546*^9}, {
  3.744075713600273*^9, 3.744075725151971*^9}, {3.744078691721149*^9, 
  3.7440788513959303`*^9}, {3.744078924397523*^9, 3.744078978348069*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"logL", "=", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}]], "n"], 
     RowBox[{"log", "(", 
      RowBox[{"P", " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["y", "i"], "-", 
         RowBox[{"y", "(", 
          SubscriptBox["x", "i"], ")"}]}], ")"}]}], " ", ")"}]}], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}]], "n"], 
     RowBox[{"log", "(", " ", 
      FormBox[
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["y", "i"], "-", 
               RowBox[{"py", "(", 
                SubscriptBox["x", "i"], ")"}]}], ")"}], ")"}], "2"], 
           RowBox[{"2", " ", 
            SuperscriptBox["\[Sigma]", "2"]}]]}]], 
        RowBox[{
         SqrtBox[
          RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]],
       TraditionalForm], ")"}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.744075621545867*^9, 3.7440756681272717`*^9}, {
   3.744075727632168*^9, 3.744075731545746*^9}, {3.7440757686801157`*^9, 
   3.744075772487862*^9}, {3.7440759319383373`*^9, 3.744075932395569*^9}, {
   3.74407820351439*^9, 3.74407821602454*^9}, {3.7440782482711906`*^9, 
   3.744078259228498*^9}, {3.7440784776276493`*^9, 3.744078498802185*^9}, 
   3.744115674561108*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FunctionExpand", "[", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"py", "[", 
              RowBox[{"a", ",", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}]}], ")"}], 
           "2"], 
          RowBox[{"2", 
           SuperscriptBox["\[Sigma]", "2"]}]]}], "]"}], 
       RowBox[{
        SqrtBox[
         RowBox[{"2", "\[Pi]"}]], "\[Sigma]"}]], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Sigma]", ">", "0"}], ",", 
     RowBox[{"a", ">", "0"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.744075780792636*^9, 3.744075845604134*^9}, {
   3.7440759376736917`*^9, 3.744076091305827*^9}, {3.7440761550047197`*^9, 
   3.7440762685571117`*^9}, {3.744076594957322*^9, 3.744076634537222*^9}, {
   3.744076686696363*^9, 3.744076697665462*^9}, {3.7440769556400623`*^9, 
   3.744076984660104*^9}, {3.744077033031402*^9, 3.744077052753405*^9}, 
   3.7440770964666433`*^9, 3.744077906313644*^9, {3.7440779681895742`*^9, 
   3.744078006194025*^9}, {3.744078041736786*^9, 3.744078072812331*^9}, {
   3.744078107204996*^9, 3.744078130594009*^9}, {3.744078273340337*^9, 
   3.7440784343653812`*^9}, {3.744078601423053*^9, 3.7440786194372168`*^9}, {
   3.744078892164184*^9, 3.74407889227453*^9}, 3.744115004674863*^9, 
   3.744115677964135*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "a"}]], 
    RowBox[{"2", " ", 
     SuperscriptBox["\[Sigma]", "2"]}]]}], "-", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "a"}]]}], ")"}], "2"], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], "-", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"5", " ", "a"}]]}], ")"}], "2"], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], "-", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"6", " ", "a"}]]}], ")"}], "2"], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], "-", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"5", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"7", " ", "a"}]]}], ")"}], "2"], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Log", "[", "2", "]"}]}], "-", 
     RowBox[{"Log", "[", "\[Pi]", "]"}]}], ")"}]}], "+", 
  RowBox[{"5", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"2", " ", "\[Pi]"}], "]"}]}], "-", 
     RowBox[{"Log", "[", "\[Sigma]", "]"}]}], ")"}]}], "-", 
  RowBox[{"Log", "[", "\[Sigma]", "]"}]}]], "Output",
 CellChangeTimes->{{3.744078612101815*^9, 3.74407862000895*^9}, 
   3.744078892818384*^9, 3.744115006312167*^9, 3.744115682070908*^9}]
}, Open  ]],

Cell["There is a built-in command for this.", "Text",
 CellChangeTimes->{{3.7440786548116283`*^9, 3.744078669024021*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"logL", "=", 
  RowBox[{"LogLikelihood", "[", 
   RowBox[{
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", "\[Sigma]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
     RowBox[{"py", "[", 
      RowBox[{"a", ",", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7438768553918467`*^9, 3.743876919453965*^9}, {
   3.743893705750431*^9, 3.743893705979546*^9}, 3.744078572222863*^9, {
   3.744115688227255*^9, 3.744115698473384*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "a"}]], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"3", " ", "a"}]]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"4", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"5", " ", "a"}]]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"4", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"6", " ", "a"}]]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"5", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"7", " ", "a"}]]}], ")"}], "2"]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["\[Sigma]", "2"]}]]}], "-", 
  RowBox[{"6", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", "2", "]"}], "+", 
        RowBox[{"Log", "[", "\[Pi]", "]"}]}], ")"}]}], "+", 
     RowBox[{"Log", "[", "\[Sigma]", "]"}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{
  3.743876857455254*^9, 3.743876894184968*^9, 3.743876979045847*^9, 
   3.743877028537302*^9, {3.743893702416375*^9, 3.743893707745246*^9}, 
   3.744077000821724*^9, 3.744077941717147*^9, 3.744078142327177*^9, 
   3.744078575436804*^9, 3.744078634312296*^9, 3.744115009712726*^9, {
   3.74411569015168*^9, 3.744115700006866*^9}}]
}, Open  ]],

