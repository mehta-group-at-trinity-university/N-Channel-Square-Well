         RowBox[{"k", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7029226895450687`*^9, 3.7029227235156097`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
