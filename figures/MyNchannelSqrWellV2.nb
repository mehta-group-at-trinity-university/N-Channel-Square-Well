  ";"}]], "Input",
 CellChangeTimes->{{3.702922755520462*^9, 3.7029227886036*^9}}],

Cell["\<\
\[LineSeparator]I\[CloseCurlyQuote]ll multiply the decaying function by a \
constant to rescale it for the strongly closed channels.\
\>", "Text",
 CellChangeTimes->{{3.703433719425181*^9, 3.703433737842691*^9}, 
   3.70351624809765*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{
       FractionBox["2", "\[Pi]"], "\[Kappa]", " ", "r"}]], 
     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{"L", "+", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Kappa]", " ", "Rshift"}]]}], "/.", 
    RowBox[{"Rshift", "\[Rule]", "0.8"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.70231870292422*^9, 3.702318731449788*^9}, 
   3.702318784881133*^9, {3.702319289133815*^9, 3.70231929138938*^9}, {
