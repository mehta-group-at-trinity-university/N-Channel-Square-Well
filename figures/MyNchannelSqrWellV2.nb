Cell[CellGroupData[{

Cell["\<\
Test the position of the resonances using the open-closed couplings\
\>", "Subsection",
 CellChangeTimes->{{3.703622935067129*^9, 3.703622947401243*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NCHAN", "=", "3"}], ";", 
  RowBox[{"D0", "=", "2000.0"}], ";", 
  RowBox[{"\[Epsilon]1", "=", "500.0"}], ";", 
  RowBox[{"\[Gamma]", "=", "10.0"}], ";", 
  RowBox[{"NumOpen", "=", "1"}], ";", 
  RowBox[{"L", "=", "0"}], ";", 
  RowBox[{"rmatch", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", "V"}], 
    "}"}], "=", 
   RowBox[{"SetupPotentialOpenClosed", "[", 
    RowBox[{"NCHAN", ",", "D0", ",", "\[Epsilon]1", ",", "\[Gamma]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataArray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"RunEnergyLoop", "[", 
        RowBox[{
        "NCHAN", ",", "NumOpen", ",", "L", ",", "rmatch", ",", 
         "\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", 
         "\[Epsilon]"}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", "0.0001", ",", 
       RowBox[{"\[Epsilon]th", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Epsilon]th", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "10000.0"}]}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ptest", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", "dataArray", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", 
     RowBox[{"Joined", "\[Rule]", "True"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", "Large"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<E/(\!\(\*SuperscriptBox[\(\[HBar]\), \
\(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\"", ",", 
        "\"\<\!\(\*SuperscriptBox[\(sin\), \(2\)]\)(\!\(\*SubscriptBox[\(\
\[Delta]\), \(0\)]\))\>\""}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TEQ0", "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
     RowBox[{"Cos", "[", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}], "+", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", "\[Epsilon]"}]], " ", 
     RowBox[{"Sin", "[", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vt", "=", "D0"}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.703622928006283*^9, {3.703622975922329*^9, 3.70362304581527*^9}, {
   3.7036231401643744`*^9, 3.7036231840172453`*^9}, 3.703623225615808*^9, {
   3.703623271124106*^9, 3.70362328535532*^9}, {3.703623316252886*^9, 
   3.703623321882722*^9}, {3.7036234665674877`*^9, 3.7036234946565*^9}, {
   3.703623591686185*^9, 3.703623594252264*^9}, {3.703623815306041*^9, 
   3.70362382948079*^9}, {3.703633740239723*^9, 3.703633809428712*^9}, 
   3.703634185712824*^9}],

Cell["\<\
This next bit contructs an energy grid and then finds the energy eigenroots \
for a single square well potential.  scale those roots to the appropriate \
threshold to find the positions of the pole with respect to the collision \
threshold E=0.  \
\>", "Text",
 CellChangeTimes->{{3.703634190967396*^9, 3.7036343100002947`*^9}}],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"egrid", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"e", ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", 
         RowBox[{"-", "vt"}], ",", "0.0001", ",", 
         RowBox[{
          RowBox[{"(", "vt", ")"}], "/", "10000.0"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "egrid", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Bgrid", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"egrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"TEQ0", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Epsilon]", "\[Rule]", 
             RowBox[{"egrid", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", 
            RowBox[{"v0", "\[Rule]", "vt"}]}], "}"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootguess", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", "50"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rn", "=", "1"}], ";", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Bgrid", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], 
          RowBox[{"Bgrid", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}]}], "<", "0"}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rootguess", "[", 
           RowBox[{"[", "rn", "]"}], "]"}], "=", 
          RowBox[{"Bgrid", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
         RowBox[{"rn", "+=", "1"}], ";"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootguess", "=", 
     RowBox[{"rootguess", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"rn", "-", "1"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"roots", "=", "rootguess"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"roots", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "=", 
       RowBox[{"\[Epsilon]", "/.", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TEQ0", "\[Equal]", "0"}], "/.", 
           RowBox[{"v0", "\[Rule]", "vt"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", 
            RowBox[{"rootguess", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"rn", "-", "1"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poles", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"roots", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
