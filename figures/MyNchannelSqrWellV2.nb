Cell["Solutions of just the diagonal operator are:", "Text",
 CellChangeTimes->{{3.703418110045464*^9, 3.703418134868466*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       FractionBox["1", "2"]}], ",", 
      RowBox[{"k", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7023181956761847`*^9, 3.702318255529701*^9}, {
