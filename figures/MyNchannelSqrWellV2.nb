 CellChangeTimes->{{3.703431493567836*^9, 3.7034315051071653`*^9}}],

Cell["Now the constant matrix:", "Text",
 CellChangeTimes->{{3.703418165610907*^9, 3.703418193266176*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["V",
    FontWeight->"Bold"], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        SubscriptBox["D", "1"]}], 
       SubscriptBox["V", "12"]},
      {
       RowBox[{
        SubscriptBox["V", "12"], "\[Conjugate]"}], 
       RowBox[{
        SubsuperscriptBox["E", "2", "th"], "-", 
        SubscriptBox["D", "2"]}]}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703418169565777*^9, 3.703418173562397*^9}}],

Cell["can be diagonalized as:", "Text",
 CellChangeTimes->{{3.703418195638034*^9, 3.7034182018336887`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[CapitalLambda]",
    FontWeight->"Bold"], "=", 
   RowBox[{"(", GridBox[{
      {
       SubsuperscriptBox["\[Lambda]", "1", "2"], "0"},
      {"0", 
       SubsuperscriptBox["\[Lambda]", "2", "2"]}
     }], ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703418204921968*^9, 3.703418240538904*^9}}],

Cell["by an orthogonal transformation", "Text",
 CellChangeTimes->{{3.70341824316885*^9, 3.7034182549476833`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[CapitalLambda]",
    FontWeight->"Bold"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["U",
        FontWeight->"Bold"], "\[Transpose]"}], 
      StyleBox["V",
       FontWeight->"Bold"], " ", 
      StyleBox["U",
       FontWeight->"Bold"]}], 
     StyleBox[" ",
      FontWeight->"Bold"], "\[Implies]", " ", 
     StyleBox["V",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     StyleBox["U",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     StyleBox["\[CapitalLambda]",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["U",
       FontWeight->"Bold"], "\[Transpose]"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703418259539921*^9, 3.7034182750986853`*^9}, {
  3.703418476159919*^9, 3.703418516984694*^9}}],

Cell["Then", "Text",
 CellChangeTimes->{{3.7034184659939203`*^9, 3.7034184663301764`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["H", "0"], "-", "E"}], ")"}], 
       StyleBox["1",
        FontWeight->"Bold"]}], "+", 
      StyleBox[
       RowBox[{"U", " ", "\[CapitalLambda]", " ", 
        RowBox[{"U", "\[Transpose]"}]}],
       FontWeight->"Bold"]}], ")"}], "\[Psi]"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{3.703418463420972*^9, 3.7034185295732403`*^9}],

Cell[TextData[{
 "We can hit this from the left with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "\[Transpose]"}], TraditionalForm]]],
 " and thus since it clearly commutes with ",
 Cell[BoxData[
  FormBox[
   StyleBox["1",
    FontWeight->"Bold"], TraditionalForm]]],
 " we write (using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["U", "T"], "U"}], "=", "1"}], TraditionalForm]]],
 "):"
}], "Text",
 CellChangeTimes->{{3.7034185486974373`*^9, 3.703418638547022*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["H", "0"], "-", "E"}], ")"}], 
       StyleBox["1",
        FontWeight->"Bold"]}], "+", 
      StyleBox["\[CapitalLambda]",
       FontWeight->"Bold"]}], ")"}], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{"U", "\[Transpose]"}],
     FontWeight->"Bold"], "\[Psi]"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7034186083732567`*^9, 3.703418629451748*^9}, {
  3.703418728057949*^9, 3.703418728076294*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["H", "0"], "-", "E"}], ")"}], 
       StyleBox["1",
        FontWeight->"Bold"]}], "+", 
      StyleBox["\[CapitalLambda]",
       FontWeight->"Bold"]}], ")"}], 
    StyleBox[" ",
     FontWeight->"Bold"], "\[Phi]"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7034186083732567`*^9, 3.703418629451748*^9}, {
  3.703418728057949*^9, 3.703418733729748*^9}}],

Cell["where we define ", "Text",
 CellChangeTimes->{{3.703418646457634*^9, 3.703418649363618*^9}, {
  3.7034187386728687`*^9, 3.70341873915466*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Phi]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["U", "T"], "\[Psi]"}], " ", "\[Implies]", "\[Psi]"}], 
    "=", 
    RowBox[{"U", " ", "\[Phi]"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7034186523716717`*^9, 3.703418661771071*^9}, {
  3.7034187093162193`*^9, 3.703418717896955*^9}}],

Cell[TextData[{
 "\[Phi] satisfies a diagonal equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"E", "=", 
     SuperscriptBox["k", "2"]}], ")"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.703418771848259*^9, 3.7034187845912457`*^9}, {
  3.703419622609346*^9, 3.7034196275665693`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"-", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"+", 
            FractionBox[
             RowBox[{"L", "(", 
              RowBox[{"L", "+", "1"}], ")"}], 
             RowBox[{" ", 
              SuperscriptBox["r", "2"]}]]}]}]}], "0"},
        {"0", 
         RowBox[{"-", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["r", "2"]}]], 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", "(", 
              RowBox[{"L", "+", "1"}], ")"}], 
             RowBox[{" ", 
              SuperscriptBox["r", "2"]}]]}]}]}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[Phi]", "1"]},
        {
         SubscriptBox["\[Phi]", "2"]}
       }], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k", "2"], "-", 
           SubsuperscriptBox["\[Lambda]", "1", "2"]}], ")"}], "0"},
        {"0", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k", "2"], "-", 
           SubsuperscriptBox["\[Lambda]", "2", "2"]}], ")"}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["\[Phi]", "1"]},
        {
         SubscriptBox["\[Phi]", "2"]}
       }], ")"}]}]}], "=", "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703418817195423*^9, 3.7034189013890247`*^9}, {
  3.703419619133416*^9, 3.703419638106645*^9}, {3.703420019815095*^9, 
  3.7034200328626823`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Psi]", "=", 
   RowBox[{"U", " ", "\[Phi]"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703419706207321*^9, 3.703419709872961*^9}}],

Cell["means", "Text",
 CellChangeTimes->{{3.703419713396556*^9, 3.703419713902752*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "i"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["U", "i\[Alpha]"], 
     RowBox[{
      SubscriptBox["\[Phi]", "\[Alpha]"], "(", "r", ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.702920088120948*^9, 3.702920096041851*^9}, {
  3.702991510058806*^9, 3.702991531045336*^9}, {3.703415991898077*^9, 
  3.703416022766341*^9}, {3.703419680991384*^9, 3.70341969570298*^9}}],

Cell["It helps perhaps to remember that this is really", "Text",
 CellChangeTimes->{{3.7035163674688253`*^9, 3.7035163776366568`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "i"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["U", "i\[Alpha]"], 
     RowBox[{
      UnderscriptBox["\[Sum]", "\[Beta]"], 
      RowBox[{
       SubscriptBox["\[Delta]", "\[Alpha]\[Beta]"], 
       RowBox[{
        SubscriptBox["\[Phi]", "\[Alpha]"], "(", "r", ")"}]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70351636451721*^9, 3.703516391763261*^9}}],

Cell["\<\
However, we require the appropriate linear combination that matches smoothly \
onto the exterior solutions.  To obtain this, we construct a more general \
solution in the interior.  Let\
\>", "Text",
 CellChangeTimes->{{3.703420093072201*^9, 3.70342014269528*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPhi]", "i\[Alpha]"], "=", 
   RowBox[{
    SubscriptBox["U", "i\[Alpha]"], 
    RowBox[{
     SubscriptBox["\[Phi]", "\[Alpha]"], "(", "r", ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70342014571073*^9, 3.7034201560819397`*^9}}],

Cell["and now construct:", "Text",
 CellChangeTimes->{{3.703420157804867*^9, 3.7034201630719357`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "i"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     SubscriptBox["\[CapitalPhi]", "i\[Alpha]"]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.703420165636771*^9, 3.7034201901214437`*^9}}],

Cell[TextData[{
 "Note that the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]"], TraditionalForm]]],
 " are coefficients that only depend on ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]]],
 " and therefore can\[CloseCurlyQuote]t be adjusted to give different \
amplitudes in the open-closed channels.  They only allow different \
superpositions of the functions in a given channel that are all regular at \
the origin, namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "\[Alpha]"], "=", 
    RowBox[{
     SubscriptBox["f", "\[Alpha]"], "=", 
     RowBox[{
      SqrtBox[
       RowBox[{
        FractionBox["\[Pi]", "2"], 
        SubscriptBox["k", "\[Alpha]"], "r"}]], 
      RowBox[{
       SubscriptBox["J", 
        RowBox[{"L", "+", 
         RowBox[{"1", "/", "2"}]}]], "(", 
       RowBox[{
        SubscriptBox["k", "\[Alpha]"], "r"}], ")"}]}]}]}], 
   TraditionalForm]]],
 ", where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "\[Alpha]"], "=", 
    SqrtBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["k", "2"], "-", 
       SubsuperscriptBox["\[Lambda]", "\[Alpha]", "2"]}], ")"}]]}], 
   TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.703420381197826*^9, 3.703420520234048*^9}, {
  3.703420578239005*^9, 3.703420602403466*^9}}],

Cell[TextData[{
 "Meanwhile the row index of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "i\[Alpha]"], TraditionalForm]]],
 " carries information about the relative amplitudes in each channel.  It \
seems in a sense that for our purpose, the column index of ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]]],
 " is irrelevant, since the dependence on ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]]],
 " will be modified by the multiplication by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]"], TraditionalForm]]],
 " which still need to be determined anyhow."
}], "Text",
 CellChangeTimes->{{3.703420381197826*^9, 3.703420555177745*^9}, {
  3.703420613196714*^9, 3.703420712409136*^9}}],

Cell["\<\
To determine the solutions, we demand that the interior wave functions and \
their derivatives match smoothly onto the exterior solutions:\
\>", "Text",
 CellChangeTimes->{{3.7034160239380827`*^9, 3.703416133647705*^9}, {
  3.703416233625753*^9, 3.703416293867196*^9}, {3.70341972606219*^9, 
  3.7034197610336943`*^9}, {3.703419802903223*^9, 3.7034198055993147`*^9}, {
  3.703420506797552*^9, 3.703420516857999*^9}, {3.703420718272286*^9, 
  3.7034207590146427`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["b", "\[Alpha]"], 
     SubscriptBox["\[CapitalPhi]", "i\[Alpha]"]}]}], "=", 
   RowBox[{"{", 
    RowBox[{GridBox[{
       {
        RowBox[{
         SubscriptBox["a", "i"], 
         RowBox[{
          SubscriptBox["g", "b"], "(", "r", ")"}]}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["c", "i"], " ", 
          RowBox[{"f", "(", 
           RowBox[{
            SubscriptBox["k", "i"], " ", "r"}], ")"}]}], "-", 
         RowBox[{
          SubscriptBox["s", "i"], " ", 
          RowBox[{"g", "(", 
           RowBox[{
            SubscriptBox["k", "i"], "r"}], ")"}], Cell[""]}]}]}
      }], " ", GridBox[{
       {
        RowBox[{"i", "\[Element]", 
         RowBox[{"closed", " ", "channels"}]}]},
       {
        RowBox[{"i", "\[Element]", 
         RowBox[{"open", " ", "channels"}]}]}
      }]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7034220018028107`*^9, 3.703422151472292*^9}}],

Cell[TextData[{
 "along with an additional equation for the open channel setting the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "\[Rule]", "1"}], TraditionalForm]]],
 ".  This is setup as a system of linear equations:"
}], "Text",
 CellChangeTimes->{{3.7034221833916273`*^9, 3.7034222350985613`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        StyleBox[
         SubscriptBox["\[CapitalPhi]", "11"],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         SubscriptBox["\[CapitalPhi]", 
          RowBox[{"1", "N"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         RowBox[{"-", 
          SubscriptBox["g", "1"]}],
         FontColor->RGBColor[0, 0, 1]], "0", "0", "0", "0"},
       {
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", "11"]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", 
            RowBox[{"1", "N"}]]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["g", "1"]}], 
           RowBox[{"\[PartialD]", "r"}]]}],
         FontColor->RGBColor[0, 0, 1]], "0", "0", "0", "0"},
       {
        StyleBox["\[VerticalEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[DescendingEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[VerticalEllipsis]",
         FontColor->RGBColor[1, 0, 0]], "0", "\[DescendingEllipsis]", "0", 
        "0", "0"},
       {
        StyleBox[
         SubscriptBox["\[CapitalPhi]", 
          RowBox[{
           RowBox[{"N", "-", "1"}], ",", "1"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         SubscriptBox["\[CapitalPhi]", 
          RowBox[{
           RowBox[{"N", "-", "1"}], ",", "N"}]],
         FontColor->RGBColor[1, 0, 0]], "0", "0", 
        StyleBox[
         RowBox[{"-", 
          SubscriptBox["g", 
           RowBox[{"N", "-", "1"}]]}],
         FontColor->RGBColor[0, 0, 1]], "0", "0"},
       {
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", 
            RowBox[{
             RowBox[{"N", "-", "1"}], ",", "1"}]]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", 
            RowBox[{
             RowBox[{"N", "-", "1"}], ",", "N"}]]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], "0", "0", 
        StyleBox[
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["g", 
             RowBox[{"N", "-", "1"}]]}], 
           RowBox[{"\[PartialD]", "r"}]]}],
         FontColor->RGBColor[0, 0, 1]], "0", "0"},
       {
        StyleBox[
         SubscriptBox["\[CapitalPhi]", "N1"],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         SubscriptBox["\[CapitalPhi]", "NN"],
         FontColor->RGBColor[1, 0, 0]], "0", "0", "0", 
        RowBox[{"-", 
         SubscriptBox["f", "o"]}], 
        SubscriptBox["g", "o"]},
       {
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", "N1"]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["\[CenterEllipsis]",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["\[CapitalPhi]", "NN"]}], 
          RowBox[{"\[PartialD]", "r"}]],
         FontColor->RGBColor[1, 0, 0]], "0", "0", "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["f", "o"]}], 
          RowBox[{"\[PartialD]", "r"}]]}], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["g", "o"]}], 
         RowBox[{"\[PartialD]", "r"}]]},
       {"0", "0", "0", "0", "0", "0", "1", "0"}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["b", "1"]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["b", "N"]},
       {
        SubscriptBox["a", "1"]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["a", 
         RowBox[{"N", "-", "1"}]]},
       {"c"},
       {"s"}
      }], ")"}]}], "=", 
   RowBox[{"(", GridBox[{
      {"0"},
      {"0"},
      {"\[VerticalEllipsis]"},
      {"0"},
      {"0"},
      {"0"},
      {"0"},
      {"1"}
     }], ")"}]}], TraditionalForm]], "Text",
 CellChangeTimes->{
  3.702920096810151*^9, {3.7034159035330067`*^9, 3.703415986921315*^9}, {
   3.7034163439784193`*^9, 3.703416452290018*^9}, {3.7034165159853992`*^9, 
   3.703416583482864*^9}, 3.7034207841917553`*^9, {3.703421256873003*^9, 
   3.7034212665548487`*^9}, {3.7034213110763407`*^9, 3.703421313152891*^9}, {
   3.703422337490293*^9, 3.703422597898292*^9}, {3.703422644333795*^9, 
   3.703422674869391*^9}, {3.7034227454229183`*^9, 3.7034230089491787`*^9}, {
   3.703423483544064*^9, 3.703423522860138*^9}, {3.703423680535013*^9, 
   3.703423750581588*^9}}],

Cell[TextData[{
 "I\[CloseCurlyQuote]ve moved to Chris\[CloseCurlyQuote]s notation where the \
open channel is the last one and the first ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "-", "1"}], TraditionalForm]]],
 " channels are closed."
}], "Text",
 CellChangeTimes->{{3.703421286951703*^9, 3.703421306994753*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetupPotentialTriDiag", "[", 
   RowBox[{"NumChan_", ",", "D0_", ",", "\[Epsilon]1_", ",", "\[Gamma]_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "j", ",", "\[Epsilon]thresh", ",", "\[CapitalLambda]vals", ",",
       "U", ",", "V"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"\[Epsilon]thresh", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Epsilon]1", " ", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]thresh", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "NumChan"}], ",", "0", ",", 
          RowBox[{"i", " ", "\[Epsilon]1"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"V", "=", 
