Cell[CellGroupData[{

Cell["Looping over parameters and energy", "Subsection",
 CellChangeTimes->{{3.703440520956689*^9, 3.703440533275667*^9}, {
  3.703516930875629*^9, 3.703516931888296*^9}}],

Cell["\<\
Using the functions defined above, we should now be able to loop over \
potential parameters and energy.  The first step is to define the potential, \
and transformation to dressed states:\
\>", "Text",
 CellChangeTimes->{{3.703440534768366*^9, 3.70344059346771*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NCHAN", "=", "3"}], ";", 
  RowBox[{"D0", "=", "10000.0"}], ";", 
  RowBox[{"\[Epsilon]1", "=", "500.0"}], ";", 
  RowBox[{"\[Gamma]", "=", "100.0"}], ";", 
  RowBox[{"NumOpen", "=", "1"}], ";", 
  RowBox[{"L", "=", "0"}], ";", 
  RowBox[{"rmatch", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalLambda]", ",", "U", ",", "\[Epsilon]th", ",", "V"}], 
    "}"}], "=", 
   RowBox[{"SetupPotentialTriDiag", "[", 
    RowBox[{"NCHAN", ",", "D0", ",", "\[Epsilon]1", ",", "\[Gamma]"}], 
    "]"}]}], ";"}]}], "Input",
