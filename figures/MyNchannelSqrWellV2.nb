  3.702318554228112*^9}, {3.702319282766176*^9, 3.7023192852972527`*^9}, {
  3.7028544074561863`*^9, 3.702854440399633*^9}, {3.7029227268144617`*^9, 
  3.7029227288043547`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
       RowBox[{"BesselJ", "[", 
