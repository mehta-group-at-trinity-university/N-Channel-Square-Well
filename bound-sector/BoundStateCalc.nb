Notebook[{

Cell[CellGroupData[{
Cell["Coupled Square Well Bound States", "Title",
 CellChangeTimes->{{3.7063659772396793`*^9, 3.7063660215327387`*^9}}],

Cell[CellGroupData[{

Cell["Setup", "Section",
 CellChangeTimes->{{3.706366035389666*^9, 3.706366044811548*^9}}],

Cell["Solutions of just the diagonal operator are:", "Text",
 CellChangeTimes->{{3.703418110045464*^9, 3.703418134868466*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       FractionBox["1", "2"]}], ",", 
      RowBox[{"k", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7023181956761847`*^9, 3.702318255529701*^9}, {
  3.702318472957452*^9, 3.702318486560416*^9}, {3.7023185367232847`*^9, 
  3.702318554228112*^9}, {3.702319282766176*^9, 3.7023192852972527`*^9}, {
  3.7028544074561863`*^9, 3.702854440399633*^9}, {3.7029227268144617`*^9, 
  3.7029227288043547`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
       RowBox[{"BesselJ", "[", 
        RowBox[{
         RowBox[{"L", "+", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{"k", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7029226895450687`*^9, 3.7029227235156097`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
    RowBox[{"BesselY", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       FractionBox["1", "2"]}], ",", 
      RowBox[{"k", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.702854656410961*^9, 3.70285466632973*^9}, {
  3.702922751133884*^9, 3.7029227534518414`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dg", "[", 
    RowBox[{"L_", ",", "k_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["\[Pi]", "2"], "k", " ", "r"}]], 
       RowBox[{"BesselY", "[", 
        RowBox[{
         RowBox[{"L", "+", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{"k", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.702922755520462*^9, 3.7029227886036*^9}}],

Cell["\<\
I\[CloseCurlyQuote]ll multiply the decaying function by a constant to rescale \
it for the strongly closed channels.\
\>", "Text",
 CellChangeTimes->{{3.703433719425181*^9, 3.703433737842691*^9}, 
   3.70351624809765*^9, 3.705282381172503*^9, {3.7064379457397327`*^9, 
   3.706437946364079*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{
       FractionBox["2", "\[Pi]"], "\[Kappa]", " ", "r"}]], 
     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{"L", "+", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{"\[Kappa]", " ", "r"}]}], "]"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Kappa]", " ", "Rshift"}]]}], "/.", 
    RowBox[{"Rshift", "\[Rule]", "0"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.70231870292422*^9, 3.702318731449788*^9}, 
   3.702318784881133*^9, {3.702319289133815*^9, 3.70231929138938*^9}, {
   3.702854524728962*^9, 3.7028545573411627`*^9}, {3.7029227940936823`*^9, 
   3.702922797290936*^9}, {3.7034335905997677`*^9, 3.703433617541026*^9}, {
   3.70343366804617*^9, 3.703433668765458*^9}, {3.7034596169271803`*^9, 
   3.703459617204762*^9}, {3.703467775594838*^9, 3.703467780089224*^9}, {
   3.703468710146822*^9, 3.703468712298018*^9}, {3.703712414989415*^9, 
   3.703712415317358*^9}, 3.705282385721601*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dgb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"gb", "[", 
       RowBox[{"L", ",", "\[Kappa]", ",", "r"}], "]"}], ",", "r"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.702922808221755*^9, 3.7029228357083073`*^9}, {
  3.7034312333786993`*^9, 3.703431248225692*^9}, {3.703433631655361*^9, 
  3.703433642758718*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["2", "\[Pi]"], " ", "\[Kappa]", " ", "r"}]], 
    RowBox[{"BesselI", "[", 
     RowBox[{
      RowBox[{"L", "+", 
       RowBox[{"1", "/", "2"}]}], ",", 
      RowBox[{"\[Kappa]", " ", "r"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.70343124696681*^9, 3.7034312892984*^9}, {
  3.703431342981278*^9, 3.7034313454666157`*^9}, {3.703431481724772*^9, 
  3.703431482003531*^9}, {3.703852470119142*^9, 3.703852470632457*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dfb", "[", 
    RowBox[{"L_", ",", "\[Kappa]_", ",", "r_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         FractionBox["2", "\[Pi]"], " ", "\[Kappa]", " ", "r"}]], 
       RowBox[{"BesselI", "[", 
        RowBox[{
         RowBox[{"L", "+", 
          RowBox[{"1", "/", "2"}]}], ",", 
         RowBox[{"\[Kappa]", " ", "r"}]}], "]"}]}], ",", "r"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.703431493567836*^9, 3.7034315051071653`*^9}, {
  3.703852482366887*^9, 3.7038524828387012`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetupPotentialTriDiag", "[", 
   RowBox[{"NumChan_", ",", "D0_", ",", "\[Epsilon]1_", ",", "\[Gamma]_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "j", ",", "\[Epsilon]thresh", ",", "\[CapitalLambda]vals", ",",
       "U", ",", "V"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"\[Epsilon]thresh", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Epsilon]1", " ", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]thresh", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "NumChan"}], ",", "0", ",", 
          RowBox[{"i", " ", "\[Epsilon]1"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"V", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "j"}], ",", 
          RowBox[{
           RowBox[{"-", "D0"}], "+", 
           RowBox[{"i", " ", "\[Epsilon]1"}], "-", 
           RowBox[{"i", " ", "\[Epsilon]1", 
            RowBox[{"(", 
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "NumChan"}], "]"}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", 
               RowBox[{"j", "-", "1"}]}], "]"}], "+", " ", 
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", 
               RowBox[{"j", "+", "1"}]}], "]"}]}], ")"}], "\[Gamma]"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]vals", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Eigenvalues", "[", "V", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"U", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"Eigenvectors", "[", "V", "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "NumChan"}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalLambda]vals", ",", "U", ",", "\[Epsilon]thresh", ",", "V"}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.7063743285196333`*^9, 3.706374716808579*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"TEQ0", "[", 
   RowBox[{"r0_", ",", "v0_", ",", "\[Epsilon]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"r0", " ", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]]}], "]"}]}], "+", 
   RowBox[{
    SqrtBox[
     RowBox[{"-", "\[Epsilon]"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"r0", " ", 
      SqrtBox[
       RowBox[{"v0", "+", "\[Epsilon]"}]]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.706376417516831*^9, 3.706376450338232*^9}}],

Cell["When the energy is zero,", "Text",
 CellChangeTimes->{{3.706406044659027*^9, 3.7064060488040524`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TEQ0", "[", 
  RowBox[{"1", ",", "v0", ",", "0"}], "]"}]], "Input",
 CellChangeTimes->{{3.706406050614011*^9, 3.7064060609251337`*^9}}],

Cell[BoxData[
 RowBox[{
  SqrtBox["v0"], " ", 
  RowBox[{"Cos", "[", 
   SqrtBox["v0"], "]"}]}]], "Output",
 CellChangeTimes->{{3.706406058135435*^9, 3.706406061362792*^9}, 
   3.706437964505143*^9, 3.706487192484247*^9}]
}, Open  ]],

Cell[TextData[{
 "suggests ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      SubscriptBox["v", "0"]], "=", 
     RowBox[{
      FractionBox["1", "2"], "\[Pi]"}]}], ",", " ", 
    RowBox[{
     FractionBox["3", "2"], "\[Pi]"}], ",", "..."}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.706406083969327*^9, 3.7064061512607393`*^9}}],

Cell[TextData[{
 "so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"n", "+", 
        FractionBox["1", "2"]}], ")"}], "2"], 
     SuperscriptBox["\[Pi]", "2"]}]}], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", "1", ",", "2", ",", "..."}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.706406083969327*^9, 3.7064061679582987`*^9}, {
  3.70640678057661*^9, 3.706406818006267*^9}, {3.706437790639159*^9, 
  3.706437795204452*^9}}],

Cell[TextData[{
 "Solving this for ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " gives the approximate number of bound states as a function of the depth ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.7064064277259407`*^9, 3.7064064792155523`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"n", "=", 
   RowBox[{
    FractionBox[
     SqrtBox[
      SubscriptBox["v", "0"]], "\[Pi]"], "-", 
    FractionBox["1", "2"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.706406482673071*^9, 3.706406519573653*^9}}],

Cell[TextData[{
 "The number of bound states is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.70640702130394*^9, 3.706407033701193*^9}}],

