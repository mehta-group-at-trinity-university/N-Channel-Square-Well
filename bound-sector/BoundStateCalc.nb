Cell["\<\
Okay, this is interesting because it tells me that the cusps in the plot of \
the determinant correspond to the well bottoms.  In the weak coupling limit, \
the zeros of the determinant coincide with the zeros of the uncoupled \
transcendental equations for each channel.\
\>", "Text",
 CellChangeTimes->{{3.706528027830607*^9, 3.706528065372756*^9}, {
  3.706528199737617*^9, 3.706528236118951*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NumLam", "=", "40"}], ";", 
  RowBox[{"dLam", "=", 
   RowBox[{"1.0", "/", 
    RowBox[{"(", "NumLam", ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", "*", "dLam"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "NumLam"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BSrootguess", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BSroots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", "10"}], "]"}], ",", "NumLam"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.70653054636446*^9, {3.7065306583836813`*^9, 3.706530668316586*^9}, 
   3.706530712097899*^9, {3.7065307722722197`*^9, 3.706530786635045*^9}, {
   3.7065312536344423`*^9, 3.7065312539449253`*^9}, {3.706531789062806*^9, 
   3.706531791062317*^9}, {3.706532687990128*^9, 3.706532688635644*^9}, 
   3.7065334141796093`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"BSList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", ",", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ilam", ",", "1", ",", "NumLam"}], "}"}]}], "]"}], ",", 
     "10"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.706530894122007*^9, 3.7065309595764523`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{
      RowBox[{"Vdiag", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"1", ";;", "nc"}], ",", 
         RowBox[{"1", ";;", "nc"}]}], "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"[", "ilam", "]"}], "]"}], " ", 
       RowBox[{"Voffdiag", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", "nc"}], ",", 
          RowBox[{"1", ";;", "nc"}]}], "]"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"MatrixForm", "[", "V", "]"}], "]"}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalLambda]", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Eigenvalues", "[", "V", "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"U", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "V", "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "nc"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"BSSectorGridSearch", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Energy", ",", 
         RowBox[{"BSTEQ", "[", 
          RowBox[{
          "Energy", ",", "\[CapitalLambda]", ",", "U", ",", "L", ",", 
           "\[Epsilon]thresh", ",", "r0", ",", "nc"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Energy", ",", "Emin", ",", "Emax", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Emax", "-", "Emin"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"NumSearch", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rn", "=", "1"}], ";", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"BSSectorGridSearch", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], 
          RowBox[{"Sign", "[", 
           RowBox[{"BSSectorGridSearch", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}], "]"}]}], 
         "\[LessEqual]", " ", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"BSrootguess", "[", 
           RowBox[{"[", "rn", "]"}], "]"}], "=", 
          RowBox[{"BSSectorGridSearch", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
         RowBox[{"rn", "+=", "1"}], ";"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", "NumSearch"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"BSrootguess", "=", 
     RowBox[{"BSrootguess", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"rn", "-", "1"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BSroots", "[", 
      RowBox[{"[", "ilam", "]"}], "]"}], "=", "BSrootguess"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"BSroots", "[", 
          RowBox[{"[", 
           RowBox[{"ilam", ",", "i"}], "]"}], "]"}], "=", 
         RowBox[{"Energy", "/.", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"BSTEQ", "[", 
              RowBox[{
              "Energy", ",", "\[CapitalLambda]", ",", "U", ",", "L", ",", 
               "\[Epsilon]thresh", ",", "r0", ",", "nc"}], "]"}], "\[Equal]", 
             "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"Energy", ",", 
              RowBox[{"BSrootguess", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"rn", "-", "1"}]}], "}"}]}], "]"}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"[", "ilam", "]"}], "]"}], ",", 
      RowBox[{"BSroots", "[", 
       RowBox[{"[", "ilam", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"BSList", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "ilam"}], "]"}], "]"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", 
          RowBox[{"[", "ilam", "]"}], "]"}], ",", 
         RowBox[{"BSroots", "[", 
          RowBox[{"[", 
           RowBox[{"ilam", ",", "i"}], "]"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"rn", "-", "1"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"ilam", ",", "1", ",", "NumLam"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7064484173541393`*^9, 3.706448420262372*^9}, {
