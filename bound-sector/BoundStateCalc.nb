Cell[CellGroupData[{

Cell["Brody Parameter", "Subsection",
 CellChangeTimes->{{3.706871609159338*^9, 3.706871611966408*^9}}],

Cell["Fit the level spacing distribution to:", "Text",
 CellChangeTimes->{{3.7068716135696583`*^9, 3.706871624797716*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PBrody", "[", 
    RowBox[{"w_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "w"}], 
        RowBox[{"1", "+", "w"}]], "]"}], ")"}], 
     RowBox[{"1", "+", "w"}]], 
    SuperscriptBox["x", "w"], 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          FractionBox[
           RowBox[{"2", "+", "w"}], 
           RowBox[{"1", "+", "w"}]], "]"}], "x"}], ")"}], 
       RowBox[{"1", "+", "w"}]]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]Brody", "[", "w_", "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     FractionBox[
      RowBox[{"2", "+", "w"}], 
      RowBox[{"1", "+", "w"}]], "]"}], 
    RowBox[{"1", "+", "w"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ABrody", "[", "w_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]Brody", "[", "w", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.706871634934313*^9, 3.7068717316812572`*^9}, {
  3.706878155666654*^9, 3.7068782349352407`*^9}, {3.7069051530335903`*^9, 
  3.706905154655449*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"CBrody", "[", 
   RowBox[{"w_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"1", "-", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Alpha]Brody", "[", "w", "]"}]}], " ", 
     SuperscriptBox["z", 
      RowBox[{"1", "+", "w"}]]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.707047233179413*^9, 3.707047239399794*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"CBrody", "[", 
    RowBox[{"w", ",", "z"}], "]"}], ",", "z"}], "]"}]], "Input",
 CellChangeTimes->{{3.70704724383106*^9, 3.707047252967126*^9}}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["z", 
      RowBox[{"1", "+", "w"}]]}], " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"2", "+", "w"}], 
       RowBox[{"1", "+", "w"}]], "]"}], 
     RowBox[{"1", "+", "w"}]]}]], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "w"}], ")"}], " ", 
  SuperscriptBox["z", "w"], " ", 
  SuperscriptBox[
   RowBox[{"Gamma", "[", 
    FractionBox[
     RowBox[{"2", "+", "w"}], 
     RowBox[{"1", "+", "w"}]], "]"}], 
   RowBox[{"1", "+", "w"}]]}]], "Output",
 CellChangeTimes->{3.707047253475528*^9, 3.707060162486785*^9, 
  3.7070602546294622`*^9, 3.707216392992072*^9, 3.707490896429652*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"u", "\[Equal]", 
     RowBox[{"CBrody", "[", 
      RowBox[{"w", ",", "z"}], "]"}]}], ",", "z"}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.7070473179826393`*^9, 3.7070473418916807`*^9}, {
  3.7070473855722113`*^9, 3.70704738597745*^9}}],

