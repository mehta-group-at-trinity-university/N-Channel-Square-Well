  3.707216394102069*^9, 3.707490897564888*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"z", "\[Rule]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          FractionBox[
           RowBox[{"2", "+", "w"}], 
           RowBox[{"1", "+", "w"}]], "]"}], 
         RowBox[{
          RowBox[{"-", "1"}], "-", "w"}]]}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "u"}], "]"}]}], ")"}], 
     FractionBox["1", 
      RowBox[{"1", "+", "w"}]]]}], "}"}], "}"}]], "Output",
