      RowBox[{
       RowBox[{
        RowBox[{"Gmat", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
        FractionBox[
         RowBox[{"dgb", "[", 
