Cell["\<\
Find the exact bindings using the WKB values as an initial guess:\
\>", "Text",
 CellChangeTimes->{{3.706439649214357*^9, 3.706439670704771*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"r0", "=", "1"}], ";", 
  RowBox[{"v0", "=", "400"}], ";", 
  RowBox[{"Binding", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{
            FractionBox[
             SqrtBox["v0"], "\[Pi]"], "+", 
            FractionBox["1", "2"]}], "]"}], "\[GreaterEqual]", "n"}], ",", 
         RowBox[{"{", 
          RowBox[{"v0", ",", 
           RowBox[{"\[Epsilon]", "/.", 
            RowBox[{
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{"TEQ0", "[", 
                RowBox[{"r0", ",", "v0", ",", "\[Epsilon]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Epsilon]", ",", 
                 RowBox[{
                  RowBox[{"-", "v0"}], "+", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"n", "-", 
                    RowBox[{"1", "/", "3"}]}], ")"}], "2"], 
                   SuperscriptBox["\[Pi]", "2"]}]}]}], "}"}], ",", 
               RowBox[{"AccuracyGoal", "\[Rule]", "5"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", ",", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v0", ",", "0", ",", "100", ",", ".1"}], "}"}]}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{
         FractionBox[
          SqrtBox["v0"], "\[Pi]"], "+", 
         FractionBox["1", "2"]}], "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.706439279681932*^9, 3.706439280226385*^9}, {
   3.706439322740526*^9, 3.7064393686806*^9}, {3.7064394539472857`*^9, 
   3.7064396249490232`*^9}, {3.7064400478605967`*^9, 3.706440056303514*^9}, {
