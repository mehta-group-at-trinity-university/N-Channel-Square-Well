      "d\[CapitalPhi]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Gmat", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumClosed"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "NumClosed"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
