    AbsolutePointSize[6], "ScalingFunctions" -> None, 
    "CoordinatesToolOptions" -> {"DisplayFunction" -> ({
        (Part[{{Identity, Identity}, {Identity, Identity}}, 1, 2][#]& )[
         Part[#, 1]], 
        (Part[{{Identity, Identity}, {Identity, Identity}}, 2, 2][#]& )[
         Part[#, 2]]}& ), "CopiedValueFunction" -> ({
        (Part[{{Identity, Identity}, {Identity, Identity}}, 1, 2][#]& )[
         Part[#, 1]], 
        (Part[{{Identity, Identity}, {Identity, Identity}}, 2, 2][#]& )[
         Part[#, 2]]}& )}},
  PlotRange->{{0, 500}, {0., 7.}},
  PlotRangeClipping->True,
  PlotRangePadding->{{
     Scaled[0.02], 
     Scaled[0.02]}, {
     Scaled[0.05], 
     Scaled[0.05]}},
  Ticks->{Automatic, Automatic}]], "Output",
 CellChangeTimes->{{3.706406738918295*^9, 3.7064067549938393`*^9}, 
   3.706407039885736*^9, 3.706437179967201*^9, {3.706437246568262*^9, 
   3.706437261649556*^9}}]
}, Open  ]],

Cell[TextData[{
 "This is quite useful because we can immediately estimate the total density \
of states for an ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]]],
 "-channel problem by noting that the total number of bound states in the \
uncoupled limit is:"
}], "Text",
 CellChangeTimes->{{3.706407097773615*^9, 3.706407166769493*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["n", "tot"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["V", 
         RowBox[{"i", " ", "i"}]], "+", 
        SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "\[Pi]"], "+", 
      FractionBox["1", "2"]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
  3.706407269179851*^9, 3.70640728058729*^9}, {3.706437320044181*^9, 
  3.70643732005888*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Rho]", "=", 
   FractionBox["1", 
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["V", 
          RowBox[{"i", " ", "i"}]], "+", 
         SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "\[Pi]"], "+", 
       FractionBox["1", "2"]}], ")"}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
  3.706407269179851*^9, 3.70640728058729*^9}, {3.706437320044181*^9, 
  3.706437340582612*^9}}],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"i", " ", "i"}]], "+", 
     SubsuperscriptBox["\[Epsilon]", "i", "th"]}], "=", 
    SubscriptBox["D", "i"]}], TraditionalForm]],
  CellChangeTimes->{{3.70640713814791*^9, 3.70640723774119*^9}, {
   3.706407269179851*^9, 3.70640728058729*^9}}],
 " is the total depth of the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 "th channel."
}], "Text",
 CellChangeTimes->{{3.706407293248767*^9, 3.706407384422244*^9}, {
  3.706407452695809*^9, 3.706407454423995*^9}, {3.706437310775002*^9, 
  3.706437317028542*^9}}],

Cell["\<\
The energies may be easily plotted as a contour plot.  And compared to the \
approximate energies from the infinite square well:\
\>", "Text",
 CellChangeTimes->{{3.7064025894041224`*^9, 3.706402599046376*^9}, {
  3.706403191799199*^9, 3.706403207950688*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Mu]"}], 
       SuperscriptBox["\[HBar]", "2"]], 
      RowBox[{"(", 
       RowBox[{"E", "+", 
        SubscriptBox["V", "0"]}], ")"}]}]], " ", 
    SubscriptBox["r", "0"]}], "=", 
   RowBox[{"n", " ", "\[Pi]"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.706403226390329*^9, {3.7064032588689013`*^9, 3.706403259068685*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Epsilon]", " ", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "2"], " ", 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    SubscriptBox["v", "0"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7064032412557707`*^9, 3.7064032647403727`*^9}, {
  3.706403295225522*^9, 3.706403311513691*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
    RowBox[{"n", " ", "\[Pi]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.706404859658216*^9, 3.7064048778316593`*^9}, {
  3.706438021237844*^9, 3.706438032555088*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", "\[Pi]"}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"2", " ", "\[Pi]"}]}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"3", " ", "\[Pi]"}]}], ",", 
   RowBox[{
    SqrtBox[
     RowBox[{"v0", "+", "\[Epsilon]"}]], "\[Equal]", 
    RowBox[{"4", " ", "\[Pi]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.7064048600639477`*^9, 3.706404878248433*^9}, 
   3.706405365154366*^9, 3.706438035364337*^9, 3.706487208789798*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vmax", "=", "30"}], ";", 
  RowBox[{"pwkb", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "\[Pi]"}]}], ",", ",", 
       RowBox[{
        SqrtBox[
         RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "\[Pi]"}]}], ",", 
       RowBox[{
        SqrtBox[
         RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "\[Pi]"}]}], ",", 
       RowBox[{
        SqrtBox[
         RowBox[{"\[Epsilon]", "+", "v0"}]], "\[Equal]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "\[Pi]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"v0", ",", "0", ",", "vmax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", 
       RowBox[{
        RowBox[{"-", "v0"}], "+", "2"}], ",", "0"}], "}"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", "Large"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(V\), \
\(0\)]\)/(\!\(\*SuperscriptBox[\(\[HBar]\), \
\(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\"", ",", 
        "\"\<E/(\!\(\*SuperscriptBox[\(\[HBar]\), \
\(2\)]\)/2\!\(\*SubsuperscriptBox[\(\[Mu]r\), \(0\), \(2\)]\))\>\""}], 
       "}"}]}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"{", "Blue", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pinfwell", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
