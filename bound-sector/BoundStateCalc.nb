Cell[BoxData[
 RowBox[{
  RowBox[{"SetupThresh", "[", 
   RowBox[{"NumChan_", ",", "D0_", ",", "gscale_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r0", ",", "i", ",", "j", ",", "\[Epsilon]thresh", ",", 
      "\[CapitalLambda]vals", ",", "U", ",", "V", ",", "offsets", ",", "B1", 
      ",", "\[Epsilon]", ",", "OffsetRange", ",", "\[Epsilon]1"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r0", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"B1", " ", "=", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "\[Epsilon]", "]"}], "/.", 
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"TEQ0", "[", 
           RowBox[{"r0", ",", "D0", ",", "\[Epsilon]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", 
            RowBox[{
             RowBox[{"-", "D0"}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "2"], 
              SuperscriptBox["\[Pi]", "2"]}]}]}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "\[Rule]", "5"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<B1 = \>\"", ",", "B1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]1", "=", 
      RowBox[{"B1", "+", 
       RowBox[{"B1", "/", "10.0"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"OffsetRange", "=", 
      RowBox[{"D0", "-", "\[Epsilon]1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<OffsetRange = \>\"", ",", "OffsetRange"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]thresh", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Epsilon]thresh", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", 
         RowBox[{"NumChan", "-", "1"}]}], "]"}], "]"}], "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"\[Epsilon]1", "+", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "OffsetRange"}], "}"}], ",", 
          RowBox[{"NumChan", "-", "1"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Epsilon]thresh", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\[Epsilon]1", " ", 
           RowBox[{"(", 
            RowBox[{"i", "-", "1"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Epsilon]thresh", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[Equal]", "NumChan"}], ",", "0", ",", 
            RowBox[{"i", " ", "\[Epsilon]1"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "NumChan"}], "}"}]}], "]"}]}], ";"}], 
      "*)"}], "\[IndentingNewLine]", "\[Epsilon]thresh"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
