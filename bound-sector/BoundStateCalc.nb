Cell[BoxData[
 RowBox[{
  RowBox[{"BrodySample", "[", 
   RowBox[{"w_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"u", ",", "z"}], "}"}], ",", 
    RowBox[{
     RowBox[{"u", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"Gamma", "[", 
           FractionBox[
            RowBox[{"2", "+", "w"}], 
            RowBox[{"1", "+", "w"}]], "]"}], 
          RowBox[{
           RowBox[{"-", "1"}], "-", "w"}]]}], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "u"}], "]"}]}], ")"}], 
      FractionBox["1", 
       RowBox[{"1", "+", "w"}]]]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.70704743946627*^9, 3.707047619112027*^9}, {
  3.707048011633909*^9, 3.707048013170595*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w0", "=", "0.954"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NP", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dx", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bins", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"t", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "5", ",", "dx"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"samp", "=", 
   RowBox[{"BrodySample", "[", 
    RowBox[{"w0", ",", "NP"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"BinCounts", "[", 
      RowBox[{"samp", ",", 
       RowBox[{"{", "Bins", "}"}]}], "]"}], "/", "NP"}], "/", "dx"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bnorm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Bins", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ")"}], ",", 
       RowBox[{"bc", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "Bins", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bfit", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Bins", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+", 
          RowBox[{"Bins", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
       RowBox[{"bc", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "Bins", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ph", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"bnorm", ",", 
     RowBox[{"InterpolationOrder", "\[Rule]", "0"}], ",", 
     RowBox[{"Joined", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pe", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"PBrody", "[", 
      RowBox[{"w0", ",", "z"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nlm", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"bfit", ",", 
     RowBox[{"{", 
      RowBox[{"PBrody", "[", 
       RowBox[{"w", ",", "z"}], "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"w", ",", "0"}], "}"}], "}"}], ",", "z", ",", 
     RowBox[{"Method", "->", "\"\<LevenbergMarquardt\>\""}], ",", 
     RowBox[{"ConfidenceLevel", "\[Rule]", "0.99"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pb", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"PBrody", "[", 
      RowBox[{
       RowBox[{"w", "/.", 
        RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", "z"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", "Red", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ph", ",", "pe", ",", "pb"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.707047983474135*^9, 3.707048122162594*^9}, {
