Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "1000"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lst1", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{"Sort", "[", "t1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{"Mean", "[", "lst1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dx", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ls", "=", 
   RowBox[{"lst1", "/", "d"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bins", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"t", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "5", ",", "dx"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bc1", "=", 
   RowBox[{"BinCounts", "[", 
    RowBox[{"ls", ",", 
     RowBox[{"{", "bins", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bnorm", "=", 
   RowBox[{
    RowBox[{"bc1", "/", 
     RowBox[{"Total", "[", "bc1", "]"}]}], "/", "dx"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w0", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]0", "=", 
   RowBox[{"\[Alpha]Brody", "[", "w0", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]test", "=", 
   RowBox[{"1", "-", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Alpha]0"}], " ", 
      SuperscriptBox["ls", 
       RowBox[{"1", "+", "w0"}]]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Phi]i", "=", 
   RowBox[{"Sort", "[", "\[Phi]test", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"di", "=", 
   RowBox[{"Differences", "[", "\[Phi]i", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"{", 
   RowBox[{"\[Phi]i", ",", "di"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"FindFit", "[", 
  RowBox[{
   RowBox[{"Sort", "[", "di", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", " ", 
     SuperscriptBox["y", "2"]}], "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", "y"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"w0", ",", 
   RowBox[{
    RowBox[{"b", "/", "a"}], "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{"\[Phi]i", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", " ", "y"}], " ", "+", " ", 
        RowBox[{"b", " ", 
         SuperscriptBox["y", "2"]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", "y"}], "]"}]}]}], "}"}]}], "Input",\

