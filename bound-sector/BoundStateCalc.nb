Cell["\<\
This looks like what I would expect!  Some avoided crossings as I crank up \
the couplings as well as some level repulsion.  This calculation is slow \
compared to Chris\[CloseCurlyQuote]s sparse matrix calculation.\
\>", "Text",
 CellChangeTimes->{{3.706533049555558*^9, 3.706533177902689*^9}, {
  3.706533267418886*^9, 3.706533267858646*^9}}],

Cell[CellGroupData[{

Cell[BoxData["BSroots"], "Input",
 CellChangeTimes->{{3.7064492465859118`*^9, 3.706449248376871*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "3.5543443948933025`"}], ",", "1.4375065764545045`", ",", 
   "1.7400429989604316`", ",", "1.891311210213395`", ",", 
   "2.0425794214663604`", ",", "2.496384055225251`", ",", 
