Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nt"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ip", ",", "nt"}], "}"}]}], "]"}]}], ";", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"[", 
        RowBox[{"pos0", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "=", 
      RowBox[{"val0", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "iz"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eval", ",", "vec"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", "H", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"nb", "=", "0"}], ";", "\[IndentingNewLine]", 
   RowBox[{"ihold", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nx"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eval", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "<", "0"}], ",", 
       RowBox[{
        RowBox[{"nb", "=", 
         RowBox[{"nb", "+", "1"}]}], ";", 
        RowBox[{
         RowBox[{"ihold", "[", 
          RowBox[{"[", "nb", "]"}], "]"}], "=", "i"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nt"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"sval", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"eval", "[", 
       RowBox[{"[", 
        RowBox[{"ihold", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nb"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"svec", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"vec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"ihold", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "j"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nb"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "nt"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"nb", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"norm", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"dx", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"svec", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "i"}], "]"}], "]"}], "^", "2"}], " ", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nt"}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"svec", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"svec", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i"}], "]"}], "]"}], "/", "norm"}]}], ";"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nt"}], "}"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "nb"}], "}"}]}], "]"}]}], ";"}], 
  "*)"}]], "Input",
