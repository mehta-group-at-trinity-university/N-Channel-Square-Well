Cell[BoxData[{
 RowBox[{
  RowBox[{"plots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "np"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"lim", "=", 
     RowBox[{"Ehold", "[", 
      RowBox[{"[", "ip", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"short", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Phold", "[", 
        RowBox[{"[", 
         RowBox[{"ip", ",", "i"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "lim"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"dos", "=", 
     RowBox[{
      RowBox[{"Length", "[", "short", "]"}], "/", "d"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sdos", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"short", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
         RowBox[{"short", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"lim", "-", "1"}]}], "}"}]}], "]"}], "*", "dos"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"plots", "[", 
      RowBox[{"[", "ip", "]"}], "]"}], "=", 
     RowBox[{"Histogram", "[", 
      RowBox[{"sdos", ",", "10", ",", "\"\<Probability\>\""}], "]"}]}], ";"}],
    "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"ip", ",", "np"}], "}"}]}], "]"}]}], "Input",
