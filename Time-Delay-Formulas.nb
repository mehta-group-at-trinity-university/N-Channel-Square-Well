Cell[BoxData[
 RowBox[{"Together", "[", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{
              RowBox[{"k", "[", "e", "]"}], " ", "r"}], "]"}], ",", "e"}], 
           "]"}], ",", "e"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "''"}], "[", 
           RowBox[{"r", " ", 
            RowBox[{"k", "[", "e", "]"}]}], "]"}], "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"L", "(", 
               RowBox[{"L", "+", "1"}], ")"}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"k", "[", "e", "]"}], "r"}], ")"}], "2"]], "+", 
             "1"}], ")"}], 
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"k", "[", "e", "]"}], "r"}], "]"}]}]}], "}"}]}], ",", 
       "e"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "e", "]"}], "\[Rule]", "ek"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "'"}], "[", "e", "]"}], "->", 
        RowBox[{"-", 
         FractionBox["twomu", 
          RowBox[{"2", " ", "ek"}]]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "''"}], "[", "e", "]"}], "->", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["twomu", "2"], 
          RowBox[{"4", " ", 
           SuperscriptBox["ek", "3"]}]]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "'''"}], "[", "e", "]"}], "->", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"3", " ", 
           SuperscriptBox["twomu", "3"]}], 
          RowBox[{"8", " ", 
           SuperscriptBox["ek", "5"]}]]}]}]}], "}"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"ek", " ", "r"}], "]"}], "\[Rule]", "rk"}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["g", "\[Prime]",
         MultilineFunction->None], "[", 
        RowBox[{"r", " ", 
         RowBox[{"k", "[", "e", "]"}]}], "]"}], "\[Rule]", "gp"}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["g", "\[Prime]",
         MultilineFunction->None], "[", 
        RowBox[{"ek", " ", "r"}], "]"}], "\[Rule]", "gp"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "''"}], "[", 
        RowBox[{"ek", " ", "r"}], "]"}], "\[Rule]", "gpp"}]}], "}"}]}], "]"}],
   "]"}]], "Input",
 CellChangeTimes->{{3.7396358139323463`*^9, 3.739635849479368*^9}, {
  3.739635940096715*^9, 3.739635951798394*^9}, {3.739636078317285*^9, 
