Cell[TextData[{
 "where the diagonal elements of ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "f4a58e18-277a-429f-b367-039775b43425"],
 " are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "3591749d-ac39-435e-8b80-28ecf6c369ca"],
 "."
}], "Text",
 CellChangeTimes->{{3.739058094941429*^9, 
  3.739058110678027*^9}},ExpressionUUID->"a42f0818-31e4-4777-b0e8-\
c99aa397305d"],

Cell[TextData[{
 "The constants ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "c33bee91-99cb-4053-9007-4f56e8639560"],
 " must be chosen to match smoothly onto exterior solutions.  The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["B",
      FontWeight->"Bold"], 
     StyleBox["(",
      FontWeight->"Plain"], 
     StyleBox["E",
      FontWeight->"Plain"], 
     StyleBox[")",
      FontWeight->"Plain"]}]}], TraditionalForm]],ExpressionUUID->
  "ab7ba2c1-49a2-4e75-9f63-0dc9ac86eb7d"],
 " is a function of the energy, but ",
 Cell[BoxData[
  FormBox[
   StyleBox["U",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "fd439e1a-f285-4cd2-86fc-952670dfedab"],
 " is independent of the energy."
}], "Text",
 CellChangeTimes->{{3.739058161416998*^9, 3.739058234646007*^9}, {
