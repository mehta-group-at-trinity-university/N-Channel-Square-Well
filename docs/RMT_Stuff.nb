     SubscriptBox["V", "2"], "(", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "14"], ")"}], "+", 
    RowBox[{
     SubscriptBox["V", "2"], "(", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "23"], ")"}], "+", 
    RowBox[{
     SubscriptBox["V", "2"], "(", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "24"], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6724380420892887`*^9, 3.6724380996995*^9}, {
