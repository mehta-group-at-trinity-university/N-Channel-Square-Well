     RowBox[{"t", "\[Rule]", 
      RowBox[{"-", "0.386595"}]}], ",", 
     RowBox[{"Q", "\[Rule]", "0.27846"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.672069358264539*^9, 3.672069471944064*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 RowBox[{
  RowBox[{"Qf", "[", 
   RowBox[{"u_", ",", "v_", ",", "s_", ",", "t_", ",", "a_", ",", "b_"}], 
   "]"}], ":=", 
