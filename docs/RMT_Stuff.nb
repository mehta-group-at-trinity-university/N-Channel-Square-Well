  3.673796992421997*^9, 3.673796992435297*^9}, {3.673797145951624*^9, 
  3.673797150742752*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["In the relative degrees of freedom we are left with:", "Text",
 CellChangeTimes->{{3.672446068781005*^9, 3.672446171241489*^9}, {
  3.67260956007381*^9, 3.672609573761047*^9}, {3.672610255267579*^9, 
  3.6726102620432463`*^9}, {3.673796827932435*^9, 3.6737968307424517`*^9}, {
  3.673796992421997*^9, 3.6737969985064*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["H", "rel"], 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "rel"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"]}], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "rel"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.672609600331332*^9, 3.672609612495635*^9}, {
  3.672609660856086*^9, 3.672609702229622*^9}, {3.672610266343965*^9, 
  3.672610269607864*^9}, {3.673790557510548*^9, 3.673790559077189*^9}, {
  3.67379684531326*^9, 3.673796853428278*^9}, {3.673797157198696*^9, 
  3.673797163812595*^9}, {3.673800022264401*^9, 3.6738000240406322`*^9}},
 TextAlignment->Left,
 TextJustification->0.,
 CellTags->"JacobiRelSE"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["T", 
       StyleBox["R",
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", 
         StyleBox["1",
          FontWeight->"Plain"]],
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", 
         StyleBox["2",
          FontWeight->"Plain"]],
        FontWeight->"Bold"]], "+", 
      RowBox[{"V", "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"], ",", 
        StyleBox["R",
         FontWeight->"Bold"]}], ")"}]}], "]"}], 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "rel"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"]}], ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "rel"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
