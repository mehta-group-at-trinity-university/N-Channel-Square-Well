   3.6737968124987288`*^9, {3.6737969707401943`*^9, 3.673796972739406*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "2"], ",", 
