      StyleBox["R",
       FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{3.673800019402958*^9},
 TextAlignment->Left,
 TextJustification->0.],

Cell["We let the adiabatic Hamiltonian be:", "Text",
 CellChangeTimes->{{3.67379048672088*^9, 3.673790493799881*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["H", "ad"], "=", 
   RowBox[{
    SubscriptBox["T", 
     OverscriptBox["R", "^"]], "+", 
    SubscriptBox["T", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], 
      StyleBox["1",
       FontWeight->"Plain"]]], "+", 
    SubscriptBox["T", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], 
      StyleBox["2",
       FontWeight->"Plain"]]], "+", 
    RowBox[{"V", "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.673790507159224*^9, 3.6737905151231194`*^9}, 
   3.673790570711561*^9, 3.673796855211977*^9, {3.673799939782158*^9, 
   3.6737999423559933`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["with adiabatic eigenstates:", "Text",
 CellChangeTimes->{{3.673790519071196*^9, 3.6737905231345863`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SubscriptBox["T", 
         OverscriptBox["R", "^"]], "+", 
        SubscriptBox["T", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], 
          StyleBox["1",
           FontWeight->"Plain"]]], "+", 
        SubscriptBox["T", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], 
          StyleBox["2",
           FontWeight->"Plain"]]], "+", 
        RowBox[{"V", "(", 
         RowBox[{
          SubscriptBox[
           StyleBox["\[Rho]",
            FontWeight->"Bold"], "1"], ",", 
          SubscriptBox[
           StyleBox["\[Rho]",
            FontWeight->"Bold"], "2"], ",", 
          StyleBox["R",
           FontWeight->"Bold"]}], ")"}]}]}], ")"}], "]"}], 
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
     RowBox[{
      RowBox[{"R", ";", 
       OverscriptBox[
        StyleBox["R",
         FontWeight->"Bold"], "^"]}], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}], 
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
     RowBox[{
      RowBox[{"R", ";", 
       OverscriptBox[
        StyleBox["R",
         FontWeight->"Bold"], "^"]}], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673790525162792*^9, 3.673790615229752*^9}, {
  3.673790647530917*^9, 3.6737906510336647`*^9}, {3.673796859851164*^9, 
  3.673796868069009*^9}, {3.6737970078749847`*^9, 3.673797015188415*^9}, {
  3.673797669367497*^9, 3.673797673324296*^9}, {3.673799949437866*^9, 
  3.673799951446047*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[TextData[{
 "Note that the adiabatic solution depends explicitly on ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["R", "^"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", but only parametically on ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " (hence the semicolon). A channel ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is defined to be open if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", ">", 
    RowBox[{
     SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["l", "ho"], " ", "\[GreaterGreater]", "R", 
    "\[GreaterGreater]", 
    SubscriptBox["R", "vdW"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", and closed otherwise.  Now let\[CloseCurlyQuote]s postulate that the \
solution can be written as"
}], "Text",
 CellChangeTimes->{{3.672610089498776*^9, 3.6726101047388153`*^9}, {
  3.672663391468464*^9, 3.6726634167541313`*^9}, {3.673797746450655*^9, 
  3.673797869047511*^9}, {3.673797937797411*^9, 3.673797987001748*^9}, {
  3.673798059958399*^9, 3.673798068395649*^9}, {3.673800069873722*^9, 
  3.673800071773149*^9}, {3.673823538233618*^9, 3.673823542418288*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "rel"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "2"], ",", 
     StyleBox["R",
      FontWeight->"Bold"]}], ")"}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}], 
     RowBox[{
      SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.672610116852435*^9, 3.672610158656529*^9}, 
   3.6726104433679943`*^9, {3.6726621540877438`*^9, 3.672662155336195*^9}, {
   3.672662194206359*^9, 3.6726622821173887`*^9}, {3.672663314223318*^9, 
   3.672663372628398*^9}, {3.6726634810638437`*^9, 3.672663547092883*^9}, {
   3.673790453099214*^9, 3.6737904658568983`*^9}, {3.67379690183379*^9, 
   3.6737969118488703`*^9}, {3.673797022706201*^9, 3.673797031699213*^9}, 
   3.673797177492805*^9, {3.673797575562113*^9, 3.6737975939279423`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[TextData[{
 " Plugging this back into Eq. ",
 
 CounterBox["EquationNumbered", "JacobiRelSE"],
 ", we have:"
}], "Text",
 CellChangeTimes->{{3.673785884199305*^9, 3.6737858896250772`*^9}, {
   3.673787603092317*^9, 3.673787629890794*^9}, {3.67379033035579*^9, 
   3.673790351471539*^9}, {3.673790393106381*^9, 3.673790416827083*^9}, {
   3.673797627175044*^9, 3.673797678620586*^9}, 3.6738000592185163`*^9},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["H", "rel"], 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673798289750246*^9, 3.673798322450828*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[TextData[{
 "Hitting this from the left with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"]}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], 
     RowBox[{"\[DifferentialD]", 
      OverscriptBox["R", "^"]}], "  ", 
     SubscriptBox["\[CapitalPhi]", "\[Beta]"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and exploiting the orthonormality of the eigenfunctions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", "\[Alpha]"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", we have:"
}], "Text",
 CellChangeTimes->{{3.673798121868031*^9, 3.6737981708360987`*^9}, {
  3.673798223559868*^9, 3.673798278779467*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"\[DifferentialD]", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"]}], 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], 
      RowBox[{"\[DifferentialD]", 
       OverscriptBox["R", "^"]}], "  ", 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], 
      SubscriptBox["H", "rel"], 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"\[DifferentialD]", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"]}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], 
       RowBox[{"\[DifferentialD]", 
        OverscriptBox["R", "^"]}], "  ", 
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
        RowBox[{
         RowBox[{"R", ";", 
          OverscriptBox[
           StyleBox["R",
            FontWeight->"Bold"], "^"]}], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "1"], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "2"]}], ")"}], 
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
        RowBox[{
         RowBox[{"R", ";", 
          OverscriptBox[
           StyleBox["R",
            FontWeight->"Bold"], "^"]}], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "1"], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "2"]}], ")"}], 
       RowBox[{
        SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673798343976461*^9, 3.673798384041566*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["Next we define:", "Text",
 CellChangeTimes->{{3.673798415718774*^9, 3.6737984181415777`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
   "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"]}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], 
     RowBox[{"\[DifferentialD]", 
      OverscriptBox["R", "^"]}], "  ", 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}], 
     SubscriptBox["H", "rel"], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673798420310658*^9, 3.6737984338713017`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
   "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"]}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], 
     RowBox[{"\[DifferentialD]", 
      OverscriptBox["R", "^"]}], "  ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], "[", 
      RowBox[{
       SubscriptBox["T", "R"], "+", 
       SubscriptBox["T", 
        OverscriptBox["R", "^"]], "+", 
       SubscriptBox["T", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], 
         StyleBox["1",
          FontWeight->"Plain"]]], "+", 
       SubscriptBox["T", 
        SubscriptBox["\[Rho]", 
         StyleBox["2",
          FontWeight->"Plain"]]], "+", 
       RowBox[{"V", "(", 
        RowBox[{
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "1"], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "2"], ",", 
         StyleBox["R",
          FontWeight->"Bold"]}], ")"}]}], "]"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673799851996969*^9, 3.673799889669374*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
   "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"]}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"]}], 
     RowBox[{"\[DifferentialD]", 
      OverscriptBox["R", "^"]}], "  ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}], "[", 
      RowBox[{
       SubscriptBox["T", "R"], "+", 
       RowBox[{
        SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}]}], "]"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673800150260531*^9, 3.673800163761496*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
   "=", 
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"\[DifferentialD]", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"]}], 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], 
      RowBox[{"\[DifferentialD]", 
       OverscriptBox["R", "^"]}], "  ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "\[Beta]"], "(", 
        RowBox[{
         RowBox[{"R", ";", 
          OverscriptBox[
           StyleBox["R",
            FontWeight->"Bold"], "^"]}], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "1"], ",", 
         SubscriptBox[
          StyleBox["\[Rho]",
           FontWeight->"Bold"], "2"]}], ")"}], "[", 
       SubscriptBox["T", "R"], "]"}], 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
       RowBox[{
        RowBox[{"R", ";", 
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"]}], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"]}], ")"}]}]}], "+", 
    RowBox[{
     SubscriptBox["\[Delta]", "\[Beta]\[Alpha]"], 
     RowBox[{
      SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738003352557364`*^9, 3.673800369824253*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["\<\
so that the relative coordinate Schrodinger equation becomes:\
\>", "Text",
 CellChangeTimes->{{3.673799404677899*^9, 3.673799410833126*^9}, {
  3.673800196351363*^9, 3.673800203479527*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      SubscriptBox["\[Delta]", "\[Beta]\[Alpha]"], 
      RowBox[{
       SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{
  3.673798393140623*^9, 3.6737984513206167`*^9, {3.673798495819088*^9, 
   3.6737985003251333`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[Psi]", "\[Alpha]"], "(", "R", ")"}]}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{
     SubscriptBox["\[Psi]", "\[Beta]"], "(", "R", ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673798607583909*^9, 3.6737986330843678`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["We can write this as a matrix equation:", "Text",
 CellChangeTimes->{{3.67380356286157*^9, 3.67380357432202*^9}, {
  3.673803628999258*^9, 3.673803631639073*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["W",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SuperscriptBox[
     StyleBox["\[Psi]",
      FontWeight->"Bold"], 
     RowBox[{"(", "i", ")"}]]}], 
   StyleBox["=",
    FontWeight->"Bold"], 
   RowBox[{
    SubscriptBox["E", "i"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SuperscriptBox[
     StyleBox["\[Psi]",
      FontWeight->"Bold"], 
     RowBox[{"(", "i", ")"}]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673803590192033*^9, 3.673803611976067*^9}, {
  3.673804692947505*^9, 3.673804703144096*^9}, {3.673808008052909*^9, 
  3.6738080239569273`*^9}, {3.673809948088089*^9, 3.673809948863978*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[TextData[{
 "Which looks like a Rayleigh-Ritz type variational expression, for which the \
exact solution vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Psi]",
       FontWeight->"Bold"], 
      RowBox[{"(", "i", ")"}]], "(", "R", ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubsuperscriptBox["\[Psi]", "1", 
          RowBox[{"(", "i", ")"}]], "(", "R", ")"}]},
       {
        RowBox[{
         SubsuperscriptBox["\[Psi]", "2", 
          RowBox[{"(", "i", ")"}]], "(", "R", ")"}]},
       {":"}
      }], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "  give the exact energy eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "i"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "."
}], "Text",
 CellChangeTimes->{{3.6738012193178997`*^9, 3.673801242155497*^9}, {
  3.673806394946116*^9, 3.673806539946834*^9}, {3.673807940607335*^9, 
  3.673807991075*^9}},
 TextAlignment->Left,
 TextJustification->0.]
}, Open  ]],

Cell[CellGroupData[{

Cell["Comments/Questions so far...", "Subsection",
 CellChangeTimes->{{3.673822187603641*^9, 3.6738221981642847`*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 "  It seems to me unconventional to refer to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["W", "nb"], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"n", "|", 
      OverscriptBox["H", "^"], "|", "b"}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],
  FormatType->"TraditionalForm"],
 " as \[OpenCurlyDoubleQuote]nonadiabatic couplings\[CloseCurlyDoubleQuote] \
because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "n"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "b"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " are not adiabatic eigenstates.  They do not  correspond to the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", "\[Alpha]"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyQuote]s above, and are not eigenstates of any adiabatic \
hamiltonian.  They seem to be ",
 StyleBox["products ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "n"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "n"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "b"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "b"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{
       RowBox[{"R", ";", 
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"]}], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"]}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "n"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " a harmonic oscillator s-wave eigenfunction and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "b"], "\[Proportional]", 
    RowBox[{"\[Delta]", "(", "R", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". "
}], "Item1Numbered",
 CellChangeTimes->{{3.673822172800651*^9, 3.673822511842556*^9}, {
  3.673822679294611*^9, 3.673822683622375*^9}, {3.673822724606838*^9, 
  3.673822852498981*^9}}],

Cell[TextData[{
 "  Is it fair to say that what I call ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
    RowBox[{
     RowBox[{"R", ";", 
      OverscriptBox[
       StyleBox["R",
        FontWeight->"Bold"], "^"]}], ",", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "2"]}], ")"}], TraditionalForm]]],
 " correspond to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{RowBox[{
       OverscriptBox[
        StyleBox["R", FontWeight -> "Bold"], "^"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]", FontWeight -> "Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]", FontWeight -> "Bold"], "2"]}],"O"},
    "BraKet"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{RowBox[{
       OverscriptBox[
        StyleBox["R", FontWeight -> "Bold"], "^"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]", FontWeight -> "Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]", FontWeight -> "Bold"], "2"]}],"B"},
    "BraKet"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[Element]", "O"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[Alpha]"], "(", 
     RowBox[{"R", "\[GreaterGreater]", 
      SubscriptBox["R", "vdW"]}], ")"}], "<", "E"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[Element]", "B"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[Alpha]"], "(", 
     RowBox[{"R", "\[GreaterGreater]", 
      SubscriptBox["R", "vdW"]}], ")"}], ">", "E"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "?"
}], "Item1Numbered",
 CellChangeTimes->{{3.673822172800651*^9, 3.673822660275498*^9}, {
   3.673822872594347*^9, 3.6738229358606043`*^9}, {3.6738231546488543`*^9, 
   3.673823244110489*^9}, 3.673823931612892*^9, 3.673823968073564*^9}]
}, Open  ]],

Cell["", "Text",
 CellChangeTimes->{{3.673822172800651*^9, 3.673822173223083*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.673822172800651*^9, 3.6738221732189293`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["From a more abstract Hilbert space...", "Subsection",
 CellChangeTimes->{{3.6738239782590027`*^9, 3.673824004522485*^9}}],

Cell["\<\
Let\[CloseCurlyQuote]s start with a ket notation where the full eigenstate of \
the complete Hamiltonian is written:\
\>", "Text",
 CellChangeTimes->{{3.673824009013585*^9, 3.6738240545939817`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]"},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
      "Ket"], 
     SubscriptBox[
      TemplateBox[{"\[Alpha]"},
       "Ket"], "R"]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673824058914339*^9, 3.673824072336823*^9}, {
  3.673824193880473*^9, 3.673824197783844*^9}, {3.673824241312118*^9, 
  3.673824299108768*^9}, {3.673824811094042*^9, 3.673824820364728*^9}, {
  3.673825094895776*^9, 3.673825098207432*^9}, {3.6738270654347553`*^9, 
  3.673827065823577*^9}}],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.673824058914339*^9, 3.673824072336823*^9}, {
   3.673824193880473*^9, 3.673824197783844*^9}, {3.673824241312118*^9, 
   3.673824299108768*^9}, {3.673824811094042*^9, 3.673824820364728*^9}}],
 " lives in the part of the Hilbert space corresponding to the separation \
coordinate ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    TemplateBox[{"\[Alpha]"},
     "Ket"], "R"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is an eigenstate of the adiabatic Hamiltonian that depends parametrically \
on ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->"TraditionalForm"],
 ":"
}], "Text",
 CellChangeTimes->{{3.673824632310596*^9, 3.6738247022550583`*^9}, {
  3.673824740614725*^9, 3.673824773478361*^9}, {3.6738248427264442`*^9, 
  3.673824860235684*^9}, {3.67382510244199*^9, 3.673825106184856*^9}, {
  3.6738647861498537`*^9, 3.6738648175420313`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["H", "ad"], 
    SubscriptBox[
     TemplateBox[{"\[Alpha]"},
      "Ket"], "R"]}], "=", 
   RowBox[{
    SubscriptBox["U", "\[Alpha]"], 
    SubscriptBox[
     TemplateBox[{"\[Alpha]"},
      "Ket"], "R"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673824775156172*^9, 3.673824793284827*^9}, {
  3.6738248705530663`*^9, 3.673824882604067*^9}, {3.6738249184768047`*^9, 
  3.6738249184791603`*^9}, {3.673825108075646*^9, 3.673825110951167*^9}, {
  3.673826011941432*^9, 3.673826018345183*^9}}],

Cell["Inserting complete sets of states", "Text",
 CellChangeTimes->{{3.67382512955116*^9, 3.6738251429905987`*^9}, {
  3.673826021935072*^9, 3.6738260223293543`*^9}, {3.673864832254245*^9, 
  3.673864839962734*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      SuperscriptBox["\[CapitalOmega]", "\[Prime]"]}], 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}], 
       TemplateBox[{SuperscriptBox["\[CapitalOmega]", "\[Prime]"]},
        "Ket"], 
       TemplateBox[{SuperscriptBox["\[CapitalOmega]", "\[Prime]"]},
        "Bra"], 
       SubscriptBox["H", "ad"], 
       TemplateBox[{"\[CapitalOmega]"},
        "Ket"], 
       SubscriptBox[
        TemplateBox[{"\[CapitalOmega]","\[Alpha]"},
         "BraKet"], "R"]}]}]}]}], "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}], " ", 
     RowBox[{
      SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}], 
     TemplateBox[{"\[CapitalOmega]"},
      "Ket"], 
     SubscriptBox[
      TemplateBox[{"\[CapitalOmega]","\[Alpha]"},
       "BraKet"], "R"]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673822172800651*^9, 3.67382217280342*^9}, {
  3.673824925909556*^9, 3.67382506012808*^9}, {3.673825118991365*^9, 
  3.673825121383026*^9}, {3.673825399903801*^9, 3.673825400271612*^9}, {
  3.673826288175593*^9, 3.6738262920681753`*^9}, {3.673864851908074*^9, 
  3.6738649084919653`*^9}}],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "ad"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is a local operator, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{SuperscriptBox["\[CapitalOmega]", "\[Prime]"]},
      "Bra"], 
     SubscriptBox["H", "ad"], 
     TemplateBox[{"\[CapitalOmega]"},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{"\[Delta]", "(", 
      RowBox[{
       SuperscriptBox["\[CapitalOmega]", "\[Prime]"], "-", 
       "\[CapitalOmega]"}], ")"}], 
     RowBox[{
      SubscriptBox["H", "ad"], "(", 
      RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  Furthermore, let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
     RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}], "=", 
    SubscriptBox[
     TemplateBox[{"\[CapitalOmega]","\[Alpha]"},
      "BraKet"], "R"]}], TraditionalForm]],
  FormatType->"TraditionalForm"]
}], "Text",
 CellChangeTimes->{{3.673825155269105*^9, 3.6738252050594797`*^9}, {
  3.673825248296414*^9, 3.67382528705795*^9}, {3.6738263013912163`*^9, 
  3.6738263102991667`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}], 
     TemplateBox[{"\[CapitalOmega]"},
      "Ket"], 
     RowBox[{
      SubscriptBox["H", "ad"], "(", 
      RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}]}]}], "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}], " ", 
     RowBox[{
      SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}], 
     TemplateBox[{"\[CapitalOmega]"},
      "Ket"]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673825304823402*^9, 3.673825462600956*^9}, {
  3.673826339459217*^9, 3.6738263467949247`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["H", "ad"], "(", 
     RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}], 
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
     RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}], 
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
     RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738254731659393`*^9, 3.673825482007489*^9}, {
  3.67382635159501*^9, 3.673826359250744*^9}}],

Cell["Now, returning to the full Hamiltonian:", "Text",
 CellChangeTimes->{{3.673864994807578*^9, 3.67386500199916*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SubscriptBox["T", 
     StyleBox["R",
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox[
      SubscriptBox["\[Rho]", "1"],
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox[
      SubscriptBox["\[Rho]", "2"],
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox["X",
      FontWeight->"Bold"]], "+", 
    RowBox[{"V", "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"], ",", 
      StyleBox["X",
       FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{3.6738650035796213`*^9}],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SubscriptBox["T", "R"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["T", 
       OverscriptBox["R", "^"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", "1"],
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", "2"],
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox["X",
        FontWeight->"Bold"]], "+", 
      RowBox[{"V", "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"], ",", 
        StyleBox["R",
         FontWeight->"Bold"], ",", 
        StyleBox["X",
         FontWeight->"Bold"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673865018681395*^9, 3.673865049288205*^9}, {
  3.6738650981345882`*^9, 3.673865115774118*^9}}],

Cell[TextData[{
 "Now the question is how does one arrive at Eq. (1) of the PRL from the \
Hamiltonian above and the basic expansion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[CapitalPsi]"},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
       "Ket"], 
      SubscriptBox[
       TemplateBox[{"\[Alpha]"},
        "Ket"], "R"]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.673824058914339*^9, 3.673824072336823*^9}, {
   3.673824193880473*^9, 3.673824197783844*^9}, {3.673824241312118*^9, 
   3.673824299108768*^9}, {3.673824811094042*^9, 3.673824820364728*^9}, {
   3.673825094895776*^9, 3.673825098207432*^9}, {3.6738270654347553`*^9, 
   3.673827065823577*^9}}],
 "?  "
}], "Text",
 CellChangeTimes->{{3.6738651268981457`*^9, 3.67386513114014*^9}, {
  3.6738652406089897`*^9, 3.673865299256496*^9}, {3.673865348142755*^9, 
  3.673865401725614*^9}, {3.673865443805484*^9, 3.673865450653206*^9}, {
  3.673865853843987*^9, 3.6738658538471518`*^9}}],

Cell["Now what seems appropriate to me is to expand:", "Text",
 CellChangeTimes->{{3.673868098718894*^9, 3.673868228028994*^9}, {
  3.6738682636416063`*^9, 3.673868273258182*^9}, {3.6738686149994497`*^9, 
  3.673868617261231*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "n"], 
     RowBox[{
      SubscriptBox["c", "n\[Alpha]"], 
      TemplateBox[{SubscriptBox["\[Psi]", "n"]},
       "Ket"]}]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "b"], 
     RowBox[{
      SubscriptBox["c", "b\[Alpha]"], 
      TemplateBox[{SubscriptBox["\[Phi]", "b"]},
       "Ket"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673868098718894*^9, 3.673868228028994*^9}, {
  3.6738682636416063`*^9, 3.673868273258182*^9}, {3.6738686149994497`*^9, 
  3.673868625222884*^9}}],

Cell["\<\
so that in each adiabatic channel, we have an expansion over oscillator \
states and bound states:\
\>", "Text",
 CellChangeTimes->{{3.673868098718894*^9, 3.673868228028994*^9}, {
  3.6738682636416063`*^9, 3.673868273258182*^9}, {3.6738686149994497`*^9, 
  3.67386863602204*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
       "Ket"], 
      SubscriptBox[
       TemplateBox[{"\[Alpha]"},
        "Ket"], "R"]}]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         UnderscriptBox["\[Sum]", "b"], 
         RowBox[{
          SubscriptBox["c", "b\[Alpha]"], 
          TemplateBox[{SubscriptBox["\[Phi]", "b"]},
           "Ket"]}]}], "+", 
        RowBox[{
         UnderscriptBox["\[Sum]", "n"], 
         RowBox[{
          SubscriptBox["c", "n\[Alpha]"], 
          TemplateBox[{SubscriptBox["\[Psi]", "n"]},
           "Ket"]}]}]}], ")"}], 
      SubscriptBox[
       TemplateBox[{"\[Alpha]"},
        "Ket"], "R"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738682370023327`*^9, 3.6738683237574167`*^9}, {
  3.673868445098813*^9, 3.6738684883955717`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      TemplateBox[{SubscriptBox["\[Psi]", "\[Alpha]"]},
       "Ket"], 
      SubscriptBox[
       TemplateBox[{"\[Alpha]"},
        "Ket"], "R"]}]}], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", "\[Alpha]b"], 
      RowBox[{
       SubscriptBox["c", "b\[Alpha]"], 
       TemplateBox[{SubscriptBox["\[Phi]", "b"]},
        "Ket"], 
       SubscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Ket"], "R"]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", "\[Alpha]n"], 
      RowBox[{
       SubscriptBox["c", "n\[Alpha]"], 
       TemplateBox[{SubscriptBox["\[Psi]", "n"]},
        "Ket"], 
       SubscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Ket"], "R"]}]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738691743957853`*^9, 3.673869200514956*^9}}],

Cell["Normalization of the state would suggest:", "Text",
 CellChangeTimes->{{3.673868641028812*^9, 3.673868655291915*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]","\[CapitalPsi]"},
    "BraKet"], "=", 
   RowBox[{"1", "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"b", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Phi]", 
          RowBox[{"b", "'"}]],SubscriptBox["\[Phi]", "b"]},
        "BraKet"], 
       TemplateBox[{RowBox[{"\[Alpha]", "'"}],"\[Alpha]"},
        "BraKet"]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"b", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Phi]", 
          RowBox[{"b", "'"}]],SubscriptBox["\[Psi]", "n"]},
        "BraKet"], 
       TemplateBox[{RowBox[{"\[Alpha]", "'"}],"\[Alpha]"},
        "BraKet"]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"n", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Psi]", 
          RowBox[{"n", "'"}]],SubscriptBox["\[Phi]", "b"]},
        "BraKet"], 
       TemplateBox[{RowBox[{"\[Alpha]", "'"}],"\[Alpha]"},
        "BraKet"]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"n", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Psi]", 
          RowBox[{"n", "'"}]],SubscriptBox["\[Psi]", "n"]},
        "BraKet"], 
       TemplateBox[{RowBox[{"\[Alpha]", "'"}],"\[Alpha]"},
        "BraKet"]}]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738686574105463`*^9, 3.673868724722533*^9}, {
   3.6738688082067757`*^9, 3.6738688223600492`*^9}, 3.6738691696206837`*^9, {
   3.673869233210067*^9, 3.673869419924859*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]","\[CapitalPsi]"},
    "BraKet"], "=", 
   RowBox[{"1", "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"b", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{"b", ",", 
         RowBox[{"b", "'"}]}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"\[Alpha]", "'"}]}]]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"b", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Phi]", 
          RowBox[{"b", "'"}]],SubscriptBox["\[Psi]", "n"]},
        "BraKet"], 
       SubscriptBox["\[Delta]", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"\[Alpha]", "'"}]}]]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"n", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Psi]", 
          RowBox[{"n", "'"}]],SubscriptBox["\[Phi]", "b"]},
        "BraKet"], 
       SubscriptBox["\[Delta]", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"\[Alpha]", "'"}]}]]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"n", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], 
         RowBox[{"\[Alpha]", "'"}]}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{"n", ",", 
         RowBox[{"n", "'"}]}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"\[Alpha]", "'"}]}]]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738694259463873`*^9, 3.673869502075169*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]","\[CapitalPsi]"},
    "BraKet"], "=", 
   RowBox[{"1", "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"\[Alpha]", " ", "b"}]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["c", 
         RowBox[{"b", " ", "\[Alpha]"}]], "\[RightBracketingBar]"}], "2"]}], 
     "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"\[Alpha]", " ", "n"}]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["c", 
         RowBox[{"n", " ", "\[Alpha]"}]], "\[RightBracketingBar]"}], "2"]}], 
     "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"b", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], "\[Alpha]"}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Phi]", 
          RowBox[{"b", "'"}]],SubscriptBox["\[Psi]", "n"]},
        "BraKet"]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"n", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], "\[Alpha]"}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       TemplateBox[{SubscriptBox["\[Psi]", 
          RowBox[{"n", "'"}]],SubscriptBox["\[Phi]", "b"]},
        "BraKet"]}]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.67386969145863*^9, 3.673869724404422*^9}, {
  3.6738701146580563`*^9, 3.6738701210089808`*^9}, {3.673870161864863*^9, 
  3.673870253542006*^9}}],

Cell[TextData[{
 "The overlap between the tightly bound state and the oscillator state is \
going to be proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "0", ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  Write: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{SubscriptBox["\[Phi]", 
       RowBox[{"b", "'"}]],SubscriptBox["\[Psi]", "n"]},
     "BraKet"], "=", 
    RowBox[{
     SubscriptBox["K", 
      RowBox[{"b", "'"}]], 
     RowBox[{
      SubscriptBox["\[Psi]", "n"], "(", "0", ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"]
}], "Text",
 CellChangeTimes->{{3.6738707360622673`*^9, 3.673870821377487*^9}, {
  3.673870870117689*^9, 3.673870903725091*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[CapitalPsi]","\[CapitalPsi]"},
    "BraKet"], "=", 
   RowBox[{"1", "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"\[Alpha]", " ", "b"}]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["c", 
         RowBox[{"b", " ", "\[Alpha]"}]], "\[RightBracketingBar]"}], "2"]}], 
     "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"\[Alpha]", " ", "n"}]], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["c", 
         RowBox[{"n", " ", "\[Alpha]"}]], "\[RightBracketingBar]"}], "2"]}], 
     "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"b", "'"}], "\[Alpha]", " ", "n"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"b", "'"}], "\[Alpha]"}]], 
       SubscriptBox["c", 
        RowBox[{"n", " ", "\[Alpha]"}]], 
       SubscriptBox["K", 
        RowBox[{"b", "'"}]], 
       RowBox[{
        SubscriptBox["\[Psi]", "n"], "(", "0", ")"}]}]}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{"n", "'"}], "\[Alpha]", " ", "b"}]], 
      RowBox[{
       SubscriptBox[
        RowBox[{"c", "\[Conjugate]"}], 
        RowBox[{
         RowBox[{"n", "'"}], "\[Alpha]"}]], 
       SubscriptBox["c", 
        RowBox[{"b", " ", "\[Alpha]"}]], 
       SubscriptBox["K", "b"], 
       RowBox[{
        SubscriptBox["\[Psi]", 
         RowBox[{"n", "'"}]], "(", "0", ")"}]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673871041261484*^9, 3.673871070470263*^9}}],

Cell["\<\
Consider the set of basis states (as described in the supplement of the PRL):\
\
\>", "Text",
 CellChangeTimes->{{3.6738651268981457`*^9, 3.67386513114014*^9}, {
  3.6738652406089897`*^9, 3.673865299256496*^9}, {3.673865348142755*^9, 
  3.673865401725614*^9}, {3.673865443805484*^9, 3.673865450653206*^9}, {
  3.673865853843987*^9, 3.673865861267791*^9}, {3.673867921238201*^9, 
  3.673867929609736*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
    "Ket"], "=", GridBox[{
     {
      RowBox[{
       TemplateBox[{SubscriptBox["\[Psi]", "n"]},
        "Ket"], 
       SubscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Ket"], "R"], "      "}], 
      RowBox[{
       RowBox[{"n", "=", "0"}], ",", "1", ",", "2", ",", "..."}]}
    }]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673865458645214*^9, 3.673865488435728*^9}, {
   3.6738657539782457`*^9, 3.673865759734314*^9}, 3.673868018027972*^9}],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{SubscriptBox["\[CapitalPsi]", "b"]},
    "Ket"], "=", GridBox[{
     {
      RowBox[{
       TemplateBox[{SubscriptBox["\[Phi]", "b"]},
        "Ket"], 
       SubscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Ket"], "R"], "      "}], 
      RowBox[{
       RowBox[{"b", "=", "0"}], ",", "1", ",", "2", ",", "..."}]}
    }]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673865768876549*^9, 3.673865787288254*^9}, {
  3.673865994163416*^9, 3.673865995001071*^9}, {3.673866026088647*^9, 
  3.673866026664332*^9}}],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "n"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is an oscillator state and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "b"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is a bimolecular bound state.  The explicit coordinate space \
representation is:"
}], "Text",
 CellChangeTimes->{{3.673865868400226*^9, 3.67386587832347*^9}, {
  3.67386643177208*^9, 3.673866456038356*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "n"], "(", 
    RowBox[{"R", ",", "\[CapitalOmega]"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"R",SubscriptBox["\[Psi]", "n"]},
      "BraKet"], 
     SubscriptBox[
      TemplateBox[{"\[CapitalOmega]","\[Alpha]"},
       "BraKet"], "R"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "n"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
      RowBox[{"R", ";", "\[CapitalOmega]"}], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673865882755848*^9, 3.6738659567066936`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "b"], "(", 
    RowBox[{"R", ",", "\[CapitalOmega]"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"R",SubscriptBox["\[Phi]", "b"]},
      "BraKet"], 
     SubscriptBox[
      TemplateBox[{"\[CapitalOmega]","\[Alpha]"},
       "BraKet"], "R"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Phi]", "b"], "(", "R", ")"}], 
