Cell[CellGroupData[{
Cell["\<\
Some notes on Random Matrix Theory ideas for nonreactive molecules in optical \
lattices\
\>", "Title",
 CellChangeTimes->{{3.672403958915996*^9, 3.672404010018166*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[CellGroupData[{

Cell["\<\
From the paper by Joseph Leva, fast generation of normally distributed random \
numbers.\
\>", "Subsection",
 CellChangeTimes->{{3.672404011787403*^9, 3.672404055537426*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vsol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"Q", "==", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"u", "-", "s"}], ")"}], "2"], "-", 
       RowBox[{"b", 
        RowBox[{"(", 
         RowBox[{"u", "-", "s"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"v", "-", "t"}], ")"}]}], "+", 
       RowBox[{"a", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"v", "-", "t"}], ")"}], "2"]}]}]}], ",", "v"}], "]"}], "//",
    "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.672068959454933*^9, 3.6720690000132847`*^9}, {
  3.6720690492716923`*^9, 3.672069052286832*^9}, {3.672069539350979*^9, 
  3.672069554668871*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"v", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", "a", " ", "t"}], "-", 
       SqrtBox[
        RowBox[{
         RowBox[{"4", " ", "a", " ", 
          RowBox[{"(", 
           RowBox[{"Q", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "u"}], ")"}], "2"]}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["b", "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"s", "-", "u"}], ")"}], "2"]}]}]], "+", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "s"}], "+", "u"}], ")"}]}]}], 
      RowBox[{"2", " ", "a"}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", "a", " ", "t"}], "+", 
       SqrtBox[
        RowBox[{
         RowBox[{"4", " ", "a", " ", 
          RowBox[{"(", 
           RowBox[{"Q", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "u"}], ")"}], "2"]}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["b", "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"s", "-", "u"}], ")"}], "2"]}]}]], "+", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "s"}], "+", "u"}], ")"}]}]}], 
      RowBox[{"2", " ", "a"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.672070943048996*^9},
 TextAlignment->Left,
 TextJustification->0.]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"params1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", " ", "0.19600"}], ",", 
     RowBox[{"b", "\[Rule]", "0.25472"}], ",", 
     RowBox[{"s", "\[Rule]", "0.449871"}], ",", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"-", "0.386595"}]}], ",", 
     RowBox[{"Q", "\[Rule]", "0.27597"}]}], "}"}]}], ";", 
  RowBox[{"params2", "=", 
