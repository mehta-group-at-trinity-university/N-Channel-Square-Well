Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     FormBox[
      RowBox[{
       SubscriptBox["\[Psi]", "\[Alpha]"], "="}],
      TraditionalForm], 
     RowBox[{
      UnderscriptBox["\[Sum]", "n"], 
      RowBox[{
       SubsuperscriptBox["c", "n", "\[Alpha]"], 
       RowBox[{
        SubscriptBox["\[Psi]", "n"], "(", "R", ")"}]}]}]}], "+", 
    RowBox[{
