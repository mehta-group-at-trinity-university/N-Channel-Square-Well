  3.672610243104735*^9}, {3.673796789355641*^9, 3.673796791697976*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "2"], ",", 
     StyleBox["R",
      FontWeight->"Bold"], ",", 
     StyleBox["X",
      FontWeight->"Bold"]}], ")"}], "=", 
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      OverscriptBox[
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}]], "4"], 
      RowBox[{
       SubscriptBox["V", "ext"], "(", 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "i"], ")"}]}], "]"}], "+", 
    RowBox[{
     SubscriptBox["V", "2"], "(", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "1"], ")"}], "+", 
    RowBox[{
     SubscriptBox["V", "2"], "(", 
     SubscriptBox[
      StyleBox["\[Rho]",
       FontWeight->"Bold"], "2"], ")"}], "+", 
