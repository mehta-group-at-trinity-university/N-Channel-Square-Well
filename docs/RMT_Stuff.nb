Cell[TextData[{
 "For the harmonic oscillator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "ext"], "=", 
    RowBox[{
     FractionBox["1", "2"], "m", " ", 
     SuperscriptBox["\[Omega]", "2"], 
     SubsuperscriptBox["r", "i", "2"]}]}], TraditionalForm]]],
 ", the center of mass motion separates completely and one can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPsi]", "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"], ",", 
      StyleBox["X",
       FontWeight->"Bold"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "CM"], "(", 
      StyleBox["X",
       FontWeight->"Bold"], ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "rel"], "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Rho]",
         FontWeight->"Bold"], "2"], ",", 
       StyleBox["R",
        FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]]],
 ". "
}], "Text",
 CellChangeTimes->{{3.672446068781005*^9, 3.672446171241489*^9}, {
  3.67260956007381*^9, 3.672609573761047*^9}, {3.672610255267579*^9, 
