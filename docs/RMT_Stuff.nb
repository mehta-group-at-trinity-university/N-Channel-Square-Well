Cell[CellGroupData[{

Cell["What is the model hamiltonian?", "Subsection",
 CellChangeTimes->{{3.672404065769166*^9, 3.672404080288885*^9}, 
   3.672404362497005*^9, 3.673821850172153*^9},
 TextAlignment->Left,
 TextJustification->0.],

Cell["\<\
Let us for simplicity consider the spatial degrees of freedom associated with \
the nuclear positions and supress any indices associated with the electronic \
or spin degrees of freedom. Express the four nuclei positions in H-type \
Jacobi coordinates:\
\>", "Text",
 CellChangeTimes->{{3.6724416709563313`*^9, 3.672441721133134*^9}, {
  3.67244507075471*^9, 3.672445167135154*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]",
     FontWeight->"Bold"], "1"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "1"], "-", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "2"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6724417252312403`*^9, 3.672441782292117*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]",
     FontWeight->"Bold"], "2"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "3"], "-", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "4"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6724417252312403`*^9, 3.6724417917626963`*^9}, 
   3.6724448330915117`*^9, {3.672610195991899*^9, 3.672610196070855*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["R",
    FontWeight->"Bold"], 
   StyleBox["=",
    FontWeight->"Plain"], 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["m",
         FontWeight->"Plain"], "3"], 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "3"]}], "+", 
      RowBox[{
       SubscriptBox["m", "4"], 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "4"]}]}], 
     RowBox[{
      SubscriptBox["m", "3"], "+", 
      SubscriptBox["m", "4"]}]], "-", 
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["m",
         FontWeight->"Plain"], "1"], 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "1"]}], "+", 
      RowBox[{
       SubscriptBox["m", "2"], 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "2"]}]}], 
     RowBox[{
      SubscriptBox["m", "1"], "+", 
      SubscriptBox["m", "2"]}]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6724417252312403`*^9, 3.6724417917626963`*^9}, {
   3.6724448330915117`*^9, 3.6724449138419857`*^9}, 3.672444972998361*^9, {
   3.6726101884236507`*^9, 3.672610212070258*^9}, 3.673796780023468*^9},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["X",
    FontWeight->"Bold"], 
   StyleBox["=",
    FontWeight->"Bold"], 
   FractionBox[
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["m",
        FontWeight->"Plain"], "1"], 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "1"]}], "+", 
     RowBox[{
      SubscriptBox["m", "2"], 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "2"]}], "+", 
     RowBox[{
      SubscriptBox[
       StyleBox["m",
        FontWeight->"Plain"], "3"], 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "3"]}], "+", 
     RowBox[{
      SubscriptBox["m", "4"], 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "4"]}]}], 
    RowBox[{
     SubscriptBox["m", "1"], "+", 
     SubscriptBox["m", "2"], "+", 
     SubscriptBox["m", "3"], "+", 
     SubscriptBox["m", "4"]}]]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6724417252312403`*^9, 3.6724417917626963`*^9}, {
  3.6724448330915117`*^9, 3.6724449138419857`*^9}, {3.672444972998361*^9, 
  3.6724450307822*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[TextData[{
 "Let the separation between the two nonreactive molecules be the vector ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontWeight->"Bold"], TraditionalForm]]],
 ". The bimolecular Hamiltonian can be written as:"
}], "Text",
 CellChangeTimes->{{3.672406215388575*^9, 3.672406355858261*^9}, {
  3.672437986279257*^9, 3.6724380081883507`*^9}, {3.672439060778089*^9, 
