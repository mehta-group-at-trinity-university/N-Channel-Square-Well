 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SubscriptBox["T", 
     StyleBox["R",
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox[
      SubscriptBox["\[Rho]", "1"],
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox[
      SubscriptBox["\[Rho]", "2"],
      FontWeight->"Bold"]], "+", 
    SubscriptBox["T", 
     StyleBox["X",
      FontWeight->"Bold"]], "+", 
    RowBox[{"V", "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "1"], ",", 
      SubscriptBox[
       StyleBox["\[Rho]",
        FontWeight->"Bold"], "2"], ",", 
      StyleBox["R",
       FontWeight->"Bold"], ",", 
      StyleBox["X",
       FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.6724380420892887`*^9, 3.6724380996995*^9}, {
  3.672438991996982*^9, 3.672439037821444*^9}, {3.672439229594688*^9, 
  3.672439273969199*^9}, {3.672441607467825*^9, 3.672441645824978*^9}, {
