  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.67386596735646*^9, 3.673866039476742*^9}}],

Cell[TextData[{
 "with bimolecular bound state is highly localized near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "b"], "\[Proportional]", 
    RowBox[{"\[Delta]", "(", "R", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "."
}], "Text",
 CellChangeTimes->{{3.67386605200483*^9, 3.673866083334085*^9}, {
  3.6738664616863956`*^9, 3.673866463886174*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SubscriptBox["T", "R"], "+", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["T", 
       OverscriptBox["R", "^"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", "1"],
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox[
        SubscriptBox["\[Rho]", "2"],
        FontWeight->"Bold"]], "+", 
      SubscriptBox["T", 
       StyleBox["X",
        FontWeight->"Bold"]], "+", 
      RowBox[{"V", "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox[
         StyleBox["\[Rho]",
          FontWeight->"Bold"], "2"], ",", 
        StyleBox["R",
         FontWeight->"Bold"], ",", 
        StyleBox["X",
         FontWeight->"Bold"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{3.673866254758387*^9}],

Cell["\<\
So, what does the completeness relation look like for these basis states?  \
They are not orthonormal.  Does it make sense to write:\
\>", "Text",
 CellChangeTimes->{{3.673866506065893*^9, 3.673866562227951*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "n"], 
     RowBox[{
      TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
       "Ket"], 
      TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
       "Bra"]}]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "b"], 
     RowBox[{
      TemplateBox[{SubscriptBox["\[CapitalPsi]", "b"]},
       "Ket"], 
      TemplateBox[{SubscriptBox["\[CapitalPsi]", "b"]},
       "Bra"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738665650039673`*^9, 3.6738666178191223`*^9}}],

Cell[TextData[{
 "For example, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["1", "2"], "=", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "?"
}], "Text",
 CellChangeTimes->{{3.6738666376557503`*^9, 3.673866647129134*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["1", "2"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "n"], 
       RowBox[{
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
         "Ket"], 
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
         "Bra"]}]}], "+", 
      RowBox[{
       UnderscriptBox["\[Sum]", "b"], 
       RowBox[{
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "b"]},
         "Ket"], 
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "b"]},
         "Bra"]}]}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"n", "'"}]], 
       RowBox[{
        TemplateBox[{SubscriptBox["\[CapitalPsi]", 
           RowBox[{"n", "'"}]]},
         "Ket"], 
        TemplateBox[{SubscriptBox["\[CapitalPsi]", 
           RowBox[{"n", "'"}]]},
         "Bra"]}]}], "+", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"b", "'"}]], 
       RowBox[{
        TemplateBox[{SubscriptBox["\[CapitalPsi]", 
           RowBox[{"b", "'"}]]},
         "Ket"], 
        TemplateBox[{SubscriptBox["\[CapitalPsi]", 
           RowBox[{"b", "'"}]]},
         "Bra"]}]}]}], ")"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673866657183071*^9, 3.673866673314754*^9}, {
  3.6738678972829027`*^9, 3.6738679088897953`*^9}}],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["1", "2"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "n"], 
       RowBox[{
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
         "Ket"], 
        TemplateBox[{SubscriptBox["\[CapitalPsi]", "n"]},
         "Bra"]}]}], "+", 
      RowBox[{
       UnderscriptBox["\[Sum]", "b"], 
