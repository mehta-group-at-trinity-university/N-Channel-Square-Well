     RowBox[{
      SubsuperscriptBox["c", "b", "\[Alpha]"], 
      RowBox[{
       SubscriptBox["\[Psi]", "b"], "(", "R", ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.673809714550156*^9, 3.6738097253637857`*^9}, {
