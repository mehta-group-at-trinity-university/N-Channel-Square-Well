  3.6738107171209707`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["\<\
Consider for a moment the solutions in the absence of off-diagonal couplings. \
 In that case:\
\>", "Text",
 CellChangeTimes->{{3.673804938754315*^9, 3.673804958213936*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalW]", "\[Beta]\[Alpha]"], "(", "R", ")"}], 
   "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", "\[Beta]\[Alpha]"], 
     RowBox[{
      SubscriptBox["\[ScriptCapitalW]", "\[Alpha]"], "(", "R", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"\[DifferentialD]", 
          SubscriptBox[
           StyleBox["\[Rho]",
            FontWeight->"Bold"], "1"]}], 
         RowBox[{"\[DifferentialD]", 
          SubscriptBox[
           StyleBox["\[Rho]",
            FontWeight->"Bold"], "2"]}], 
         RowBox[{"\[DifferentialD]", 
          OverscriptBox["R", "^"]}], "  ", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
           RowBox[{
            RowBox[{"R", ";", 
             OverscriptBox[
              StyleBox["R",
               FontWeight->"Bold"], "^"]}], ",", 
            SubscriptBox[
             StyleBox["\[Rho]",
              FontWeight->"Bold"], "1"], ",", 
            SubscriptBox[
             StyleBox["\[Rho]",
              FontWeight->"Bold"], "2"]}], ")"}], "[", 
          SubscriptBox["T", "R"], "]"}], 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "\[Alpha]"], "(", 
          RowBox[{
           RowBox[{"R", ";", 
            OverscriptBox[
             StyleBox["R",
              FontWeight->"Bold"], "^"]}], ",", 
           SubscriptBox[
            StyleBox["\[Rho]",
             FontWeight->"Bold"], "1"], ",", 
           SubscriptBox[
            StyleBox["\[Rho]",
             FontWeight->"Bold"], "2"]}], ")"}]}]}], "+", 
       RowBox[{
        SubscriptBox["U", "\[Alpha]"], "(", "R", ")"}]}], ")"}], 
     SubscriptBox["\[Delta]", "\[Beta]\[Alpha]"]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.6738037172922783`*^9, 3.67380372843506*^9}, {
  3.673803766483831*^9, 3.6738037762651787`*^9}, {3.6738049695170813`*^9, 
